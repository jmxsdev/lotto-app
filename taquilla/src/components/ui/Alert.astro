---
interface Props {
  type?: 'success' | 'error' | 'warning' | 'info';
  message: string;
  dismissible?: boolean;
  onClose?: () => void;
}

const { 
  type = 'info', 
  message, 
  dismissible = true, 
  onClose 
} = Astro.props;
---

<div class={`alert alert-${type}`} role="alert">
  <span class="alert-icon">{getTypeIcon()}</span>
  <span class="alert-message">{message}</span>
  {dismissible && (
    <button class="alert-close" onclick={handleClose}>
      &times;
    </button>
  )}
</div>

<script>
  function getTypeIcon() {
    switch (type) {
      case 'success': return '✓';
      case 'error': return '✕';
      case 'warning': return '⚠';
      case 'info': return 'ℹ';
      default: return '';
    }
  }

  function handleClose() {
    const parent = document.querySelector('.alert');
    if (parent) {
      parent.style.display = 'none';
    }
    if (onClose) {
      onClose();
    }
  }
</script>

<style>
  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .alert-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .alert-error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .alert-warning {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }

  .alert-info {
    background: #d1ecf1;
    color: #0c5460;
    border: 1px solid #bee5eb;
  }

  .alert-icon {
    font-size: 18px;
    font-weight: bold;
  }

  .alert-message {
    flex: 1;
    font-size: 14px;
  }

  .alert-close {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: inherit;
    opacity: 0.6;
    padding: 0 4px;
  }

  .alert-close:hover {
    opacity: 1;
  }
</style>
