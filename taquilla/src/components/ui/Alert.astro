---
import Icon from './Icon.astro';
import { icono } from '../../utils/iconos';

interface Props {
  type?: 'success' | 'error' | 'warning' | 'info';
  message: string;
  dismissible?: boolean;
  // Legado: Astro no puede pasar callbacks client-side por props; el cierre
  // solo oculta el alert (onClose no se ejecuta desde el servidor).
  onClose?: () => void;
}

const { 
  type = 'info', 
  message, 
  dismissible = true
} = Astro.props;

const ICONO_POR_TIPO = {
  success: 'circle-check',
  error: 'circle-x',
  warning: 'triangle-alert',
  info: 'info',
} as const;

// iconografia-front R1: SVG Lucide inline; decorativo (aria-hidden) porque el
// mensaje visible + role="alert" ya aportan la semántica.
const iconoSvg = icono(ICONO_POR_TIPO[type]);
---

<div class={`alert alert-${type}`} role="alert">
  <span class="alert-icon" set:html={iconoSvg} aria-hidden="true"></span>
  <span class="alert-message">{message}</span>
  {dismissible && (
    <button class="alert-close" type="button" aria-label="Cerrar alerta">
      <Icon name="x" size={16} />
    </button>
  )}
</div>

<script>
  // Cierre por botón (R1): botón real con aria-label; el icono X es decorativo.
  // Los scripts de Astro corren tras el render, así que el listener es seguro.
  document.querySelectorAll('.alert-close').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.alert');
      if (parent) parent.style.display = 'none';
    });
  });
</script>

<style>
  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .alert-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .alert-error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .alert-warning {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }

  .alert-info {
    background: #d1ecf1;
    color: #0c5460;
    border: 1px solid #bee5eb;
  }

  .alert-icon {
    font-size: 18px;
    font-weight: bold;
    display: inline-flex;
  }

  .alert-icon svg {
    width: 18px;
    height: 18px;
  }

  .alert-message {
    flex: 1;
    font-size: 14px;
  }

  .alert-close {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: inherit;
    opacity: 0.6;
    padding: 0 4px;
    display: inline-flex;
    align-items: center;
  }

  .alert-close svg {
    width: 16px;
    height: 16px;
  }

  .alert-close:hover {
    opacity: 1;
  }
</style>
