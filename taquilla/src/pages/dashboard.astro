    // zodiacal → triple_a/b/c (con zona signo solo para triple_c, D1);
    // triple-numérico → solo triple_a, implícito al seleccionar el juego.
    const APOSTADOS_TRIPLETAS = [
      { code: 'triple_a', label: 'Triple A', digitos: 3, requiere_signo: false },
      { code: 'triple_b', label: 'Triple B', digitos: 3, requiere_signo: false },
      { code: 'triple_c', label: 'Triple C', digitos: 3, requiere_signo: true },
    ];

    const NOMBRE_ZONA = {
      juegos: 'Juegos', modalidad: 'Modalidad', seleccion: 'Selección', signo: 'Signo',
      horarios: 'Horario', numero: 'Número', numero_b: 'Segunda selección', monto: 'Monto', anadir: 'Añadir', resumen: 'Resumen',
    };

    // Objetivo de foco de cada zona (roving focus / tabindex explícito, KB-01).
