---
import MainLayout from '../layouts/MainLayout.astro';
import api from '../utils/api';
---

<MainLayout currentPage="dashboard">
  <div class="dashboard">
    <h2 class="page-title">Dashboard</h2>
    
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">🎰</div>
        <div class="stat-content">
          <div class="stat-label">Apuestas del Día</div>
          <div class="stat-value" id="total-apuestas">--</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">💰</div>
        <div class="stat-content">
          <div class="stat-label">Total Vendido (BS)</div>
          <div class="stat-value" id="total-bs">Bs. 0.00</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">💵</div>
        <div class="stat-content">
          <div class="stat-label">Total Vendido ($)</div>
          <div class="stat-value" id="total-usd">$ 0.00</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">⏳</div>
        <div class="stat-content">
          <div class="stat-label">Pendientes</div>
          <div class="stat-value" id="pending-count">--</div>
        </div>
      </div>
    </div>
    
    <div class="recent-section">
      <h3 class="section-title">Últimas Apuestas</h3>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Hora</th>
              <th>Juego</th>
              <th>Animal</th>
              <th>Monto (BS)</th>
              <th>Monto ($)</th>
              <th>Total Eq.</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody id="apuestas-body">
            <tr>
              <td colspan="7" style="text-align: center; padding: 40px;">
                Cargando apuestas...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  
  <style>
    .dashboard {
      max-width: 1200px;
    }
    
    .page-title {
      font-size: 28px;
      font-weight: 700;
      color: #333;
      margin-bottom: 24px;
    }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    
    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      display: flex;
      align-items: center;
      gap: 16px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }
    
    .stat-icon {
      font-size: 32px;
    }
    
    .stat-content {
      flex: 1;
    }
    
    .stat-label {
      font-size: 14px;
      color: #666;
      margin-bottom: 4px;
    }
    
    .stat-value {
      font-size: 24px;
      font-weight: 700;
      color: #333;
    }
    
    .recent-section {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    
    .section-title {
      font-size: 18px;
      font-weight: 600;
      color: #333;
      margin-bottom: 16px;
    }
    
    .table-container {
      overflow-x: auto;
    }
    
    .data-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .data-table th {
      background: #f5f7fa;
      padding: 12px;
      text-align: left;
      font-weight: 600;
      color: #666;
      font-size: 13px;
      border-bottom: 2px solid #e9ecef;
    }
    
    .data-table td {
      padding: 12px;
      border-bottom: 1px solid #e9ecef;
      font-size: 14px;
    }
    
    .data-table tr:hover {
      background: #f8f9fa;
    }
    
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    
    .badge-pendiente {
      background: #fff3cd;
      color: #856404;
    }
    
    .badge-pagada {
      background: #d4edda;
      color: #155724;
    }
    
    .badge-anulada {
      background: #f8d7da;
      color: #721c24;
    }
  </style>
  
  <script>
    async function loadDashboard() {
      try {
        const response = await fetch('/api/apuestas/resumen');
        if (!response.ok) throw new Error('Error al cargar resumen');
        
        const data = await response.json();
        const resumen = data.data || {};
        
        document.getElementById('total-apuestas').textContent = 
          (resumen.pending_count || 0) + (resumen.pagada_count || 0);
        document.getElementById('total-bs').textContent = `Bs. ${Number(resumen.total_bs || 0).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`;
        document.getElementById('total-usd').textContent = `$ ${Number(resumen.total_usd || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        document.getElementById('pending-count').textContent = resumen.pending_count || 0;
      } catch (error) {
        console.error('Error cargando resumen:', error);
      }
    }
    
    async function loadApuestas() {
      try {
        const response = await fetch('/api/apuestas?per_page=5');
        if (!response.ok) throw new Error('Error al cargar apuestas');
        
        const data = await response.json();
        const apuestas = data.data?.data || [];
        const tbody = document.getElementById('apuestas-body');
        
        if (apuestas.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #666;">No hay apuestas registradas</td></tr>';
          return;
        }
        
        tbody.innerHTML = apuestas.map(apuesta => {
          const combinacion = typeof apuesta.combinacion === 'string' ? JSON.parse(apuesta.combinacion) : apuesta.combinacion;
          const animal = combinacion?.animal || '-';
          const estadoClass = `badge-${apuesta.estado || 'pendiente'}`;
          
          return `
            <tr>
              <td>${new Date(apuesta.created_at).toLocaleTimeString('es-VE')}</td>
              <td>${apuesta.juego?.name || '-'}</td>
              <td>${animal}</td>
              <td>Bs. ${Number(apuesta.amount_bs || 0).toLocaleString('es-VE', { minimumFractionDigits: 2 })}</td>
              <td>$ ${Number(apuesta.amount_usd || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
              <td>Bs. ${Number(apuesta.total_bs_equivalent || 0).toLocaleString('es-VE', { minimumFractionDigits: 2 })}</td>
              <td><span class="badge ${estadoClass}">${(apuesta.estado || 'pendiente').toUpperCase()}</span></td>
            </tr>
          `;
        }).join('');
      } catch (error) {
        console.error('Error cargando apuestas:', error);
        document.getElementById('apuestas-body').innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #dc3545;">Error al cargar datos</td></tr>';
      }
    }
    
    loadDashboard();
    loadApuestas();
  </script>
</MainLayout>
