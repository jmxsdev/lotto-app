---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout currentPage="dashboard">
  <div class="dashboard">
    <div class="stats-grid">
      <div class="stat-card clock-card">
        <div class="stat-icon">🕐</div>
        <div class="stat-content">
          <div class="stat-label">Hora Actual</div>
          <div class="stat-value" id="clock">--:--:--</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">🎯</div>
        <div class="stat-content">
          <div class="stat-label">Jugadas</div>
          <div class="stat-value" id="jugadas">0</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">💰</div>
        <div class="stat-content">
          <div class="stat-label">Total a Pagar (BS)</div>
          <div class="stat-value" id="total-pagar">Bs. 0,00</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon">💱</div>
        <div class="stat-content">
          <div class="stat-label">Tasa del Dólar</div>
          <div class="stat-value" id="tasa-dolar">--</div>
          <div class="stat-meta" id="tasa-meta"></div>
        </div>
      </div>
    </div>

    <div id="qt-legend" class="qt-legend" role="status" aria-label="Atajos de teclado"></div>

    <div class="quick-ticket">
      <div class="qt-bar">
        <input type="number" id="qt-numero" class="qt-input" placeholder="Número" min="0" step="1" data-zona="numero">
        <input type="number" id="qt-monto" class="qt-input" placeholder="Monto" min="0" step="0.01" data-zona="monto">
        <select id="qt-moneda" class="qt-select" tabindex="-1">
          <option value="bs">Bs</option>
          <option value="usd">$</option>
        </select>
        <button id="qt-add" class="qt-btn qt-btn-primary" title="Agregar línea" data-zona="anadir">➕</button>
      </div>

      <div class="qt-body">
        <div class="qt-column juegos-col">
          <h4 class="qt-col-title" id="juegos-col-title">Juegos</h4>
          <div class="juegos-tabs" id="juegos-tabs" data-zona="juegos"></div>
          <div id="juegos-list" class="juegos-list" data-zona="juegos"></div>
          <div id="horario-mode" class="horario-mode-inner" style="display:none">
            <button id="back-to-juegos" class="back-btn" tabindex="-1">← Volver</button>
            <div class="game-chips" id="game-chips"></div>
            <div id="qt-horario-aviso" class="qt-horario-aviso" role="alert" style="display:none"></div>
            <div class="horarios-grid" id="horarios-grid" data-zona="horarios"></div>
          </div>
        </div>

        <div class="qt-column animales-col" id="animales-col">
          <h4 class="qt-col-title">Selección</h4>
          <div id="seleccion-content" class="seleccion-content" data-zona="seleccion">
            <div class="seleccion-placeholder">Seleccione un juego</div>
          </div>
        </div>

        <div class="qt-column resumen-col">
          <h4 class="qt-col-title">Resumen del Ticket</h4>
          <div id="resumen-content" class="resumen-content" data-zona="resumen"></div>
          <div class="qt-total" id="qt-total-row">
            <span class="total-label">Total:</span>
            <span class="total-amount" id="qt-total-amount">Bs. 0,00</span>
          </div>
          <div class="qt-actions">
            <button id="qt-clear" class="btn btn-clear" disabled tabindex="-1">🗑️ Limpiar</button>
            <button id="qt-print" class="btn btn-primary" disabled tabindex="-1">🖨️ Imprimir</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <style is:global>
    .dashboard {
      max-width: 1200px;
    }
    
    .page-title {
      display: none;
    }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px;
      margin-bottom: 10px;
    }

    .stat-card {
      background: white;
      border-radius: 8px;
      padding: 8px 14px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .stat-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .clock-card .stat-value {
      font-size: 18px;
      letter-spacing: 1px;
      font-variant-numeric: tabular-nums;
    }

    .stat-icon {
      font-size: 20px;
    }

    .stat-content {
      flex: 1;
    }

    .stat-label {
      font-size: 10px;
      color: #666;
      margin-bottom: 1px;
    }

    .stat-value {
      font-size: 17px;
      font-weight: 700;
      color: #333;
    }

    .stat-meta {
      font-size: 10px;
      color: #999;
      margin-top: 0;
    }

    .qt-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
      align-items: center;
      padding: 6px 14px;
      background: #f1f3f5;
      border-radius: 8px;
      margin-bottom: 10px;
      font-size: 12px;
      color: #555;
      line-height: 1.6;
    }

    .qt-legend .leg-grupo {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
    }

    .qt-legend .leg-label {
      font-weight: 700;
      color: #333;
      margin-right: 2px;
    }

    .qt-legend .kbd {
      display: inline-block;
      padding: 0 5px;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      background: white;
      font-weight: 700;
      color: #1e40af;
      font-size: 11px;
      margin-right: 2px;
    }

    .qt-legend .leg-arrow {
      color: #94a3b8;
      font-weight: 700;
    }

    .quick-ticket {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .qt-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: #f8f9fa;
      border-bottom: 1px solid #e9ecef;
      height: 50px;
    }

    .qt-input {
      width: 100px;
      padding: 6px 10px;
      border: 2px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
    }

    .qt-input:focus {
      border-color: #667eea;
      outline: none;
    }

    .qt-select {
      padding: 6px 10px;
      border: 2px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      background: white;
    }

    .qt-select:focus {
      border-color: #667eea;
      outline: none;
    }

    .qt-btn {
      width: 34px;
      height: 34px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e9ecef;
      transition: background 0.15s ease;
    }

    .qt-btn:hover {
      background: #dee2e6;
    }

    .qt-btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .qt-btn-primary:hover {
      opacity: 0.9;
    }

    .qt-body {
      display: grid;
      grid-template-columns: 30% 20% 50%;
      gap: 0;
      min-height: 480px;
    }

    .qt-column {
      padding: 12px;
      border-right: 1px solid #e9ecef;
    }

    .qt-column:last-child {
      border-right: none;
    }

    .qt-col-title {
      font-size: 12px;
      font-weight: 600;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    .juegos-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .juego-card {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.15s ease;
      border: 2px solid transparent;
      background: #f8f9fa;
    }

    .juego-card * {
      cursor: pointer;
    }

    .juego-card:hover {
      border-color: #667eea;
      background: #f0f4ff;
    }

    .juego-card.selected {
      border-color: #3b82f6;
      background: #dbeafe;
      font-weight: 600;
    }

    .juego-card.selected .juego-name {
      color: #1e40af;
    }

    .juego-card.selected .juego-icon {
      color: #1e40af;
    }

    .juegos-tabs {
      display: flex;
      gap: 0;
      margin-bottom: 0;
      border-bottom: 2px solid #ddd;
    }

    .juego-tab {
      flex: 1;
      padding: 8px 4px;
      border: 2px solid transparent;
      border-bottom: none;
      border-radius: 8px 8px 0 0;
      background: transparent;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease;
      text-align: center;
      color: #888;
      margin-bottom: -2px;
    }

    .juego-tab:hover {
      color: #3b82f6;
      background: #eff6ff;
    }

    .juego-tab.active {
      border-color: #ddd;
      background: white;
      color: #1e40af;
      border-bottom-color: white;
    }

    .modalidad-label {
      font-size: 12px;
      color: #666;
      margin-bottom: 6px;
      font-weight: 500;
    }

    .modalidad-grid {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }

    .modalidad-btn {
      flex: 1;
      padding: 8px 4px;
      border: 2px solid #ddd;
      border-radius: 6px;
      background: white;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.1s ease;
      text-align: center;
    }

    .modalidad-btn:hover {
      border-color: #3b82f6;
      background: #f0f4ff;
    }

    .modalidad-btn.selected {
      border-color: #3b82f6;
      background: #dbeafe;
      color: #1e40af;
    }

    .triple-info {
      font-size: 11px;
      color: #999;
      margin-top: 4px;
      font-style: italic;
    }

    .juego-icon {
      font-size: 20px;
    }

    .juego-name {
      font-size: 13px;
      font-weight: 500;
    }

    .seleccion-content {
      max-height: 440px;
      overflow-y: auto;
    }

    .opciones-lista {
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: 400px;
      overflow-y: auto;
    }

    .seleccion-placeholder {
      text-align: center;
      color: #999;
      padding: 40px 0;
      font-style: italic;
      font-size: 14px;
    }

    .animal-check {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 5px 8px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.1s ease;
      width: 100%;
      box-sizing: border-box;
      border: 2px solid transparent;
    }

    .animal-check * {
      cursor: pointer;
    }

    .animal-check:hover {
      background: #f0f4ff;
    }

    .animal-check.selected {
      background: #dbeafe;
      border-color: #3b82f6;
      font-weight: 600;
    }

    .animal-check.selected .animal-label,
    .animal-check.selected .animal-num {
      color: #1e40af;
    }

    .horario-mode-inner {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .game-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 4px;
    }

    .game-chip {
      font-size: 11px;
      background: #eef2ff;
      color: #667eea;
      padding: 2px 8px;
      border-radius: 12px;
      font-weight: 500;
    }

    .back-btn {
      background: none;
      border: none;
      color: #667eea;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      padding: 4px 0;
      text-align: left;
      font-family: inherit;
    }

    .back-btn:hover {
      text-decoration: underline;
    }

    .horarios-grid {
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: 280px;
      overflow-y: auto;
    }

    .horario-item {
      padding: 6px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      font-family: inherit;
      transition: all 0.1s ease;
      border: 2px solid transparent;
      background: #f8f9fa;
      width: 100%;
      box-sizing: border-box;
    }

    .horario-item:hover {
      border-color: #3b82f6;
      background: #f0f4ff;
    }

    .horario-item.selected {
      background: #dbeafe;
      border-color: #3b82f6;
      font-weight: 600;
      color: #1e40af;
    }

    .horario-item.expirado {
      border-color: #dc2626;
      background: #fef2f2;
      color: #dc2626;
    }

    .qt-horario-aviso {
      color: #dc2626;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .animal-num {
      font-weight: 700;
      color: #667eea;
      font-size: 13px;
      width: 24px;
    }

    .animal-emoji {
      font-size: 18px;
      line-height: 1;
      width: 24px;
      text-align: center;
    }

    .animal-label {
      font-size: 13px;
      color: #333;
    }

    .monto-bs {
      color: #059669;
      font-weight: 600;
    }

    .monto-usd {
      color: #2563eb;
      font-weight: 600;
    }

    .signos-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }

    .signo-btn {
      padding: 4px 10px;
      border: 2px solid #ddd;
      border-radius: 6px;
      background: white;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.1s ease;
      font-family: inherit;
    }

    .signo-btn:hover {
      border-color: #3b82f6;
      background: #f0f4ff;
    }

    .signo-btn.selected {
      border-color: #3b82f6;
      background: #dbeafe;
      font-weight: 600;
      color: #1e40af;
    }

    .signo-label {
      font-size: 12px;
      color: #666;
      margin-bottom: 4px;
    }

    .logo-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      text-align: center;
    }

    .logo-box {
      width: 100px;
      height: 100px;
      border: 2px dashed #ddd;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      margin-bottom: 12px;
      color: #ccc;
    }

    .logo-name {
      font-size: 14px;
      font-weight: 600;
      color: #666;
    }

    .resumen-content {
      max-height: 360px;
      overflow-y: auto;
    }

    .resumen-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .resumen-table th {
      text-align: left;
      padding: 6px 8px;
      font-weight: 600;
      color: #666;
      font-size: 11px;
      border-bottom: 1px solid #e9ecef;
      white-space: nowrap;
    }

    .resumen-table td {
      padding: 6px 8px;
      border-bottom: 1px solid #f0f0f0;
    }

    .resumen-table tr:hover {
      background: #f8f9fa;
    }

    .resumen-table .btn-rm {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 14px;
      padding: 2px;
      opacity: 0.5;
    }

    .resumen-table .btn-rm:hover {
      opacity: 1;
    }

    .qt-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 8px;
      border-top: 2px solid #e9ecef;
      margin-top: 4px;
    }

    .total-label {
      font-weight: 600;
      font-size: 14px;
    }

    .total-amount {
      font-size: 18px;
      font-weight: 700;
      color: #667eea;
    }

    .qt-actions {
      display: flex;
      gap: 8px;
      padding: 8px;
    }

    .btn {
      flex: 1;
      padding: 8px 16px;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-primary:hover:not(:disabled) {
      opacity: 0.9;
    }

    .btn-info {
      background: #17a2b8;
      color: white;
    }

    .btn-info:hover:not(:disabled) {
      opacity: 0.9;
    }

    .btn-clear {
      background: #fff;
      color: #dc2626;
      border: 2px solid #fecaca;
    }

    .btn-clear:hover:not(:disabled) {
      background: #fef2f2;
      border-color: #dc2626;
    }

    .empty-state {
      text-align: center;
      padding: 30px 0;
      color: #999;
      font-style: italic;
      font-size: 13px;
    }
  </style>
  
  <script>
    import { apiFetch } from '../utils/apiFetch';
    import { getFingerprint } from '../utils/device';
    import { cargarCatalogo } from '../utils/catalogo';
    import { buildZoneGraph, routeKey, KEYMAP } from '../utils/keyboard';
    import { alternarHorario, marcarTodosVisibles, expandirLineas, horarioExpirado, filtrarHorariosFuturos, seleccionadosExpirados } from '../utils/horarios';
    import juegosRaw from '../data/juegos.json';

    // Catálogo local bundled (REQ-CL-01): reemplaza GAMES_CONFIG. Los juegos,
    // horarios y opciones vienen del JSON; la familia de opciones (A5) define
    // la búsqueda/selección por juego activo (REQ-CL-02, REQ-KB-02).
    const catalogo = cargarCatalogo(juegosRaw);

    let tasaActiva = 36.50;

    let selectedGames = [];
    let ticketLines = [];
    let animalesCache = [];
    let selectedAnimal = null;
    let selectedSigno = null;
    let selectedOpcion = null; // numérica/terminal: opción resaltada en la lista
    let columnMode = 'juegos';
    let zonaActual = 'juegos';

    const ANIMAL_EMOJIS = ['🐬','🐏','🐂','🐆','🐸','🐕','🐈','🕊️','🦜','🐿️','🐅','🦁','🐄','🦅','🦊','🐒','🦚','🐎','🐻','🫏','🐓','🐪','🐈‍⬛','🐍','🦌','🐐','🐘','🐖','🦆','🐊','🦚','🐟','🦀','🦔','🐇','🐦','🐔'];

    // Apostado types de tripletas (A2): el JSON bundled NO trae apostado types
    // (sus "modalidades" son premios informativos: cola, zodiacal, punta…).
    // zodiacal → triple_a/b/c (con zona signo solo para triple_c, D1);
    // triple-numérico → solo triple_a, implícito al seleccionar el juego.
    const APOSTADOS_TRIPLETAS = [
      { code: 'triple_a', label: 'Triple A', digitos: 3, requiere_signo: false },
      { code: 'triple_b', label: 'Triple B', digitos: 3, requiere_signo: false },
      { code: 'triple_c', label: 'Triple C', digitos: 3, requiere_signo: true },
    ];

    const NOMBRE_ZONA = {
      juegos: 'Juegos', modalidad: 'Modalidad', seleccion: 'Selección', signo: 'Signo',
      horarios: 'Horario', numero: 'Número', monto: 'Monto', anadir: 'Añadir', resumen: 'Resumen',
    };

    // Objetivo de foco de cada zona (roving focus / tabindex explícito, KB-01).
    const TARGETS_ZONA = {
      juegos: '#juegos-list',
      modalidad: '#modalidad-grid',
      seleccion: '#seleccion-content',
      signo: '#signos-triple-container',
      horarios: '#horarios-grid',
      numero: '#qt-numero',
      monto: '#qt-monto',
      anadir: '#qt-add',
      resumen: '#resumen-content',
    };

    function getGameById(id) {
      return catalogo.porId.get(id) ?? null;
    }

    function getGameType(juegoId) {
      return catalogo.porId.get(juegoId)?.tipo ?? null;
    }

    // Multiselección de horarios (REQ-MH-01, A3): toggle Space/Enter/click;
    // Ctrl+A / `*` marcan todos los visibles SOLO fuera de input (KB-05).
    let selectedHorarios = [];
    let horariosCache = [];
    let activeTab = 'animalitos';
    let tripleModalidad = null;
    let tripleModalidadLabel = null;

    function initClock() {
      function updateClock() {
        const now = new Date();
        const opts = { timeZone: 'America/Caracas', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
        document.getElementById('clock').textContent = now.toLocaleTimeString('en-US', opts);
      }
      updateClock();
      setInterval(updateClock, 1000);
    }

    function loadTicket() {
      const raw = localStorage.getItem('currentTicket');
      const ticket = raw ? JSON.parse(raw) : null;
      document.getElementById('jugadas').textContent = ticket?.jugadas ?? 0;
      document.getElementById('total-pagar').textContent = ticket
        ? `Bs. ${Number(ticket.totalBs).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`
        : 'Bs. 0,00';
    }

    async function loadTasa() {
      try {
        const data = await apiFetch('/exchange-rate/active');
        tasaActiva = data.rate;
        document.getElementById('tasa-dolar').textContent = `Bs. ${Number(data.rate).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`;
        const fecha = data.updated_at ? new Date(data.updated_at).toLocaleDateString('es-VE') : 'hoy';
        document.getElementById('tasa-meta').textContent = `Actualizada: ${fecha}`;
      } catch (e) {
        document.getElementById('tasa-dolar').textContent = '--';
        document.getElementById('tasa-meta').textContent = 'No disponible';
      }
    }

    async function loadJuegos() {
      renderJuegos();
    }

    function activarTab(tipo) {
      if (activeTab === tipo) return;
      activeTab = tipo;
      selectedGames = [];
      selectedAnimal = null;
      selectedSigno = null;
      selectedOpcion = null;
      tripleModalidad = null;
      tripleModalidadLabel = null;
      document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
      horariosCache = [];
      selectedHorarios = [];
      renderJuegosTabs();
      renderJuegos();
      renderLegend();
      switchToJuegos();
      document.getElementById('juegos-col-title').textContent = 'Juegos';
    }

    function ordenTabs() {
      return ['animalitos', 'tripletas', 'terminales'].filter(t => catalogo.juegos.some(j => j.tipo === t));
    }

    function tabAnterior() {
      const orden = ordenTabs();
      const i = orden.indexOf(activeTab);
      return orden[(i - 1 + orden.length) % orden.length];
    }

    function tabSiguiente() {
      const orden = ordenTabs();
      const i = orden.indexOf(activeTab);
      return orden[(i + 1) % orden.length];
    }

    function renderJuegosTabs() {
      const container = document.getElementById('juegos-tabs');
      container.innerHTML = '';
      const labels = { animalitos: 'Animalitos', tripletas: 'Tripletas', terminales: 'Terminales' };
      ordenTabs().forEach(t => {
        const btn = document.createElement('button');
        btn.className = 'juego-tab' + (activeTab === t ? ' active' : '');
        btn.dataset.tab = t;
        btn.tabIndex = -1; // las pestañas se cambian con ←/→ (KB-03)
        btn.textContent = labels[t] || t;
        btn.addEventListener('click', () => activarTab(t));
        container.appendChild(btn);
      });
    }

    function renderJuegos() {
      const container = document.getElementById('juegos-list');
      const juegos = catalogo.juegos.filter(j => j.tipo === activeTab);
      if (juegos.length === 0) {
        container.innerHTML = '<div class="empty-state">Sin juegos disponibles</div>';
        return;
      }
      container.innerHTML = juegos.map(j => {
        let icon = activeTab === 'animalitos' ? '🎰' : activeTab === 'tripletas' ? '🎯' : '🔢';
        const selected = selectedGames.some(g => g.id === j.id) ? ' selected' : '';
        return `<div class="juego-card${selected}" data-id="${j.id}">
          <span class="juego-icon">${icon}</span>
          <span class="juego-name">${j.nombre}</span>
        </div>`;
      }).join('');
    }

    function juegoActivo() {
      return selectedGames.length === 1 ? selectedGames[0] : null;
    }

    // Grafo de zonas del juego activo (A2): se reconstruye al cambiar de
    // juego o de modalidad (la zona signo existe solo con triple_c, D1).
    function grafoActual() {
      const juego = juegoActivo();
      const familia = juego?.familia ?? 'animalitos';
      return buildZoneGraph(familia, { triple_c: tripleModalidad === 'triple_c' });
    }

    function loadHorariosConfig() {
      const juego = juegoActivo();
      if (!juego) return;
      horariosCache = juego.horarios.map(h => ({ hora: h }));
      selectedHorarios = [];
      renderHorariosGrid();
    }

    // Selección por FAMILIA DE OPCIONES del juego activo (REQ-CL-02, KB-02).
    function renderSeleccion() {
      const juego = juegoActivo();
      const container = document.getElementById('seleccion-content');
      if (!juego) {
        container.innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
        return;
      }
      if (juego.familia === 'animalitos') {
        animalesCache = juego.opciones;
        renderAnimales();
      } else if (juego.familia === 'zodiacal') {
        renderTripleModalidades();
      } else if (juego.familia === 'numerica') {
        tripleModalidad = 'triple_a'; // A2: triple-numérico → solo triple_a
        tripleModalidadLabel = 'Triple A';
        renderOpcionesLista(juego);
      } else {
        renderOpcionesLista(juego); // terminal: 2 cifras
      }
    }

    function renderAnimales() {
      const container = document.getElementById('seleccion-content');
      const juego = juegoActivo();
      const lista = juego ? juego.opciones : animalesCache;
      container.innerHTML = lista.map(a => {
        const emoji = ANIMAL_EMOJIS[a.numero] || '🐾';
        const sel = selectedAnimal && selectedAnimal.label === a.label ? ' selected' : '';
        return `<div class="animal-check${sel}" data-numero="${a.numero}" data-label="${a.label}" tabindex="-1">
          <span class="animal-num">${a.numero}</span>
          <span class="animal-emoji">${emoji}</span>
          <span class="animal-label">${a.label}</span>
        </div>`;
      }).join('');
      container.querySelectorAll('.animal-check').forEach(el => {
        el.addEventListener('click', () => {
          const num = parseInt(el.dataset.numero);
          const label = el.dataset.label;
          if (selectedAnimal && selectedAnimal.label === label) {
            selectedAnimal = null;
          } else {
            selectedAnimal = { numero: num, label: label };
          }
          renderAnimales();
          updateColumnMode();
        });
      });
    }

    // Numérica (100 opciones 00-99) y terminal (00-99): lista de 2 dígitos.
    // Deferral aceptado: sin padding 05→005 (ver design/PR2).
    function renderOpcionesLista(juego) {
      const container = document.getElementById('seleccion-content');
      let html = '<div class="modalidad-label">Seleccione el número (00-99):</div>';
      html += '<div class="opciones-lista">';
      juego.opciones.forEach(op => {
        const sel = selectedOpcion && selectedOpcion.numero === op.numero ? ' selected' : '';
        html += '<div class="animal-check opcion-item' + sel + '" data-numero="' + op.numero + '" data-label="' + op.label + '" tabindex="-1">' +
          '<span class="animal-num">' + op.label + '</span>' +
          '<span class="animal-label">' + op.label + '</span>' +
          '</div>';
      });
      html += '</div>';
      container.innerHTML = html;
      container.querySelectorAll('.opcion-item').forEach(el => {
        el.addEventListener('click', () => {
          selectedOpcion = { numero: parseInt(el.dataset.numero), label: el.dataset.label };
          document.getElementById('qt-numero').value = el.dataset.label;
          container.querySelectorAll('.opcion-item').forEach(o => o.classList.remove('selected'));
          el.classList.add('selected');
          updateColumnMode();
        });
      });
    }

    function renderSignosForModalidad() {
      const juego = juegoActivo();
      const container = document.getElementById('signos-triple-container');
      if (!juego || tripleModalidad !== 'triple_c') {
        container.style.display = 'none';
        selectedSigno = null;
        return;
      }
      container.style.display = 'block';
      const signos = juego.opciones; // familia zodiacal: 12 signos (numero null)
      if (!signos || signos.length === 0) return;
      let html = '<div class="signo-label">Seleccione signo (obligatorio):</div>';
      html += '<div class="signos-grid">';
      signos.forEach(s => {
        const sel = selectedSigno && selectedSigno.value === s.value ? ' selected' : '';
        html += '<button class="signo-btn' + sel + '" data-value="' + s.value + '" data-label="' + s.label + '" tabindex="-1">' + s.label + '</button>';
      });
      html += '</div>';
      container.innerHTML = html;
      container.querySelectorAll('.signo-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.signo-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedSigno = { value: btn.dataset.value, label: btn.dataset.label };
          renderLegend();
          updateColumnMode();
        });
      });
    }

    function updateColumnMode() {
      const juego = juegoActivo();
      if (!juego) {
        switchToJuegos();
        return;
      }
      let listo = false;
      if (juego.familia === 'animalitos') {
        listo = selectedAnimal !== null;
      } else if (juego.familia === 'zodiacal') {
        listo = tripleModalidad !== null && (tripleModalidad !== 'triple_c' || selectedSigno !== null);
      } else if (juego.familia === 'numerica') {
        listo = tripleModalidad === 'triple_a';
      } else {
        listo = true; // terminal
      }
      if (listo) {
        switchToHorarios();
      } else {
        switchToJuegos();
      }
    }

    function switchToHorarios() {
      columnMode = 'horarios';
      document.getElementById('juegos-list').style.display = 'none';
      document.getElementById('horario-mode').style.display = 'block';
      document.getElementById('juegos-col-title').textContent = 'Horario';
      renderGameChips();
      if (horariosCache.length === 0 && selectedGames.length > 0) {
        loadHorariosConfig();
      } else {
        renderHorariosGrid();
      }
    }

    function switchToJuegos() {
      columnMode = 'juegos';
      document.getElementById('juegos-list').style.display = 'flex';
      document.getElementById('horario-mode').style.display = 'none';
      document.getElementById('juegos-col-title').textContent = 'Juegos';
    }

    function renderGameChips() {
      const container = document.getElementById('game-chips');
      container.innerHTML = selectedGames.map(g => '<span class="game-chip">' + g.nombre + '</span>').join('');
    }

    // Filtro dinámico de sorteos futuros (REQ-MH-04, A4): solo HH:MM > ahora en
    // America/Caracas; se refresca cada 15 s (interval en DOMContentLoaded).
    function horariosVisibles() {
      return filtrarHorariosFuturos(horariosCache.map(h => h.hora));
    }

    function renderHorariosGrid() {
      const container = document.getElementById('horarios-grid');
      const visibles = horariosVisibles();
      // Los seleccionados que expiraron siguen visibles (en rojo) para poder
      // desmarcarlos (REQ-MH-04, A4): se muestran al final de la lista.
      const extras = seleccionadosExpirados(selectedHorarios).filter(h => !visibles.includes(h));
      const items = [...visibles, ...extras];
      if (items.length === 0) {
        container.innerHTML = '<div style="font-size:12px;color:#999;padding:8px">Sin horarios disponibles</div>';
        renderHorarioAviso();
        return;
      }
      container.innerHTML = items.map(hora => {
        const sel = selectedHorarios.includes(hora) ? ' selected' : '';
        const exp = horarioExpirado(hora) ? ' expirado' : '';
        return '<div class="horario-item' + sel + exp + '" data-hora="' + hora + '" tabindex="-1">' + hora + '</div>';
      }).join('');
      renderHorarioAviso();
    }

    // Aviso de expiración (A4, REQ-MH-04): rojo mientras haya un horario
    // seleccionado que ya pasó; addLine bloquea (guarda) hasta desmarcarlo.
    function renderHorarioAviso() {
      const aviso = document.getElementById('qt-horario-aviso');
      if (!aviso) return;
      const expirados = seleccionadosExpirados(selectedHorarios);
      if (expirados.length > 0) {
        aviso.textContent = 'El horario ' + expirados.join(', ') + ' ya pasó. Desmárquelo para continuar.';
        aviso.style.display = 'block';
      } else {
        aviso.style.display = 'none';
      }
    }

    // Identidad de grupo por jugada (A3): cada Añadir crea un groupId nuevo,
    // así dos jugadas iguales no comparten grupo (duplicados = grupo nuevo).
    let grupoSeq = 0;
    function nuevoGroupId() {
      grupoSeq += 1;
      return 'g' + grupoSeq;
    }

    function toggleHorario(hora) {
      const eraSeleccionado = selectedHorarios.includes(hora);
      selectedHorarios = alternarHorario(selectedHorarios, hora);
      if (eraSeleccionado && horarioExpirado(hora)) {
        // Se desmarcó un horario expirado: desaparece de la lista (filtro A4)
        // y el aviso se actualiza; sin auto-salto (D3).
        renderHorariosGrid();
        enfocarZona('horarios');
        return;
      }
      // Actualiza la clase del ítem sin re-renderizar (preserva el foco del
      // roving focus al alternar con Space/Enter/click).
      const item = document.querySelector('#horarios-grid .horario-item[data-hora="' + hora + '"]');
      item?.classList.toggle('selected', selectedHorarios.includes(hora));
      renderHorarioAviso();
    }

    function marcarTodosHorarios() {
      if (columnMode !== 'horarios') return;
      const prevHora = document.activeElement?.dataset?.hora;
      selectedHorarios = marcarTodosVisibles(horariosVisibles());
      renderHorariosGrid();
      if (prevHora) {
        const nuevo = document.querySelector('#horarios-grid .horario-item[data-hora="' + prevHora + '"]');
        nuevo?.focus({ preventScroll: true });
      }
    }

    function renderTripleModalidades() {
      const container = document.getElementById('seleccion-content');
      let html = '<div class="modalidad-label">Seleccione modalidad:</div>';
      html += '<div class="modalidad-grid" id="modalidad-grid" data-zona="modalidad">';
      APOSTADOS_TRIPLETAS.forEach(m => {
        const sel = tripleModalidad === m.code ? ' selected' : '';
        html += '<button class="modalidad-btn' + sel + '" data-modalidad="' + m.code + '" tabindex="-1">' + m.label + '</button>';
      });
      html += '</div>';
      html += '<div class="triple-info">Ingrese número de 3 cifras en el campo superior</div>';
      html += '<div id="signos-triple-container" style="display:none" data-zona="signo"></div>';
      container.innerHTML = html;
      container.querySelectorAll('.modalidad-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.modalidad-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          tripleModalidad = btn.dataset.modalidad;
          tripleModalidadLabel = btn.textContent;
          document.getElementById('qt-numero').value = '';
          renderSignosForModalidad();
          renderLegend();
          updateColumnMode();
        });
      });
    }

    // sorteo_hora del POST por línea (REQ-TF-01, A4): `<hoy> HH:MM:00` sin salto
    // de día (D3). El cliente solo permite horarios futuros del día (filtro A4)
    // y bloquea los que expiran; el backend D3 (PR4) es la autoridad final.
    function formatDateWithHorario(hora) {
      const partes = hora.split(':');
      const d = new Date();
      d.setHours(parseInt(partes[0]), parseInt(partes[1] || '0'), 0, 0);
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      return y + '-' + m + '-' + day + ' ' + hh + ':' + mm + ':00';
    }

    function getTotalBs(line) {
      const monto = Number(line.monto) || 0;
      return line.moneda === 'usd' ? monto * tasaActiva : monto;
    }

    function getTicketTotal() {
      return ticketLines.reduce((sum, line) => sum + getTotalBs(line), 0);
    }

    function saveToLocalStorage() {
      const totalBs = getTicketTotal();
      localStorage.setItem('currentTicket', JSON.stringify({
        jugadas: ticketLines.length,
        totalBs: totalBs
      }));
      loadTicket();
    }

    function renderResumen() {
      const container = document.getElementById('resumen-content');
      const totalEl = document.getElementById('qt-total-amount');
      const printBtn = document.getElementById('qt-print');
      const clearBtn = document.getElementById('qt-clear');
      const hasLines = ticketLines.length > 0;

      if (!hasLines) {
        container.innerHTML = '<div class="empty-state">Sin jugadas aún</div>';
        totalEl.textContent = 'Bs. 0,00';
        printBtn.disabled = true;
        clearBtn.disabled = true;
        saveToLocalStorage();
        return;
      }

      let html = `<table class="resumen-table">
        <thead><tr>
          <th>Sorteo</th><th>Animal / N°</th><th>Monto</th><th></th>
        </tr></thead><tbody>`;
      ticketLines.forEach((line, i) => {
        const montoClass = line.moneda === 'bs' ? 'monto-bs' : 'monto-usd';
        const montoStr = line.moneda === 'bs'
          ? `Bs. ${Number(line.monto).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`
          : `$ ${Number(line.monto).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        const sorteoDisplay = line.horario
          ? (line.juegoName || '-') + ' - ' + line.horario
          : (line.juegoName || '-');
        const animalDisplay = line.juegoType === 'tripletas'
          ? (line.tripleModalidadLabel
              ? line.tripleModalidadLabel + ' ' + (line.numero || '-') + (line.animal ? ' - ' + line.animal : '')
              : (line.numero ?? '-'))
          : (line.animal ? line.animal + ' ' + (line.numero || '-') : (line.numero ?? '-'));
        html += `<tr>
          <td>${sorteoDisplay}</td>
          <td>${animalDisplay}</td>
          <td class="${montoClass}">${montoStr}</td>
          <td><button class="btn-rm" data-index="${i}" title="Eliminar">✕</button></td>
        </tr>`;
      });
      html += '</tbody></table>';
      container.innerHTML = html;

      totalEl.textContent = `Bs. ${getTicketTotal().toLocaleString('es-VE', { minimumFractionDigits: 2 })}`;
      printBtn.disabled = false;
      clearBtn.disabled = false;
      saveToLocalStorage();
    }

    function addLine() {
      let numero = document.getElementById('qt-numero').value.trim();
      const monto = document.getElementById('qt-monto').value.trim();
      const moneda = document.getElementById('qt-moneda').value;

      const juego = juegoActivo();
      if (!juego) { window.showModal({ message: 'Seleccione al menos un juego', type: 'error' }); return; }
      if (!monto || Number(monto) <= 0) { window.showModal({ message: 'Ingrese un monto válido', type: 'error' }); return; }
      if (!selectedHorarios.length) { window.showModal({ message: 'Seleccione un horario para el sorteo', type: 'error' }); return; }

      // Bloqueo por expiración (REQ-MH-04, A4): si algún horario seleccionado
      // ya pasó no se añade nada; se avisa y queda desmarcable (sin auto-salto).
      const expirados = seleccionadosExpirados(selectedHorarios);
      if (expirados.length > 0) {
        window.showModal({ message: 'El horario ' + expirados.join(', ') + ' ya pasó. Desmárquelo y seleccione un horario futuro.', type: 'error' });
        renderHorariosGrid();
        return;
      }

      const familia = juego.familia;
      if (familia === 'zodiacal') {
        if (!tripleModalidad) { window.showModal({ message: 'Seleccione una modalidad (Triple A/B/C)', type: 'error' }); return; }
        if (tripleModalidad === 'triple_c' && !selectedSigno) { window.showModal({ message: 'Seleccione un signo (obligatorio para Triple C)', type: 'error' }); return; }
        if (!numero || numero.length !== 3) { window.showModal({ message: 'Ingrese un número de exactamente 3 cifras', type: 'error' }); return; }
      } else if (familia === 'numerica' || familia === 'terminal') {
        // Deferral aceptado: numérica sin padding 05→005; 2 cifras como terminal.
        if (!numero || numero.length !== 2) { window.showModal({ message: 'Ingrese un número de exactamente 2 cifras', type: 'error' }); return; }
      } else {
        if (!selectedAnimal) { window.showModal({ message: 'Seleccione un animal', type: 'error' }); return; }
        numero = String(selectedAnimal.numero).padStart(2, '0');
      }

      // Expansión multi-horario (REQ-MH-02, REQ-TF-01, D2): N horarios ⇒ N líneas,
      // cada una con el monto completo y el groupId del grupo (A3). El
      // resumen agrupa por groupId; los duplicados generan grupo nuevo.
      const groupId = nuevoGroupId();
      selectedGames.forEach(game => {
        const animal = familia === 'zodiacal'
          ? (selectedSigno ? selectedSigno.label : null)
          : (selectedAnimal ? selectedAnimal.label : null);
        const baseLinea = {
          juegoId: game.id,
          juegoName: game.nombre,
          juegoType: game.tipo,
          numero: numero,
          animal: animal,
          monto: Number(monto),
          moneda: moneda,
          tripleModalidad: familia === 'zodiacal' ? tripleModalidad : null,
          tripleModalidadLabel: familia === 'zodiacal' ? tripleModalidadLabel : null,
        };
        ticketLines.push(...expandirLineas(baseLinea, [...selectedHorarios], groupId));
      });

      document.getElementById('qt-numero').value = '';
      document.getElementById('qt-monto').value = '';
      if (familia === 'zodiacal') {
        tripleModalidad = null;
        tripleModalidadLabel = null;
        selectedSigno = null;
        renderSeleccion();
      } else if (familia === 'numerica' || familia === 'terminal') {
        selectedOpcion = null;
        renderSeleccion();
      } else {
        selectedAnimal = null;
        renderAnimales();
      }
      renderResumen();
      updateColumnMode();
    }

    function clearTicket() {
      ticketLines = [];
      selectedAnimal = null;
      selectedSigno = null;
      selectedOpcion = null;
      tripleModalidad = null;
      tripleModalidadLabel = null;
      selectedHorarios = [];
      document.getElementById('qt-numero').value = '';
      document.getElementById('qt-monto').value = '';
      if (juegoActivo()) {
        renderSeleccion();
      } else {
        document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
      }
      switchToJuegos();
      saveToLocalStorage();
      renderResumen();
    }

    function removeLine(index) {
      ticketLines.splice(index, 1);
      if (ticketLines.length === 0) {
        selectedAnimal = null;
        selectedSigno = null;
        selectedOpcion = null;
        tripleModalidad = null;
        tripleModalidadLabel = null;
        selectedHorarios = [];
        document.getElementById('qt-numero').value = '';
        if (juegoActivo()) {
          renderSeleccion();
        } else {
          document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
        }
        switchToJuegos();
      }
      renderResumen();
    }

    async function handlePrint() {
      if (ticketLines.length === 0) return;
      const printBtn = document.getElementById('qt-print');
      printBtn.disabled = true;
      try {
        const lines = ticketLines.map(line => ({
          juego_id: line.juegoId,
          combinacion: line.tripleModalidad
            ? { tipo: line.tripleModalidad, numero: line.numero, signo: line.animal }
            : (line.juegoType === 'terminales'
              ? { numero: line.numero }
              : { animal: line.animal || line.numero, numero: line.numero }),
          amount_bs: line.moneda === 'bs' ? line.monto : 0,
          amount_usd: line.moneda === 'usd' ? line.monto : 0,
          sorteo_hora: line.horario ? formatDateWithHorario(line.horario) : new Date().toISOString(),
        }));

        const result = await apiFetch('/tickets', { method: 'POST', body: { lines } });

        const ticketData = {
          ticketCode: result.data.ticket_code,
          date: new Date().toLocaleDateString('es-VE'),
          time: new Date().toLocaleTimeString('es-VE'),
          game: selectedGames.length > 0 ? selectedGames.map(g => g.nombre).join(', ') : 'Apuesta',
          lines: ticketLines.map(l => ({ animal: l.animal || l.numero, number: l.numero, amountBs: l.moneda === 'bs' ? l.monto : 0, amountUsd: l.moneda === 'usd' ? l.monto : 0 })),
        };
        if (window.electron?.printTicket) {
          await window.electron.printTicket({ ticketData });
        } else {
          await window.showModal({ message: 'Ticket ' + result.data.ticket_code + ' creado exitosamente. Impresión no disponible.', type: 'success' });
        }
        ticketLines = [];
        renderResumen();
        localStorage.removeItem('currentTicket');
        loadTicket();
      } catch (e) {
        await window.showModal({ message: 'Error: ' + e.message, type: 'error' });
      }
      printBtn.disabled = false;
    }

    // ─── Navegación por teclado (PR2: KB-01..04, KB-08, KB-09; A1) ──────────
    // Las ACCIONES de F-keys (F2..F12) se implementan en PR3b; aquí solo se
    // registran como hooks (STUBS_FKEYS) y se aplican las GUARDAS de estado
    // via routeKey. NO se implementa comportamiento de F-keys en este slice.
    const STUBS_FKEYS = {
      ayuda: () => console.debug('[PR3b] F1 ayuda: modal de ayuda pendiente'),
      limpiar: () => console.debug('[PR3b] F2 limpiar: clearTicket pendiente'),
      'anular-ultima': () => console.debug('[PR3b] F3 anular última: pendiente'),
      'repetir-ultima': () => console.debug('[PR3b] F4 repetir última: pendiente'),
      'pagar-generar': () => console.debug('[PR3b] F5 pagar/generar: handlePrint pendiente'),
      'eliminar-item': () => console.debug('[PR3b] F6 eliminar ítem: pendiente'),
      ventas: () => console.debug('[PR3b] F7 ventas: navegación pendiente'),
      cuadre: () => console.debug('[PR3b] F8 cuadre: navegación pendiente'),
      vuelto: () => console.debug('[PR3b] F9 vuelto: modal pendiente'),
      resultados: () => console.debug('[PR3b] F10 resultados: navegación pendiente'),
      reimprimir: () => console.debug('[PR3b] F12 reimprimir: pendiente'),
    };

    function esEditable(target) {
      const t = target?.tagName;
      return t === 'INPUT' || t === 'SELECT' || t === 'TEXTAREA';
    }

    // Guarda de modal (REQ-KB-08): cualquier .modal-overlay (showModal de
    // MainLayout) o el futuro #help-overlay.abierto (PR3b).
    function detectarModalAbierto() {
      return (
        document.querySelector('.modal-overlay') !== null ||
        document.querySelector('#help-overlay.abierto') !== null
      );
    }

    function objetivoZona(zona) {
      return document.querySelector(TARGETS_ZONA[zona]);
    }

    function zonaVisible(zona) {
      const el = objetivoZona(zona);
      if (!el) return false;
      return el.offsetParent !== null || el === document.body;
    }

    // Roving tabindex explícito (KB-01): solo la zona actual es tabulable.
    function sincronizarTabindex(zona) {
      Object.keys(TARGETS_ZONA).forEach(z => {
        const el = objetivoZona(z);
        if (!el) return;
        if (z === 'numero' || z === 'monto') return; // inputs conservan tabindex nativo
        el.tabIndex = z === zona ? 0 : -1;
      });
    }

    function enfocarZona(zona) {
      const el = objetivoZona(zona);
      if (!el) return;
      zonaActual = zona;
      sincronizarTabindex(zona);
      el.focus({ preventScroll: true });
    }

    // Ciclo Tab/Shift+Tab (KB-01): salta zonas ocultas (p. ej. juegos en modo
    // horarios) y envuelve en el extremo.
    function moverZona(delta) {
      const grafo = grafoActual();
      const saltos = grafo.zonas.length;
      let zona = zonaActual;
      for (let i = 0; i < saltos; i++) {
        zona = delta > 0 ? grafo.siguiente(zona) : grafo.anterior(zona);
        if (zona === null) break;
        if (zonaVisible(zona)) {
          enfocarZona(zona);
          return;
        }
      }
    }

    function itemsDeZona(zona) {
      const selectores = {
        juegos: '.juego-card',
        modalidad: '.modalidad-btn',
        seleccion: '.animal-check, .opcion-item',
        signo: '.signo-btn',
        horarios: '.horario-item',
        resumen: '.resumen-table tr',
      };
      const el = objetivoZona(zona);
      if (!el) return [];
      return Array.from(el.querySelectorAll(selectores[zona] || ''));
    }

    // ↑/↓ contextuales (KB-03): recorren la lista activa de la zona enfocada
    // en orden DOM; sin wrap (el wrap es de zonas con Tab).
    function moverFila(delta) {
      const items = itemsDeZona(zonaActual);
      if (items.length === 0) return;
      const activo = document.activeElement;
      let idx = items.indexOf(activo);
      if (idx === -1) idx = delta > 0 ? -1 : items.length;
      const objetivo = items[idx + delta];
      if (!objetivo) return;
      objetivo.focus();
      objetivo.scrollIntoView({ block: 'nearest' });
    }

    // Enter activa el elemento de zona focalizado (tarjeta/opción/fila).
    function activarItemFocalizado() {
      const activo = document.activeElement;
      if (!activo || esEditable(activo)) return;
      if (!activo.closest('[data-zona]')) return;
      if (typeof activo.click === 'function') activo.click();
    }

    // Esc sube un nivel sin descartar selección ni líneas (KB-04, A1).
    function manejarEscape(nivel) {
      if (nivel === 'modal') {
        const ayuda = document.querySelector('#help-overlay.abierto');
        if (ayuda) {
          ayuda.classList.remove('abierto');
          return;
        }
        const overlay = document.querySelector('.modal-overlay');
        if (overlay) {
          const btn = overlay.querySelector('.cancel-btn') ?? overlay.querySelector('.ok-btn');
          btn?.click();
        }
        return;
      }
      if (nivel === 'input') {
        document.activeElement?.blur?.();
        return;
      }
      if (nivel === 'juegos') {
        switchToJuegos();
        document.getElementById('juegos-col-title').textContent = 'Juegos';
        requestAnimationFrame(() => enfocarZona('juegos'));
        return;
      }
      // zona-anterior: sin wrap (arriba de Juegos no hay nivel).
      if (zonaActual === 'juegos') return;
      const anterior = grafoActual().anterior(zonaActual);
      if (anterior && zonaVisible(anterior)) enfocarZona(anterior);
    }

    // Leyenda estática (REQ-KB-09): barra de estado con el mapa de zonas
    // (según el grafo del juego activo) y las teclas F1–F12.
    function renderLegend() {
      const el = document.getElementById('qt-legend');
      if (!el) return;
      const grafo = grafoActual();
      const zonasHtml = grafo.zonas
        .map(z => '<span class="kbd">' + (NOMBRE_ZONA[z] ?? z) + '</span>')
        .join('<span class="leg-arrow"> → </span>');
      const fkeysHtml = KEYMAP
        .map(k => '<span><span class="kbd">' + k.tecla + '</span> ' + k.nombre + '</span>')
        .join(' · ');
      el.innerHTML =
        '<span class="leg-grupo"><span class="leg-label">Zonas:</span> ' + zonasHtml + '</span>' +
        '<span class="leg-grupo"><span class="leg-label">Teclas:</span> ' + fkeysHtml + '</span>' +
        '<span class="leg-grupo"><span class="leg-label">Horarios:</span> <span class="kbd">Ctrl+A</span>/<span class="kbd">*</span> marcar todos</span>';
    }

    document.addEventListener('DOMContentLoaded', async () => {
      if (typeof window !== 'undefined' && window.electron?.getVersion) {
        try {
          const checkData = await apiFetch('/dispositivo/verificar', {
            method: 'POST',
            body: { device_fingerprint: getFingerprint() },
          });
          if (checkData.status === 'pending') {
            window.location.href = '/activacion';
            return;
          }
        } catch (error) {
          console.error('No se pudo verificar el dispositivo:', error);
          await window.showModal({
            message: 'No se pudo verificar el dispositivo. Verifique su conexión e intente nuevamente.',
            type: 'error',
          });
        }
      }

      initClock();
      localStorage.removeItem('currentTicket');
      loadTicket();
      loadTasa();
      loadJuegos();
      renderJuegosTabs();

      setInterval(loadTicket, 2000);

      // Refresco del filtro de sorteos futuros (REQ-MH-04, A4): cada 15 s se
      // re-renderiza la lista; los seleccionados que expiran pasan a rojo y
      // el aviso #qt-horario-aviso se actualiza.
      setInterval(() => {
        if (columnMode === 'horarios') renderHorariosGrid();
      }, 15000);

      document.getElementById('juegos-list').addEventListener('click', (e) => {
        const card = e.target.closest('.juego-card');
        if (!card) return;
        const id = parseInt(card.dataset.id);
        const juego = getGameById(id);
        if (!juego) return;

        const yaSeleccionado = selectedGames.some(g => g.id === id);
        if (yaSeleccionado) {
          selectedGames = [];
        } else {
          selectedGames = [juego];
        }
        selectedSigno = null;
        selectedAnimal = null;
        selectedOpcion = null;
        tripleModalidad = null;
        tripleModalidadLabel = null;

        renderJuegos();
        if (selectedGames.length > 0) {
          renderSeleccion();
          loadHorariosConfig();
        } else {
          document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
          horariosCache = [];
          selectedHorarios = [];
          switchToJuegos();
        }
        renderLegend();
        updateColumnMode();
      });

      document.getElementById('horarios-grid').addEventListener('click', (e) => {
        const item = e.target.closest('.horario-item');
        if (!item) return;
        toggleHorario(item.dataset.hora);
      });
      if (document.getElementById('back-to-juegos')) {
        document.getElementById('back-to-juegos').addEventListener('click', () => {
          switchToJuegos();
          document.getElementById('juegos-col-title').textContent = 'Juegos';
          enfocarZona('juegos');
        });
      }

      document.getElementById('qt-add').addEventListener('click', addLine);

      document.getElementById('resumen-content').addEventListener('click', (e) => {
        const btn = e.target.closest('.btn-rm');
        if (btn) removeLine(parseInt(btn.dataset.index));
      });

      document.getElementById('qt-clear').addEventListener('click', clearTicket);
      document.getElementById('qt-print').addEventListener('click', handlePrint);

      document.getElementById('qt-numero').addEventListener('input', (e) => {
        if (!selectedGames[0] || selectedGames[0].tipo !== 'animalitos') return;
        if (animalesCache.length === 0) return;
        const val = parseInt(e.target.value);
        if (isNaN(val)) { selectedAnimal = null; renderAnimales(); updateColumnMode(); return; }
        const animal = animalesCache.find(a => a.numero === val);
        if (animal) {
          selectedAnimal = { numero: animal.numero, label: animal.label };
          renderAnimales();
          updateColumnMode();
        }
      });

      let addingLine = false;
      document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' && e.key === 'Enter') {
          e.preventDefault();
          if (addingLine) return;
          addingLine = true;
          addLine();
          setTimeout(() => { addingLine = false; }, 500);
        }
      });

      // ─── Router de teclado (A1): una sola escucha en document ────────────
      renderLegend();
      enfocarZona('juegos'); // KB-01: foco inicial en la zona Juegos

      // focusin sincroniza la zona actual con el elemento enfocado.
      document.addEventListener('focusin', (e) => {
        const zonaEl = e.target.closest?.('[data-zona]');
        if (zonaEl && zonaEl.dataset.zona) {
          zonaActual = zonaEl.dataset.zona;
          sincronizarTabindex(zonaActual);
        }
      });

      document.addEventListener('keydown', (e) => {
        const decision = routeKey({
          tecla: e.key,
          repeat: e.repeat,
          ctrlKey: e.ctrlKey,
          shiftKey: e.shiftKey,
          focoEditable: esEditable(e.target),
          zonaActual,
          modalAbierto: detectarModalAbierto(),
          modalPropio: null, // PR3b: F1/F9 abren sus propios modales
          columnMode,
          tieneLineas: ticketLines.length > 0,
          tieneHistorial: ticketLines.length > 0,
        });
        if (!decision.consume) return;
        e.preventDefault();

        switch (decision.tipo) {
          case 'tab-siguiente': moverZona(1); break;
          case 'tab-anterior': moverZona(-1); break;
          case 'pestana-anterior': activarTab(tabAnterior()); break;
          case 'pestana-siguiente': activarTab(tabSiguiente()); break;
          case 'fila-anterior': moverFila(-1); break;
          case 'fila-siguiente': moverFila(1); break;
          case 'marcar-todos': marcarTodosHorarios(); break;
          case 'escape': manejarEscape(decision.nivel); break;
          case 'toggle-modal': break; // PR3b: toggle del modal propio (F1/F9)
          case 'f-key': {
            if (!decision.ejecutable) break; // guarda de estado (KB-08, A11)
            STUBS_FKEYS[decision.accion]?.();
            break;
          }
          default: break;
        }
      });

      // Enter/Space activan el elemento de zona focalizado (KB-05: toggle de
      // horarios con Space/Enter; PR2 ya activaba con Enter). Dentro de inputs
      // el Enter existente hace addLine y Space escribe texto (no se intercepta).
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        if (esEditable(e.target)) return;
        activarItemFocalizado();
        if (e.key === ' ') e.preventDefault(); // Space en ítem: sin scroll de página
      });
    });
  </script>
</MainLayout>
