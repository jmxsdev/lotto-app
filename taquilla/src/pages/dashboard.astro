        // El emoji decorativo acompaña SOLO al fallback sin logo: junto al logo
        // era ruido visual (pedido del usuario).
        const iconoDecorativo = archivo ? '' : `<span class="juego-icon" aria-hidden="true">${icon}</span>`;
        // Caption del roving focus: con logos, el nombre solo se ve al enfocar
        // la tarjeta con ↑/↓ o al pasar el mouse (overlay, ver .juego-caption).
        // `alt`/`title` del <img> se mantienen como refuerzo accesible.
        const caption = archivo
          ? `<span class="juego-caption" aria-hidden="true"><span>${j.nombre}</span></span>`
          : '';
        const contenido = archivo
          ? `<div class="juego-logo-box"><img class="juego-logo" src="/images/juegos/${archivo}" alt="${j.nombre}" title="${j.nombre}" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false;">${nombre}${caption}</div>`
          : nombre;
        // tabindex="-1" (FIX-1, KB-01): las tarjetas son ítems del roving
        // focus (↑/↓ + Enter); sin esto moverFila().focus() era un no-op.
        return `<div class="juego-card${selected}" data-id="${j.id}" tabindex="-1">
          ${iconoDecorativo}
          ${contenido}
        </div>`;
      }).join('');
    }

    function juegoActivo() {
      return selectedGames.length === 1 ? selectedGames[0] : null;
    }

    // Grafo de zonas del juego activo (A2, D3): se reconstruye al cambiar de
    // juego o de modalidad. S5: con modalidadNueva se activa la zona modalidad
    // (en numérica/terminal), la zona signo si la modalidad la exige y se
    // omite numero para signo_solo (digitos 0). S6: la multi-selección
    // (cruzado/Par A+B) activa la zona numero_b entre numero y monto
    // (design §5). La legacy triple_c sigue alimentando ctx.triple_c.
    function grafoActual() {
      const juego = juegoActivo();
      const familia = juego?.familia ?? 'animalitos';
      const ctx = { triple_c: tripleModalidad === 'triple_c' };
      if (modalidadNueva) {
        ctx.modalidad = true;
        if (modalidadNueva.requiereSigno) ctx.signo = true;
        if (modalidadNueva.digitos === 0) ctx.numero = false;
        if (modalidadNueva.selecciones) ctx.segundaSeleccion = true;
      }
      return buildZoneGraph(familia, ctx);
    }

    function loadHorariosConfig() {
      const juego = juegoActivo();
      if (!juego) return;
      horariosCache = juego.horarios.map(h => ({ hora: h }));
      selectedHorarios = [];
      renderHorariosGrid();
    }

    // Selección por FAMILIA DE OPCIONES del juego activo (REQ-CL-02, KB-02).
    // S5 (D2): si el catálogo expone modalidades single-draw (premios.
    // modalidades), se renderiza el selector NUEVO (renderModalidadesNuevas);
    // la legacy renderTripleModalidades (Triple A/B/C) queda para juegos sin
    // modalidades (y como red de seguridad).
    function renderSeleccion() {
      const juego = juegoActivo();
      const container = document.getElementById('seleccion-content');
      if (!juego) {
        container.innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
        sincronizarNumeroB();
        return;
      }
      if (juego.familia === 'animalitos') {
        animalesCache = juego.opciones;
        // S6: los juegos de animalitos con tripleta en el catálogo (Cazalotón,
        // Loto Chaima) ofrecen el modo base + el modo Tripleta (contador n/3).
        if (modalidadesDisponibles(juego).some((m) => m.clave === 'tripleta')) {
          renderAnimalitosConTripleta();
        } else {
          renderAnimales();
        }
      } else if (modalidadesDisponibles(juego).length > 0) {
        renderModalidadesNuevas();
      } else if (juego.familia === 'zodiacal') {
        renderTripleModalidades();
      } else if (juego.familia === 'numerica') {
        tripleModalidad = 'triple_a'; // A2: triple-numérico va directo a triple_a
        tripleModalidadLabel = 'Triple A';
        renderOpcionesLista(juego);
      } else {
        renderOpcionesLista(juego); // terminal: 2 cifras
      }
    }

    // S6 (design §5): el input numero_b (2ª selección de cruzado/Par A+B) solo
    // se muestra con una modalidad multi-selección activa; oculto está fuera
    // del ciclo de zonas (zonaVisible false) y no interfiere con el flujo.
    function sincronizarNumeroB() {
      const nb = document.getElementById('qt-numero-b');
      if (!nb) return;
      nb.style.display = modalidadNueva && modalidadNueva.selecciones ? '' : 'none';
    }

    // S6 (design §4/§5): selector de animalitos con Tripleta — modo base
    // (animal simple, legacy) y modo tripleta (tope 3 animales, contador
    // "n/3", toggle Space/Enter/click). El payload tripleta viaja como
    // {modalidad:'tripleta', selecciones:[{animal}×3]} (contrato §2.2).
    function renderAnimalitosConTripleta() {
      const container = document.getElementById('seleccion-content');
      const juego = juegoActivo();
      if (!juego) return;
      const mods = modalidadesDisponibles(juego);
      const tripletaDef = mods.find((m) => m.clave === 'tripleta') ?? null;
      if (!tripletaDef) { renderAnimales(); return; }
      const modo = modalidadAnimalitos || 'base';
      const mult = tripletaDef.multiplicador !== null ? ' ' + tripletaDef.multiplicador + '×' : '';
      let html =
        '<div class="modalidad-label">Seleccione modalidad:</div>' +
        '<div class="modalidad-grid" data-zona="seleccion">' +
        '<button class="modalidad-btn' + (modo === 'base' ? ' selected' : '') + '" data-modo="base" tabindex="-1">Animalito</button>' +
        '<button class="modalidad-btn' + (modo === 'tripleta' ? ' selected' : '') + '" data-modo="tripleta" tabindex="-1">Tripleta' + mult + '</button>' +
        '</div>' +
        (modo === 'tripleta'
          ? '<div class="tripleta-contador" id="tripleta-contador">Seleccionados: ' + seleccionesAnimales.length + '/3</div>'
          : '');
      html += '<div class="animalitos-list">' + juego.opciones.map((a) => {
        const emoji = a.icono || '🐾';
        const enTripleta = seleccionesAnimales.includes(a.label);
        const sel = modo === 'tripleta'
          ? (enTripleta ? ' selected' : '')
          : (selectedAnimal && selectedAnimal.label === a.label ? ' selected' : '');
        return '<div class="animal-check' + sel + '" data-numero="' + a.numero + '" data-label="' + a.label + '" tabindex="-1">' +
          '<span class="animal-num">' + a.numero + '</span>' +
          '<span class="animal-emoji">' + emoji + '</span>' +
          '<span class="animal-label">' + a.label + '</span>' +
          '</div>';
      }).join('') + '</div>';
      container.innerHTML = html;
      container.querySelectorAll('.modalidad-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.modalidad-btn').forEach((b) => b.classList.remove('selected'));
          btn.classList.add('selected');
          modalidadAnimalitos = btn.dataset.modo === 'tripleta' ? 'tripleta' : 'base';
          if (modalidadAnimalitos === 'tripleta') {
            selectedAnimal = null;
          } else {
            seleccionesAnimales = [];
          }
          renderAnimalitosConTripleta();
          renderLegend();
          updateColumnMode();
        });
      });
      container.querySelectorAll('.animal-check').forEach((el) => {
        el.addEventListener('click', () => {
          if (modalidadAnimalitos === 'tripleta') {
            // design §5: toggle Space/Enter/click, tope 3, orden estable.
            seleccionesAnimales = alternarSeleccionAnimal(seleccionesAnimales, el.dataset.label);
            renderAnimalitosConTripleta();
          } else {
            const label = el.dataset.label;
            if (selectedAnimal && selectedAnimal.label === label) {
              selectedAnimal = null;
            } else {
              selectedAnimal = { numero: parseInt(el.dataset.numero), label: label };
            }
            renderAnimalitosConTripleta();
          }
          updateColumnMode();
        });
      });
    }

    // S5 (D2): selector de modalidades single-draw desde premios.modalidades
    // del catálogo (nunca hardcodeadas). La selección alimenta modalidadNueva
    // y el grafo de zonas (D3): signo solo con ctx.signo, sin numero para
    // signo_solo (digitos 0).
    function renderModalidadesNuevas() {
      const container = document.getElementById('seleccion-content');
      const mods = modalidadesDisponibles(juegoActivo());
      let html = '<div class="modalidad-label">Seleccione modalidad:</div>';
      html += '<div class="modalidad-grid" id="modalidad-grid" data-zona="modalidad">';
      mods.forEach(m => {
        const sel = modalidadNueva && modalidadNueva.clave === m.clave ? ' selected' : '';
        const mult = m.multiplicador !== null ? ' <span class="modalidad-mult">' + m.multiplicador + '×</span>' : '';
        html += '<button class="modalidad-btn' + sel + '" data-modalidad="' + m.clave + '" tabindex="-1">' + m.label + mult + '</button>';
      });
      html += '</div>';
      html += '<div id="signos-triple-container" style="display:none" data-zona="signo"></div>';
      container.innerHTML = html;
      container.querySelectorAll('.modalidad-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.modalidad-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          const m = mods.find(x => x.clave === btn.dataset.modalidad);
          modalidadNueva = m || null;
          tripleModalidad = null;
          tripleModalidadLabel = null;
          selectedSigno = null;
          document.getElementById('qt-numero').value = '';
          // S6: la multi-selección (cruzado/Par A+B) muestra el input numero_b
          // y lo limpia al cambiar de modalidad (design §5).
          const nb = document.getElementById('qt-numero-b');
          if (nb) nb.value = '';
          sincronizarNumeroB();
          renderSignosForModalidad();
          renderLegend();
          updateColumnMode();
        });
      });
    }

    function renderAnimales() {
      const container = document.getElementById('seleccion-content');
      const juego = juegoActivo();
      const lista = juego ? juego.opciones : animalesCache;
      container.innerHTML = lista.map(a => {
        // iconografia-front R2: el icono del animalito viene del catálogo
        // bundled (campo `icono` por slug); degrada a 🐾 si falta o es vacío.
        const emoji = a.icono || '🐾';
        const sel = selectedAnimal && selectedAnimal.label === a.label ? ' selected' : '';
        return `<div class="animal-check${sel}" data-numero="${a.numero}" data-label="${a.label}" tabindex="-1">
          <span class="animal-num">${a.numero}</span>
          <span class="animal-emoji">${emoji}</span>
          <span class="animal-label">${a.label}</span>
        </div>`;
      }).join('');
      container.querySelectorAll('.animal-check').forEach(el => {
        el.addEventListener('click', () => {
          const num = parseInt(el.dataset.numero);
          const label = el.dataset.label;
          if (selectedAnimal && selectedAnimal.label === label) {
            selectedAnimal = null;
          } else {
            selectedAnimal = { numero: num, label: label };
          }
          renderAnimales();
          updateColumnMode();
        });
      });
    }

    // Numérica (100 opciones 00-99) y terminal (00-99): lista de 2 dígitos.
    // win-fixes2 FIX D: las tripletas numéricas (trio-activo, triple-facil) se
    // juegan como TRIPLE del plugin Tripletas (número de 3 cifras en el POST,
    // "05"→"005"); la UI aclara el juego y sus modalidades (punta/terminal,
    // premios informativos del catálogo, A2) para no verse como una terminal
    // genérica. El deferral del padding se cierra aquí.
    function renderOpcionesLista(juego) {
      const container = document.getElementById('seleccion-content');
      let header = 'Seleccione el número (00-99):';
      if (juego.familia === 'numerica') {
        const premios = juego.modalidades
          ? Object.entries(juego.modalidades).map(([k, v]) => k + ' ' + v + '×').join(' · ')
          : '';
        header = juego.nombre + (premios ? ' — ' + premios : '') +
          '<br><span class="modalidad-sub">Jugada como triple de 3 cifras: "05" se apuesta como 005</span>';
      }
      let html = '<div class="modalidad-label">' + header + '</div>';
      html += '<div class="opciones-lista">';
      juego.opciones.forEach(op => {
        const sel = selectedOpcion && selectedOpcion.numero === op.numero ? ' selected' : '';
        html += '<div class="animal-check opcion-item' + sel + '" data-numero="' + op.numero + '" data-label="' + op.label + '" tabindex="-1">' +
          '<span class="animal-num">' + op.label + '</span>' +
          '<span class="animal-label">' + op.label + '</span>' +
          '</div>';
      });
      html += '</div>';
      container.innerHTML = html;
      container.querySelectorAll('.opcion-item').forEach(el => {
        el.addEventListener('click', () => {
          selectedOpcion = { numero: parseInt(el.dataset.numero), label: el.dataset.label };
          document.getElementById('qt-numero').value = el.dataset.label;
          container.querySelectorAll('.opcion-item').forEach(o => o.classList.remove('selected'));
          el.classList.add('selected');
          updateColumnMode();
        });
      });
    }

    function renderSignosForModalidad() {
      const juego = juegoActivo();
      const container = document.getElementById('signos-triple-container');
      // S5: la zona signo se muestra también para modalidades single-draw
      // con signo obligatorio (signo_terminal, signo_uña, signo_solo,
      // signo_triple), además de la legacy triple_c.
      const requiereSigno = (modalidadNueva && modalidadNueva.requiereSigno) || tripleModalidad === 'triple_c';
      if (!juego || !requiereSigno) {
        container.style.display = 'none';
        selectedSigno = null;
        return;
      }
      container.style.display = 'block';
      const signos = juego.opciones; // familia zodiacal: 12 signos (numero null)
      if (!signos || signos.length === 0) return;
      let html = '<div class="signo-label">Seleccione signo (obligatorio):</div>';
      html += '<div class="signos-grid">';
      signos.forEach((s, i) => {
        const sel = selectedSigno && selectedSigno.value === s.value ? ' selected' : '';
        // win-fixes2 FIX B: índice 1-12 visible en cada botón — los dígitos
        // del teclado (zona signo) seleccionan el signo por posición.
        html += '<button class="signo-btn' + sel + '" data-value="' + s.value + '" data-label="' + s.label + '" tabindex="-1">' +
          '<span class="signo-idx">' + (i + 1) + '</span>' + s.label + '</button>';
      });
      html += '</div>';
      container.innerHTML = html;
      container.querySelectorAll('.signo-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.signo-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedSigno = { value: btn.dataset.value, label: btn.dataset.label };
          renderLegend();
          updateColumnMode();
        });
      });
    }

    function updateColumnMode() {
      const juego = juegoActivo();
      if (!juego) {
        switchToJuegos();
        return;
      }
      let listo = false;
      if (modalidadNueva) {
        if (modalidadNueva.selecciones) {
          // S6: multi-selección (cruzado/Par A+B) lista con ambas selecciones.
          const nb = document.getElementById('qt-numero-b');
          listo = document.getElementById('qt-numero').value.trim() !== '' &&
            nb !== null && nb.value.trim() !== '';
        } else {
          // S5: single-draw lista cuando no exige signo o el signo ya se eligió.
          listo = !modalidadNueva.requiereSigno || selectedSigno !== null;
        }
      } else if (juego.familia === 'animalitos') {
        // S6: en modo tripleta la selección está completa con 3/3 animales.
        listo = modalidadAnimalitos === 'tripleta'
          ? seleccionesAnimales.length === 3
          : selectedAnimal !== null;
      } else if (juego.familia === 'zodiacal') {
        listo = tripleModalidad !== null && (tripleModalidad !== 'triple_c' || selectedSigno !== null);
      } else if (juego.familia === 'numerica') {
        listo = tripleModalidad === 'triple_a';
      } else {
        listo = true; // terminal
      }
      if (listo) {
        switchToHorarios();
      }
      // FIX-4: con un juego activo y selección incompleta la columna izquierda
      // NO rebota a Juegos — los horarios quedan visibles apenas se elige el
      // juego; el regreso manual es Esc / ← Volver (KB-04). Solo la ausencia
      // total de juego (arriba) vuelve a la lista de Juegos.
    }

    function switchToHorarios() {
      columnMode = 'horarios';
      document.getElementById('juegos-list').style.display = 'none';
      document.getElementById('horario-mode').style.display = 'block';
      document.getElementById('juegos-col-title').textContent = 'Horario';
      renderGameChips();
      if (horariosCache.length === 0 && selectedGames.length > 0) {
        loadHorariosConfig();
      } else {
        renderHorariosGrid();
      }
    }

    function switchToJuegos() {
      columnMode = 'juegos';
      // display:grid explícito para restaurar el grid de 2 columnas (:none lo
      // dejó oculto en switchToHorarios); el CSS define las columnas.
      document.getElementById('juegos-list').style.display = 'grid';
      document.getElementById('horario-mode').style.display = 'none';
      document.getElementById('juegos-col-title').textContent = 'Juegos';
    }

    function renderGameChips() {
      const container = document.getElementById('game-chips');
      container.innerHTML = selectedGames.map(g => '<span class="game-chip">' + g.nombre + '</span>').join('');
    }

    // Filtro dinámico de sorteos futuros (REQ-MH-04, A4): solo HH:MM > ahora en
    // America/Caracas; se refresca cada 15 s (interval en DOMContentLoaded).
    function horariosVisibles() {
      return filtrarHorariosFuturos(horariosCache.map(h => h.hora));
    }

    function renderHorariosGrid() {
      const container = document.getElementById('horarios-grid');
      const visibles = horariosVisibles();
      // Los seleccionados que expiraron siguen visibles (en rojo) para poder
      // desmarcarlos (REQ-MH-04, A4): se muestran al final de la lista.
      const extras = seleccionadosExpirados(selectedHorarios).filter(h => !visibles.includes(h));
      const items = [...visibles, ...extras];
      if (items.length === 0) {
        container.innerHTML = '<div style="font-size:12px;color:#999;padding:8px">Sin horarios disponibles</div>';
        renderHorarioAviso();
        return;
      }
      container.innerHTML = items.map(hora => {
        const sel = selectedHorarios.includes(hora) ? ' selected' : '';
        const exp = horarioExpirado(hora) ? ' expirado' : '';
        return '<div class="horario-item' + sel + exp + '" data-hora="' + hora + '" tabindex="-1">' + hora + '</div>';
      }).join('');
      renderHorarioAviso();
    }

    // Aviso de expiración (A4, REQ-MH-04): rojo mientras haya un horario
    // seleccionado que ya pasó; addLine bloquea (guarda) hasta desmarcarlo.
    function renderHorarioAviso() {
      const aviso = document.getElementById('qt-horario-aviso');
      if (!aviso) return;
      const expirados = seleccionadosExpirados(selectedHorarios);
      if (expirados.length > 0) {
        aviso.textContent = 'El horario ' + expirados.join(', ') + ' ya pasó. Desmárquelo para continuar.';
        aviso.style.display = 'block';
      } else {
        aviso.style.display = 'none';
      }
    }

    // Identidad de grupo por jugada (A3): cada Añadir crea un groupId nuevo,
    // así dos jugadas iguales no comparten grupo (duplicados = grupo nuevo).
    let grupoSeq = 0;
    function nuevoGroupId() {
      grupoSeq += 1;
      return 'g' + grupoSeq;
    }

    function toggleHorario(hora) {
      const eraSeleccionado = selectedHorarios.includes(hora);
      selectedHorarios = alternarHorario(selectedHorarios, hora);
      if (eraSeleccionado && horarioExpirado(hora)) {
        // Se desmarcó un horario expirado: desaparece de la lista (filtro A4)
        // y el aviso se actualiza; sin auto-salto (D3).
        renderHorariosGrid();
        enfocarZona('horarios');
        return;
      }
      // Actualiza la clase del ítem sin re-renderizar (preserva el foco del
      // roving focus al alternar con Space/Enter/click).
      const item = document.querySelector('#horarios-grid .horario-item[data-hora="' + hora + '"]');
      item?.classList.toggle('selected', selectedHorarios.includes(hora));
      renderHorarioAviso();
    }

    function marcarTodosHorarios() {
      if (columnMode !== 'horarios') return;
      const prevHora = document.activeElement?.dataset?.hora;
      selectedHorarios = marcarTodosVisibles(horariosVisibles());
      renderHorariosGrid();
      if (prevHora) {
        const nuevo = document.querySelector('#horarios-grid .horario-item[data-hora="' + prevHora + '"]');
        nuevo?.focus({ preventScroll: true });
      }
    }

    function renderTripleModalidades() {
      const container = document.getElementById('seleccion-content');
      let html = '<div class="modalidad-label">Seleccione modalidad:</div>';
      html += '<div class="modalidad-grid" id="modalidad-grid" data-zona="modalidad">';
      APOSTADOS_TRIPLETAS.forEach(m => {
        const sel = tripleModalidad === m.code ? ' selected' : '';
        html += '<button class="modalidad-btn' + sel + '" data-modalidad="' + m.code + '" tabindex="-1">' + m.label + '</button>';
      });
      html += '</div>';
      html += '<div class="triple-info">Ingrese número de 3 cifras en el campo superior</div>';
      html += '<div id="signos-triple-container" style="display:none" data-zona="signo"></div>';
      container.innerHTML = html;
      container.querySelectorAll('.modalidad-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.modalidad-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          tripleModalidad = btn.dataset.modalidad;
          tripleModalidadLabel = btn.textContent;
          document.getElementById('qt-numero').value = '';
          renderSignosForModalidad();
          renderLegend();
          updateColumnMode();
        });
      });
    }

    // sorteo_hora del POST por línea (REQ-TF-01, A4): `<hoy> HH:MM:00` sin salto
    // de día (D3). El cliente solo permite horarios futuros del día (filtro A4)
    // y bloquea los que expiran; el backend D3 (PR4) es la autoridad final.
    function formatDateWithHorario(hora) {
      const partes = hora.split(':');
      const d = new Date();
      d.setHours(parseInt(partes[0]), parseInt(partes[1] || '0'), 0, 0);
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      return y + '-' + m + '-' + day + ' ' + hh + ':' + mm + ':00';
    }

    function getTotalBs(line) {
      const monto = Number(line.monto) || 0;
      return line.moneda === 'usd' ? monto * tasaActiva : monto;
    }

    function getTicketTotal() {
      return ticketLines.reduce((sum, line) => sum + getTotalBs(line), 0);
    }

    function saveToLocalStorage() {
      const totalBs = getTicketTotal();
      localStorage.setItem('currentTicket', JSON.stringify({
        jugadas: ticketLines.length,
        totalBs: totalBs
      }));
      loadTicket();
    }

    function renderResumen() {
      const container = document.getElementById('resumen-content');
      const totalEl = document.getElementById('qt-total-amount');
      const printBtn = document.getElementById('qt-print');
      const clearBtn = document.getElementById('qt-clear');
      const hasLines = ticketLines.length > 0;

      if (!hasLines) {
        container.innerHTML = '<div class="empty-state">Sin jugadas aún</div>';
        totalEl.textContent = 'Bs. 0,00';
        printBtn.disabled = true;
        clearBtn.disabled = true;
        saveToLocalStorage();
        return;
      }

      // Resumen agrupado por jugada (REQ-MH-03, TF-04, A3): una fila por groupId
      // ("Perro → 14:00, 17:00") con monto ×N; el POST sigue enviando N líneas.
      const grupos = agruparPorGroupId(ticketLines);
      let html = `<table class="resumen-table">
        <thead><tr>
          <th>Sorteo</th><th>Animal / N°</th><th>Monto</th><th></th>
        </tr></thead><tbody>`;
      grupos.forEach(grupo => {
        const primera = grupo.lines[0];
        const montoClass = primera.moneda === 'bs' ? 'monto-bs' : 'monto-usd';
        const horariosStr = grupo.lines.map(l => l.horario).join(', ');
        const sorteoDisplay = (primera.juegoName || '-') + ' &rarr; ' + horariosStr;
        const animalDisplay = primera.juegoType === 'tripletas'
          ? ((primera.tripleModalidadLabel || primera.modalidadLabel)
              ? (primera.tripleModalidadLabel || primera.modalidadLabel) + ' ' + (primera.numero || '-') + (primera.animal ? ' - ' + primera.animal : '')
              : (primera.numero ?? '-'))
          : (primera.animal ? primera.animal + ' ' + (primera.numero || '-') : (primera.numero ?? '-'));
        const montoGrupo = Number(primera.monto) * grupo.lines.length;
        const montoStr = primera.moneda === 'bs'
          ? `Bs. ${montoGrupo.toLocaleString('es-VE', { minimumFractionDigits: 2 })}`
          : `$ ${montoGrupo.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        // tabindex="-1" + data-grupo (Backspace, KB-07; era F6): la fila es el
        // ítem de la zona Resumen (↑/↓ la enfocan vía moverFila) y Backspace la
        // elimina por el mismo groupId del ✕ (removeGroup).
        html += `<tr tabindex="-1" data-grupo="${grupo.groupId}">
          <td>${sorteoDisplay}</td>
          <td>${animalDisplay}</td>
          <td class="${montoClass}">${montoStr}</td>
          <td><button class="btn-rm" data-grupo="${grupo.groupId}" title="Eliminar grupo" aria-label="Eliminar grupo">${icono('x')}</button></td>
        </tr>`;
      });
      html += '</tbody></table>';
      container.innerHTML = html;

      totalEl.textContent = `Bs. ${getTicketTotal().toLocaleString('es-VE', { minimumFractionDigits: 2 })}`;
      printBtn.disabled = false;
      clearBtn.disabled = false;
      saveToLocalStorage();
    }

    function addLine() {
      let numero = document.getElementById('qt-numero').value.trim();
      const monto = document.getElementById('qt-monto').value.trim();
      const moneda = document.getElementById('qt-moneda').value;

      const juego = juegoActivo();
      if (!juego) { window.showModal({ message: 'Seleccione al menos un juego', type: 'error' }); return; }
      if (!monto || Number(monto) <= 0) { window.showModal({ message: 'Ingrese un monto válido', type: 'error' }); return; }
      if (!selectedHorarios.length) { window.showModal({ message: 'Por favor, seleccione al menos un horario', type: 'error' }); return; }

      // Bloqueo por expiración (REQ-MH-04, A4): si algún horario seleccionado
      // ya pasó no se añade nada; se avisa y queda desmarcable (sin auto-salto).
      const expirados = seleccionadosExpirados(selectedHorarios);
      if (expirados.length > 0) {
        window.showModal({ message: 'El horario ' + expirados.join(', ') + ' ya pasó. Desmárquelo y seleccione un horario futuro.', type: 'error' });
        renderHorariosGrid();
        return;
      }

      const familia = juego.familia;
      // S5 (D2): modalidad single-draw — el payload `combinacion` lo arma el
      // módulo puro (construirCombinacion): valida dígitos por modalidad
      // (1..N → padStart) y exige el signo; null = línea inválida (sin POST).
      // S6: la multi-selección same-draw (cruzado/Par A+B) arma
      // `{modalidad, selecciones[]}` con construirCombinacionMulti y la
      // tripleta con construirTripleta (contrato §2.2).
      let combinacionPayload = null;
      let numeroB = null;
      if (modalidadNueva && modalidadNueva.selecciones) {
        numeroB = document.getElementById('qt-numero-b').value.trim();
        combinacionPayload = construirCombinacionMulti(modalidadNueva, { numero, numeroB });
        if (!combinacionPayload) {
          const cifras = modalidadNueva.selecciones[0].digitos;
          window.showModal({ message: 'Ingrese ambas selecciones de ' + modalidadNueva.label + ' (' + cifras + ' cifras cada una)', type: 'error' });
          return;
        }
      } else if (modalidadNueva) {
        combinacionPayload = construirCombinacion(modalidadNueva, {
          numero,
          signo: modalidadNueva.requiereSigno ? (selectedSigno ? selectedSigno.value : null) : undefined,
        });
        if (!combinacionPayload) {
          const msg = modalidadNueva.digitos === 0
            ? 'Seleccione un signo (obligatorio para esta modalidad)'
            : 'Ingrese un número de 1 a ' + modalidadNueva.digitos + ' cifras' +
              (modalidadNueva.requiereSigno ? ' y seleccione el signo' : '');
          window.showModal({ message: msg, type: 'error' });
          return;
        }
      } else if (familia === 'zodiacal') {
        if (!tripleModalidad) { window.showModal({ message: 'Seleccione una modalidad (Triple A/B/C)', type: 'error' }); return; }
        if (tripleModalidad === 'triple_c' && !selectedSigno) { window.showModal({ message: 'Seleccione un signo (obligatorio para Triple C)', type: 'error' }); return; }
        if (!numero || numero.length !== 3) { window.showModal({ message: 'Ingrese un número de exactamente 3 cifras', type: 'error' }); return; }
      } else if (familia === 'numerica') {
        // win-fixes2 FIX D: trio-activo/triple-facil ofrecen 00-99 pero el
        // plugin Tripletas exige 3 dígitos (^\d{3}$). La selección de 1-3
        // cifras se normaliza a 3 ("05"→"005") al armar la línea/POST.
        if (!numero || !/^\d{1,3}$/.test(numero)) { window.showModal({ message: 'Ingrese un número de 1 a 3 cifras', type: 'error' }); return; }
        numero = normalizarNumeroTriple(numero);
      } else if (familia === 'terminal') {
        if (!numero || numero.length !== 2) { window.showModal({ message: 'Ingrese un número de exactamente 2 cifras', type: 'error' }); return; }
      } else {
        // S6: en modo tripleta el payload lo arma el módulo puro con los
        // animales elegidos (tope 3); en base exige el animal simple.
        if (modalidadAnimalitos === 'tripleta') {
          combinacionPayload = construirTripleta(seleccionesAnimales);
          if (!combinacionPayload) {
            window.showModal({ message: 'Seleccione exactamente 3 animales para la tripleta', type: 'error' });
            return;
          }
        } else {
          if (!selectedAnimal) { window.showModal({ message: 'Seleccione un animal', type: 'error' }); return; }
          numero = String(selectedAnimal.numero).padStart(2, '0');
        }
      }

      // Expansión multi-horario (REQ-MH-02, REQ-TF-01, D2): N horarios ⇒ N líneas,
      // cada una con el monto completo y el groupId del grupo (A3). El
      // resumen agrupa por groupId; los duplicados generan grupo nuevo.
      const groupId = nuevoGroupId();
      selectedGames.forEach(game => {
        const animal = familia === 'zodiacal'
          ? (selectedSigno ? selectedSigno.label : null)
          : (selectedAnimal ? selectedAnimal.label : null);
        const baseLinea = {
          juegoId: game.id,
          juegoName: game.nombre,
          juegoType: game.tipo,
          numero: numero,
          animal: animal,
          // S5: payload single-draw ya armado (construirCombinacion); el POST
          // lo manda tal cual (handlePrint) — sin re-derivar el shape aquí.
          combinacion: combinacionPayload,
          modalidadLabel: modalidadNueva
            ? modalidadNueva.label
            : (modalidadAnimalitos === 'tripleta' ? 'Tripleta' : null),
          // win-fixes2 FIX E: sigla (value, "SAG") para el POST; el label
          // ("Sagitario") es solo visual. Tripletas.php:44-47 valida
          // strtoupper($signo) ∈ siglas (ARI..PIS) — el label rompía el POST (hoy F4).
          signoSigla: familia === 'zodiacal' ? (selectedSigno ? selectedSigno.value : null) : null,
          monto: Number(monto),
          moneda: moneda,
          tripleModalidad: familia === 'zodiacal' && !modalidadNueva ? tripleModalidad : null,
          tripleModalidadLabel: familia === 'zodiacal' && !modalidadNueva ? tripleModalidadLabel : null,
        };
        ticketLines.push(...expandirLineas(baseLinea, [...selectedHorarios], groupId));
      });

      document.getElementById('qt-numero').value = '';
      document.getElementById('qt-monto').value = '';
      // Pedido del usuario 2026-09-22: un add exitoso resetea Juegos + Selección
      // completos (no solo la familia) para liberar el guard de pestañas; el
      // ticket y la pestaña activa no se tocan.
      resetSeleccionJuegos();
      renderResumen();
    }

    function clearTicket() {
      // win-fixes2 FIX C (desviación de A11): F11 / 🗑️ «Limpiar todo» vacía el
      // ticket Y TODA la selección en curso — juego, animal, signo, opción,
      // modalidad, horarios y buffers de dígitos — y vuelve las zonas a Juegos
      // con foco inicial. A11 mantenía el juego activo y exigía líneas; el
      // reset total deja el guard de pestañas (seleccionEnCurso) satisfecho de
      // forma natural al limpiar. Sin líneas también limpia la selección.
      ticketLines = [];
      selectedGames = [];
      selectedAnimal = null;
      selectedSigno = null;
      selectedOpcion = null;
      tripleModalidad = null;
      tripleModalidadLabel = null;
      modalidadNueva = null;
      modalidadAnimalitos = null;
      seleccionesAnimales = [];
      selectedHorarios = [];
      horariosCache = [];
      buscadorDigitos = null;
      buscadorSignos = null;
      document.getElementById('qt-numero').value = '';
      document.getElementById('qt-monto').value = '';
      renderJuegos();
      renderSeleccion();
      renderLegend();
      switchToJuegos();
      document.getElementById('juegos-col-title').textContent = 'Juegos';
      saveToLocalStorage();
      renderResumen();
      requestAnimationFrame(() => enfocarZona('juegos'));
    }

    // El ✕ de la fila agrupada borra el grupo completo (A3): todas las líneas
    // del groupId, no una línea suelta (criterio que F3 «Eliminar última» reutiliza).
    function removeGroup(groupId) {
      ticketLines = ticketLines.filter(l => l.groupId !== groupId);
      if (ticketLines.length === 0) {
        selectedAnimal = null;
        selectedSigno = null;
        selectedOpcion = null;
        tripleModalidad = null;
        tripleModalidadLabel = null;
        modalidadNueva = null;
        modalidadAnimalitos = null;
        seleccionesAnimales = [];
        selectedHorarios = [];
        document.getElementById('qt-numero').value = '';
        sincronizarNumeroB();
        if (juegoActivo()) {
          renderSeleccion();
        } else {
          document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
        }
        switchToJuegos();
      }
      renderResumen();
    }

    async function handlePrint() {
      if (ticketLines.length === 0) return;
      saleInFlight = true;
      const printBtn = document.getElementById('qt-print');
      printBtn.disabled = true;
      try {
        const lines = ticketLines.map(line => ({
          juego_id: line.juegoId,
          // S5: si la línea lleva el payload single-draw ya armado
          // (construirCombinacion en addLine), se manda tal cual; si no, se
          // deriva el shape legacy (triple/terminal/animal).
          combinacion: line.combinacion
            ? line.combinacion
            : (line.tripleModalidad
              // win-fixes2 FIX E: el signo viaja SIEMPRE como sigla (value),
              // nunca el label — cubre todos los zodiacales (incl. el-arrejuntado).
              ? { tipo: line.tripleModalidad, numero: line.numero, signo: line.signoSigla ?? null }
              : (line.juegoType === 'terminales'
                ? { numero: line.numero }
                : { animal: line.animal || line.numero, numero: line.numero })),
          amount_bs: line.moneda === 'bs' ? line.monto : 0,
          amount_usd: line.moneda === 'usd' ? line.monto : 0,
          sorteo_hora: line.horario ? formatDateWithHorario(line.horario) : new Date().toISOString(),
        }));

        const result = await apiFetch('/tickets', { method: 'POST', body: { lines } });

        // Ticket impreso (2026-09): cada línea lleva su juego y el texto de la
        // jugada ya compuesto (modalidad en tripletas, solo número en
        // terminales); el encabezado lista TODOS los juegos del ticket y no la
        // selección actual del dashboard.
        const ticketLinesData = ticketLines.map(l => {
          const esTripleta = l.juegoType === 'tripletas';
          return {
            game: l.juegoName,
            jugada: formatearJugada({
              tipo: l.juegoType,
              animal: esTripleta ? null : l.animal,
              // S5: el número impreso es el normalizado del payload single-draw
              // ("05" en vez del "5" tecleado); la modalidad nueva tiene label propio.
              numero: l.combinacion?.numero ?? l.numero,
              modalidad: esTripleta ? (l.tripleModalidadLabel || l.modalidadLabel) : null,
              signo: esTripleta ? (l.animal || l.signoSigla) : null,
            }),
            sorteo: l.horario,
            amountBs: l.moneda === 'bs' ? l.monto : 0,
            amountUsd: l.moneda === 'usd' ? l.monto : 0,
          };
        });
        const ticketData = {
          ticketCode: result.data.ticket_code,
          date: new Date().toLocaleDateString('es-VE'),
          time: new Date().toLocaleTimeString('es-VE'),
          game: nombresJuegos(ticketLinesData).join(', '),
          lines: ticketLinesData,
        };
        // Snapshot para F9 reimprimir (atajos-2026-09; era F12. A6,
        // REQ-TF-03): tras POST ok se guarda el último ticket impreso; si la
        // impresora falla, F9 reimprime sin depender de red (rechazado
        // GET /tickets/{id}).
        localStorage.setItem('ultimoTicket', JSON.stringify(ticketData));
        if (window.electron?.printTicket) {
          await window.electron.printTicket({ ticketData });
        } else {
          await window.showModal({ message: 'Ticket ' + result.data.ticket_code + ' creado exitosamente. Impresión no disponible.', type: 'success' });
        }
        ticketLines = [];
        renderResumen();
        localStorage.removeItem('currentTicket');
        loadTicket();
      } catch (e) {
        await window.showModal({ message: 'Error: ' + e.message, type: 'error' });
      } finally {
        printBtn.disabled = false;
        saleInFlight = false;
      }
    }

    // ─── Modal de vuelto F12 (atajos-2026-09; A12, REQ-KB-07) ───────────────
    // Renderer-only: reutiliza tasaActiva (sin fetch nuevo) para que el
    // cálculo cuadre con getTotalBs/getTicketTotal y la tarjeta de tasa. Con
    // 0 líneas pendientes abre igual (total 0,00 editable): F12 nunca se
    // bloquea por estado. La guarda estricta (A12) vive en routeKey + el glue.

    // ¿El overlay está realmente visible? Los modales propios son estáticos
    // (display:none cerrados, .abierto abiertos), a diferencia de los
    // .modal-overlay dinámicos de showModal (siempre visibles en el DOM).
    function overlayVisible(el) {
      return el !== null && getComputedStyle(el).display !== 'none';
    }

    function restaurarFoco() {
      requestAnimationFrame(() => enfocarZona(zonaActual));
    }

    function abrirVueltoModal() {
      const overlay = document.getElementById('vuelto-overlay');
      if (!overlay) return;
      document.getElementById('vuelto-total').value = getTicketTotal().toFixed(2);
      document.getElementById('vuelto-recibido').value = '';
      // Sin tasa activa: se deshabilita el selector $ (solo Bs, A12).
      document.getElementById('vuelto-moneda').disabled = !tasaDisponible;
      document.getElementById('vuelto-moneda').value = 'bs';
      overlay.classList.add('abierto');
      calcularVueltoModal();
      document.getElementById('vuelto-recibido').focus();
    }

    function cerrarVueltoModal() {
      document.getElementById('vuelto-overlay')?.classList.remove('abierto');
      restaurarFoco();
    }

    function toggleVueltoModal() {
      const overlay = document.getElementById('vuelto-overlay');
      if (!overlay) return;
      if (overlay.classList.contains('abierto')) {
        cerrarVueltoModal();
      } else {
        abrirVueltoModal();
      }
    }

    // Cálculo en vivo del vuelto (A12): total editable, recibido con selector
    // Bs/$; salida es-VE 2 decimales; negativo = «Falta» en rojo.
    function calcularVueltoModal() {
      const el = document.getElementById('vuelto-resultado');
      if (!el) return;
      const total = parseFloat(document.getElementById('vuelto-total').value) || 0;
      const recibidoRaw = document.getElementById('vuelto-recibido').value;
      if (recibidoRaw === '') {
        el.className = 'vuelto-resultado';
        el.textContent = 'Ingrese el monto recibido para calcular el vuelto.';
        return;
      }
      const recibido = parseFloat(recibidoRaw) || 0;
      const moneda = document.getElementById('vuelto-moneda').value;
      const res = calcularVuelto({ totalBs: total, recibido, moneda, tasa: tasaDisponible ? tasaActiva : null });
      const fmt = (n) => n.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (!res.ok) {
        el.className = 'vuelto-resultado vuelto-error';
        el.textContent = 'Tasa no disponible. Verifique la conexión para calcular en $, o use Bs.';
        return;
      }
      const equivUsd = res.vueltoUsd !== null ? ' ($ ' + fmt(Math.abs(res.vueltoUsd)) + ')' : '';
      if (res.negativo) {
        el.className = 'vuelto-resultado vuelto-falta';
        el.innerHTML = 'Falta: <strong>Bs. ' + fmt(Math.abs(res.vueltoBs)) + '</strong>' + equivUsd;
      } else {
        el.className = 'vuelto-resultado vuelto-ok';
        el.innerHTML = 'Vuelto: <strong>Bs. ' + fmt(res.vueltoBs) + '</strong>' + equivUsd;
      }
    }

    // ─── Modal de anulación F10 (atajos-2026-09) ────────────────────────────
    // Identifica SIEMPRE el último ticket pendiente por backend (GET
    // /tickets?estado=pendiente; el snapshot localStorage.ultimoTicket puede
    // estar desactualizado) y exige teclear su serial (anti-tecleo) antes del
    // DELETE /tickets/{id}. El backend valida estado pendiente, ventana de
    // eliminación de la taquilla y sorteo no pasado (422 con mensaje propio).
    // Guarda estricta A12: con este modal abierto ninguna F-key abre otro;
    // Esc/Cancelar/click lo cierran.
    let anularTicket = null; // último pendiente mostrado en el modal
    let anularAbriendo = false; // evita dobles aperturas mientras llega el GET
    let anularEnviando = false; // evita doble DELETE al re-confirmar

    function mostrarErrorAnular(mensaje) {
      const el = document.getElementById('anular-error');
      if (!el) return;
      el.textContent = mensaje;
      el.classList.add('visible');
    }

    async function abrirAnularModal() {
      if (anularAbriendo) return;
      anularAbriendo = true;
      try {
        // El backend filtra por taquilla (rol taquilla) y ordena latest()
        // (created_at DESC); ultimoTicketPendiente re-filtra pendientes y
        // desempata por id (helper puro en keyboard.ts).
        const res = await apiFetch('/tickets?estado=pendiente&per_page=10');
        const ultimo = ultimoTicketPendiente(res?.data?.data ?? []);
        if (!ultimo) {
          await window.showModal({ message: 'No hay tickets pendientes para anular', type: 'info' });
          return;
        }
        anularTicket = ultimo;
        const overlay = document.getElementById('anular-overlay');
        const input = document.getElementById('anular-serial');
        const err = document.getElementById('anular-error');
        if (!overlay || !input) return;
        input.value = '';
        if (err) { err.textContent = ''; err.classList.remove('visible'); }
        overlay.classList.add('abierto');
        input.focus();
      } catch (e) {
        await window.showModal({
          message: 'No se pudo obtener el último ticket pendiente: ' + (e instanceof Error ? e.message : String(e)),
          type: 'error',
        });
      } finally {
        anularAbriendo = false;
      }
    }

    function cerrarAnularModal() {
      document.getElementById('anular-overlay')?.classList.remove('abierto');
      anularTicket = null;
      restaurarFoco();
    }

    async function confirmarAnularTicket() {
      if (anularEnviando || !anularTicket) return;
      const input = document.getElementById('anular-serial');
      if (!input) return;
      // Verificación anti-tecleo: sin serial correcto NO se llama al backend.
      if (!serialCoincide(input.value, anularTicket.ticket_code)) {
        mostrarErrorAnular('El serial no coincide con el último ticket');
        input.focus();
        return;
      }
      const codigo = anularTicket.ticket_code;
      const id = String(anularTicket.id);
      const btn = document.getElementById('anular-confirmar');
      anularEnviando = true;
      if (btn) btn.disabled = true;
      try {
        await apiFetch('/tickets/' + encodeURIComponent(id), { method: 'DELETE' });
        cerrarAnularModal();
        // Snapshot F12: solo se limpia si corresponde al ticket anulado (el
        // último impreso puede ser otro).
        const raw = localStorage.getItem('ultimoTicket');
        if (raw) {
          try {
            const snap = JSON.parse(raw);
            if (snap && serialCoincide(String(snap.ticketCode ?? ''), codigo)) {
              localStorage.removeItem('ultimoTicket');
            }
          } catch { /* snapshot corrupto: no es el ticket anulado */ }
        }
        await window.showModal({ message: 'Ticket anulado correctamente', type: 'success' });
      } catch (e) {
        // 422 (ventana excedida / sorteo pasado / no pendiente) u otro error:
        // mensaje del backend tal cual, inline para corregir y reintentar.
        mostrarErrorAnular(e instanceof Error && e.message ? e.message : 'No se pudo anular el ticket.');
      } finally {
        anularEnviando = false;
        if (btn) btn.disabled = false;
      }
    }

    // ─── Modal de ayuda Alt+H (atajos-2026-09; REQ-KB-07/08, A12) ───────────
    // Contenido dinámico (grafo de zonas + mapa del KEYMAP) al abrir; se cierra
    // con su toggle (Alt+H), Esc, botón Cerrar o click en el overlay.

    function renderAyudaContenido() {
      const el = document.getElementById('help-content');
      if (!el) return;
      const grafo = grafoActual();
      const zonasHtml = grafo.zonas
        .map((z) => '<span class="kbd">' + (NOMBRE_ZONA[z] ?? z) + '</span>')
        .join('<span class="leg-arrow"> &rarr; </span>');
      const fkeysHtml = teclasLegend()
        .map(t => '<li><span class="kbd">' + t.tecla + '</span> ' + t.nombre + '</li>')
        .join('');
      el.innerHTML =
        '<p class="help-zonas"><strong>Zonas (Tab / Shift+Tab):</strong> ' + zonasHtml + '</p>' +
        '<p class="help-zonas"><strong>&larr;/&rarr; en Juegos:</strong> columnas; en el borde, pestañas.</p>' +
        '<p class="help-zonas"><strong>Teclas:</strong></p><ul class="help-fkeys">' + fkeysHtml + '</ul>';
    }

    function cerrarAyudaModal() {
      document.getElementById('help-overlay')?.classList.remove('abierto');
      restaurarFoco();
    }

    function toggleAyudaModal() {
      const overlay = document.getElementById('help-overlay');
      if (!overlay) return;
      if (overlay.classList.contains('abierto')) {
        cerrarAyudaModal();
      } else {
        renderAyudaContenido();
        overlay.classList.add('abierto');
      }
    }

    // ─── Acciones F1/F3/F4/F9/F12 (atajos-2026-09; A11, REQ-KB-07) ──────────
    // F3 anula la jugada (grupo) del último groupId añadido; F1 la duplica
    // con groupId nuevo (atómico: si algún horario expiró, avisa y no copia);
    // F9 reimprime el snapshot; F12 abre el modal de vuelto.

    function anularUltimaJugada() {
      const ultima = ticketLines[ticketLines.length - 1];
      if (!ultima) return;
      // Mismo criterio que el ✕ de la fila agrupada (A3): borra el grupo
      // completo del último groupId, no una línea suelta.
      removeGroup(ultima.groupId);
    }

    function repetirUltimaJugada() {
      const ultima = ticketLines[ticketLines.length - 1];
      if (!ultima) return;
      const grupo = ticketLines.filter((l) => l.groupId === ultima.groupId);
      // Atómico (A11): si algún horario de la jugada ya expiró (filtro A4),
      // se avisa y NO se duplica nada (sin copia parcial).
      const expirados = grupo.filter((l) => horarioExpirado(l.horario)).map((l) => l.horario);
      if (expirados.length > 0) {
        window.showModal({
          message: 'El horario ' + expirados.join(', ') + ' ya pasó. No se repitió la jugada.',
          type: 'error',
        });
        return;
      }
      // Duplica la jugada completa (combinación, monto, moneda y horarios
      // originales) con un groupId NUEVO al final, sin depender de la
      // selección actual (A11).
      const nuevoId = nuevoGroupId();
      ticketLines.push(...grupo.map((l) => ({ ...l, groupId: nuevoId })));
      renderResumen();
    }

    // F9 reimprime el último ticket desde el snapshot localStorage.ultimoTicket
    // (atajos-2026-09; era F12. A6, REQ-TF-03): se guarda tras un POST ok en
    // handlePrint; si falta o no es válido, aviso claro (nunca depende de red
    // justo cuando falla la impresora; rechazado GET /tickets/{id}).
    function reimprimirUltimo() {
      const raw = localStorage.getItem('ultimoTicket');
      if (!raw) {
        window.showModal({
          message: 'No hay un ticket previo para reimprimir. Genere un ticket con F4 / Imprimir primero.',
          type: 'info',
        });
        return;
      }
      try {
        const ticketData = JSON.parse(raw);
        if (!ticketData || !Array.isArray(ticketData.lines) || ticketData.lines.length === 0) {
          throw new Error('snapshot inválido');
        }
        if (window.electron?.printTicket) {
          window.electron.printTicket({ ticketData });
        } else {
          window.showModal({
            message: 'Reimpresión no disponible en este entorno.',
            type: 'info',
          });
        }
      } catch (e) {
        localStorage.removeItem('ultimoTicket');
        window.showModal({
          message: 'El ticket previo no es válido. Se eliminó el respaldo.',
          type: 'error',
        });
      }
    }

    // ─── Backspace eliminar ítem (atajos-2026-09; era F6. REQ-KB-07/08, A3) ──
    // Elimina la fila (grupo) SELECCIONADA del resumen por la MISMA ruta del
    // ✕ de la fila agrupada (removeGroup), sin lógica duplicada. Guardas
    // (KB-08): solo con foco en la zona Resumen y sobre una fila de grupo —
    // si no hay fila seleccionada o el resumen está vacío → no-op (sin
    // lanzar). El glue la llama desde la decisión pura `eliminar-item`
    // (routeKey: Backspace fuera de inputs y con fila enfocada; la guarda de
    // modal ya la aplica la regla 1 del router).
    function eliminarItemSeleccionado() {
      if (zonaActual !== 'resumen') return;
      const fila = document.activeElement?.closest?.('.resumen-table tbody tr[data-grupo]');
      if (!fila) return;
      const totalAntes = document.querySelectorAll('#resumen-content .resumen-table tbody tr[data-grupo]').length;
      const indiceEliminado = Array.from(fila.parentElement.children).indexOf(fila);
      removeGroup(fila.dataset.grupo);
      // Selección tras el borrado (KB-07): foco en la fila que ocupó su
      // lugar, en la última restante o en ninguna (removeGroup ya devolvió
      // la columna a Juegos cuando el ticket quedó vacío).
      const filas = document.querySelectorAll('#resumen-content .resumen-table tbody tr[data-grupo]');
      const nuevoIndice = indiceSeleccionTrasEliminar(totalAntes, indiceEliminado);
      const objetivo = nuevoIndice === null ? null : filas[nuevoIndice];
      if (objetivo) {
        objetivo.focus();
        objetivo.scrollIntoView({ block: 'nearest' });
      }
    }

    // ─── Navegación por teclado (KB-01..04, KB-08, KB-09; A1) ──────────────
    // ACCIONES reales del KEYMAP atajos-2026-09 (REQ-KB-07, A11, A12): F1
    // repetir última (atómico), F3 anular último grupo, F4 pagar/generar
    // (= handlePrint), F9 reimprimir snapshot, F10 anular ticket (modal de
    // serial + DELETE), F11 limpiar todo (= clearTicket, reset TOTAL) y F12
    // vuelto. F2 (Números) y la ayuda (Alt+H) se rutean como decisiones puras
    // (`f-key`/`toggle-modal`) desde routeKey; el handler de F2 vive en este
    // mapa. F5/F6/F7/F8
    // (ventas/resultados/ganadores/cuadre) NO viven aquí: la navegación es
    // GLOBAL en MainLayout.astro (evita doble dispatch en las 5 pantallas).
    // Las guardas de estado viven en routeKey (ejecutable=false) y la guarda
    // estricta de modales (A12) en la regla 1 del router: con un modal abierto
    // solo el toggle de su dueño (Alt+H↔ayuda, F12↔vuelto) y Esc actúan.
    const ACCIONES_FKEYS = {
      'repetir-ultima': repetirUltimaJugada,
      'anular-ultima': anularUltimaJugada,
      'pagar-generar': () => { handlePrint(); },
      'reimprimir': reimprimirUltimo,
      'anular-ticket': () => { abrirAnularModal(); },
      'limpiar': clearTicket,
      'vuelto': toggleVueltoModal,
      // F2 (atajos-2026-09): foco al input #qt-numero + zona `numero`; desde
      // ahí Tab→Monto y Enter→Añadir ya operan con el ruteo existente (mismo
      // patrón del viejo F11 «Números» de win-fixes3).
      'ir-numero': () => {
        const input = document.getElementById('qt-numero');
        if (input) input.focus({ preventScroll: true });
        enfocarZona('numero');
      },
    };

    function esEditable(target) {
      const t = target?.tagName;
      return t === 'INPUT' || t === 'SELECT' || t === 'TEXTAREA';
    }

    // Guarda de modal (REQ-KB-08, A12 refined): cualquier .modal-overlay VISIBLE
    // (showModal de MainLayout es dinámico y siempre visible en el DOM; los
    // modales propios Alt+H/F12/F10 son estáticos con display:none cerrados)
    // o el #help-overlay.abierto. La visibilidad evita que un modal propio
    // cerrado (aún en el DOM) bloquee las F-keys.
    function detectarModalAbierto() {
      const genericos = Array.from(document.querySelectorAll('.modal-overlay'));
      if (genericos.some((el) => overlayVisible(el))) return true;
      return document.querySelector('#help-overlay.abierto') !== null;
    }

    // Modal propio abierto para routeKey (A12): 'ayuda' (Alt+H) o 'vuelto'
    // (F12). El modal de anulación F10 no tiene toggle propio (se cierra con
    // Esc/Cancelar): con él abierto, modalPropio queda null y ninguna F-key
    // ejecuta. Con un modal abierto, routeKey solo permite el toggle de su
    // dueño y Esc; ninguna otra F-key abre otro modal.
    function modalPropioActual() {
      if (document.querySelector('#help-overlay.abierto')) return 'ayuda';
      if (document.querySelector('#vuelto-overlay.abierto')) return 'vuelto';
      return null;
    }

    function objetivoZona(zona) {
      return document.querySelector(TARGETS_ZONA[zona]);
    }

    function zonaVisible(zona) {
      const el = objetivoZona(zona);
      if (!el) return false;
      return el.offsetParent !== null || el === document.body;
    }

    // Roving tabindex explícito (KB-01): solo la zona actual es tabulable.
    function sincronizarTabindex(zona) {
      Object.keys(TARGETS_ZONA).forEach(z => {
        const el = objetivoZona(z);
        if (!el) return;
        // numero/monto (y numero_b, S6) conservan tabindex nativo (inputs).
        if (z === 'numero' || z === 'monto' || z === 'numero_b') return;
        el.tabIndex = z === zona ? 0 : -1;
      });
    }

    function enfocarZona(zona) {
      const el = objetivoZona(zona);
      if (!el) return;
      zonaActual = zona;
      sincronizarTabindex(zona);
      // FIX-2 generalizado (win-fixes2 FIX A, KB-01): al entrar en CUALQUIER
      // zona con ítems focalizables (juegos, modalidad, selección, signo,
      // horarios, resumen) el foco cae en el PRIMER ítem, no en el contenedor
      // — así Space/Enter actúan directo (KB-05) y ↑/↓ navegan la lista desde
      // el primer ítem. Horarios conserva su matiz: los ítems expirados
      // (extras al final) no roban el foco inicial. Zonas sin ítems
      // (numero/monto/anadir) caen al contenedor/input como siempre.
      const items = itemsDeZona(zona);
      if (items.length > 0) {
        let objetivo = items[0];
        if (zona === 'horarios') {
          objetivo = items.find((i) => !i.classList.contains('expirado')) ?? items[0];
        }
        objetivo.focus({ preventScroll: true });
        return;
      }
      el.focus({ preventScroll: true });
    }

    // Ciclo Tab/Shift+Tab (KB-01): salta zonas ocultas (p. ej. juegos en modo
    // horarios) y envuelve en el extremo.
    function moverZona(delta) {
      // FIX-3b (KB-01): Tab desde Horarios con selección PENDIENTE vuelve a la
      // zona que falta (seleccion/modalidad/signo) ANTES de numero/monto. Con
      // la selección completa sigue el ciclo normal del grafo.
      if (delta > 0 && zonaActual === 'horarios') {
        const pendiente = zonaPendienteSeleccion({
          familia: juegoActivo()?.familia ?? null,
          tripleModalidad,
          signoElegido: selectedSigno !== null,
          animalElegido: selectedAnimal !== null,
          // S5 (D3): la modalidad single-draw activa puede exigir signo.
          signo: modalidadNueva?.requiereSigno === true,
          // S6 (design §5): la tripleta en curso con <3 animales sigue
          // pendiente en la zona seleccion.
          modalidadAnimalitos,
          seleccionesAnimales: seleccionesAnimales.length,
        });
        if (pendiente && zonaVisible(pendiente)) {
          enfocarZona(pendiente);
          return;
        }
      }
      const grafo = grafoActual();
      const saltos = grafo.zonas.length;
      let zona = zonaActual;
      for (let i = 0; i < saltos; i++) {
        zona = delta > 0 ? grafo.siguiente(zona) : grafo.anterior(zona);
        if (zona === null) break;
        if (zonaVisible(zona)) {
          enfocarZona(zona);
          return;
        }
      }
    }

    // Movimiento lateral ←/→ entre columnas (FIX-3a, KB-03): usa la misma
    // adyacencia pura (zonaHorizontal) que rutea routeKey, con la columna
    // izquierda según columnMode (juegos ↔ seleccion ↔ resumen, horarios ↔
    // seleccion). Sin vecino → no-op (el glue ya consumió la tecla).
    function moverHorizontal(direccion) {
      const destino = zonaHorizontal(zonaActual, direccion, columnMode);
      if (destino && zonaVisible(destino)) enfocarZona(destino);
    }

    function itemsDeZona(zona) {
      const selectores = {
        juegos: '.juego-card',
        modalidad: '.modalidad-btn',
        seleccion: '.animal-check, .opcion-item',
        signo: '.signo-btn',
        horarios: '.horario-item',
        resumen: '.resumen-table tbody tr',
      };
      const el = objetivoZona(zona);
      if (!el) return [];
      const items = Array.from(el.querySelectorAll(selectores[zona] || ''));
      // S3 taquilla-operativa (spec taquilla-navegacion §1): en tripletas
      // zodiacales la zona `seleccion` está INERTE (sin .animal-check ni
      // .opcion-item) y el selector de modalidad vive DENTRO de ella
      // (#modalidad-grid). Fallback: ↑/↓ navegan sus .modalidad-btn para que
      // el foco no se atasque en una zona sin ítems (Triple A/B/C alcanzable).
      if (zona === 'seleccion' && items.length === 0) {
        const modalidadGrid = el.querySelector('#modalidad-grid');
        if (modalidadGrid) return Array.from(modalidadGrid.querySelectorAll('.modalidad-btn'));
      }
      return items;
    }

    // ↑/↓ contextuales (KB-03): recorren la lista activa de la zona enfocada
    // en orden DOM; sin wrap (el wrap es de zonas con Tab). En las grillas de
    // 2 columnas (Juegos y modalidades, incl. el fallback de `seleccion`) el
    // salto es de una fila (±2) y conserva la columna; el resto de zonas ±1.
    // El cálculo de índice vive en el módulo puro utils/gridNav.ts.
    function moverFila(delta) {
      const items = itemsDeZona(zonaActual);
      if (items.length === 0) return;
      const primero = items[0];
      const esGrilla = primero.classList?.contains('juego-card') || primero.classList?.contains('modalidad-btn');
      const paso = esGrilla ? 2 : 1;
      const idx = items.indexOf(document.activeElement);
      const destino = indiceDestinoFila(idx, items.length, delta, paso);
      if (destino === null) return;
      const objetivo = items[destino];
      objetivo.focus();
      objetivo.scrollIntoView({ block: 'nearest' });
    }

    // ←/→ en las grillas de 2 columnas (Juegos y modalidades): primero la
    // celda adyacente de la MISMA fila (columna ±1, sin wrap) — permitido
    // aunque haya selección en curso; en el borde (null) el glue cae al
    // cambio de pestaña (Juegos) o de zona (modalidad/seleccion). Devuelve
    // true si movió el foco.
    function moverColumna(delta) {
      const items = itemsDeZona(zonaActual);
      if (items.length === 0) return false;
      const primero = items[0];
      const esGrilla = primero.classList?.contains('juego-card') || primero.classList?.contains('modalidad-btn');
      if (!esGrilla) return false;
      const idx = items.indexOf(document.activeElement);
      const destino = indiceDestinoColumna(idx, items.length, delta);
      if (destino === null) return false;
      const objetivo = items[destino];
      objetivo.focus();
      objetivo.scrollIntoView({ block: 'nearest' });
      return true;
    }

    // Enter activa el elemento de zona focalizado (tarjeta/opción/fila).
    function activarItemFocalizado() {
      const activo = document.activeElement;
      if (!activo || esEditable(activo)) return;
      const zonaEl = activo.closest?.('[data-zona]');
      if (!zonaEl) return;
      // FIX-2 (KB-01): si el foco está en el CONTENEDOR de una zona (p. ej.
      // #horarios-grid tras el tab), activar su primer ítem focalizable en vez
      // de no hacer nada (el contenedor no tiene click()). El siguiente
      // Enter/Space ya opera sobre el ítem (roving focus en dos pasos).
      if (activo === zonaEl) {
        const items = itemsDeZona(zonaEl.dataset.zona);
        if (items.length > 0) {
          items[0].focus();
          items[0].scrollIntoView({ block: 'nearest' });
          return;
        }
      }
      if (typeof activo.click === 'function') activo.click();
    }

    // ─── Búsqueda por dígito en la zona Selección (FIX-5, REQ-KB-06) ───────
    // Reutiliza el motor puro existente (buscarPorDigito/crearBuscadorDigitos,
    // catalogo.ts): buffer multi-dígito con commit por inactividad (700 ms) o
    // Enter. Animalitos → foco/selección del .animal-check coincidente (el
    // dup numero:0 lista Ballena/Delfín para desambiguar, REQ-CL-03).
    // Numérica/terminal/zodiacal → salto a la zona Número con el dígito
    // precargado (2/3 cifras); el resto se teclea nativo en el input.
    let buscadorDigitos = null;
    // Buffer de dígitos de la zona Signo (win-fixes2 FIX B): acumula 1-2
    // dígitos y al confirmar (inactividad 700 ms / Enter) selecciona el signo
    // zodiacal por posición 1-12 (signoPorPosicion). Mismo motor que el
    // buscador de animales (crearBuscadorDigitos).
    let buscadorSignos = null;

    function aplicarCoincidenciasAnimales(coincidencias) {
      if (coincidencias.length === 0) return;
      const juego = juegoActivo();
      if (!juego || juego.familia !== 'animalitos') return;
      const unica = coincidencias.length === 1 ? coincidencias[0] : null;
      if (unica) {
        selectedAnimal = { numero: unica.numero, label: unica.label };
      }
      renderAnimales();
      const card = document.querySelector('#seleccion-content .animal-check[data-numero="' + coincidencias[0].numero + '"]');
      if (card) {
        card.focus();
        card.scrollIntoView({ block: 'nearest' });
      }
      updateColumnMode();
    }

    // win-fixes2 FIX B: dígitos 1-12 → signo por posición (zodiacal triple_c).
    // El buffer se reinicia tras seleccionar; un índice fuera de 1-12 se
    // descarta (no-op) y el buffer vuelve a cero para el siguiente intento.
    function aplicarSignoPorPosicion(buffer) {
      const juego = juegoActivo();
      if (!juego || juego.familia !== 'zodiacal') return;
      const signo = signoPorPosicion(juego, buffer);
      if (!signo) {
        buscadorSignos?.limpiar();
        return;
      }
      selectedSigno = { value: signo.value, label: signo.label };
      renderSignosForModalidad();
      const btn = document.querySelector('#signos-triple-container .signo-btn[data-value="' + signo.value + '"]');
      if (btn) {
        btn.focus();
        btn.scrollIntoView({ block: 'nearest' });
      }
      buscadorSignos?.limpiar();
      renderLegend();
      updateColumnMode();
    }

    function manejarDigitoEnSeleccion(digito) {
      const juego = juegoActivo();
      if (!juego) return;
      if (juego.familia === 'animalitos') {
        // Buffer persistente por juego: se recrea si cambió el juego activo.
        if (!buscadorDigitos || buscadorDigitos.juegoId !== juego.id) {
          buscadorDigitos = crearBuscadorDigitos(juego, (coincidencias) => aplicarCoincidenciasAnimales(coincidencias));
          buscadorDigitos.juegoId = juego.id;
        }
        buscadorDigitos.teclear(digito);
        return;
      }
      // win-fixes2 FIX B: dígitos 1-12 → signo por posición (zodiacal triple_c).
      // S5: aplica también a las modalidades single-draw con signo obligatorio
      // (signo_terminal, signo_uña, signo_solo) — la zona signo está visible.
      if (juego.familia === 'zodiacal' && (tripleModalidad === 'triple_c' || (modalidadNueva && modalidadNueva.requiereSigno))) {
        if (!buscadorSignos || buscadorSignos.juegoId !== juego.id) {
          buscadorSignos = crearBuscadorDigitos(juego, (_coincidencias, buffer) => aplicarSignoPorPosicion(buffer));
          buscadorSignos.juegoId = juego.id;
        }
        buscadorSignos.teclear(digito);
        return;
      }
      // numérica/terminal/zodiacal (triple_a/b): salta a Número y precarga el
      // dígito (2 cifras numérica/terminal, 3 zodiacal); S5: el tope de
      // dígitos lo fija la modalidad single-draw elegida.
      const input = document.getElementById('qt-numero');
      if (!input) return;
      const maxDigitos = modalidadNueva
        ? modalidadNueva.digitos
        : (juego.familia === 'zodiacal' ? 3 : 2);
      input.value = (input.value + digito).slice(0, maxDigitos);
      // S4 taquilla-operativa (spec taquilla-navegacion §2): foco DIRECTO al
      // input Número, espejo síncrono de F2 — sin re-render en el mismo tick
      // que invalide el foco. zonaActual + focus() explícito + enfocarZona.
      zonaActual = 'numero';
      input.focus({ preventScroll: true });
      enfocarZona('numero');
    }

    // Esc sube un nivel sin descartar selección ni líneas (KB-04, A1).
    function manejarEscape(nivel) {
      if (nivel === 'modal') {
        // Cierra el modal superior: ayuda (Alt+H) → vuelto (F12) → anular
        // (F10) → showModal genérico. La guarda A12 impide que haya más de uno
        // de los propios a la vez; el orden es defensivo.
        const ayuda = document.querySelector('#help-overlay.abierto');
        if (ayuda) {
          ayuda.classList.remove('abierto');
          restaurarFoco();
          return;
        }
        const vuelto = document.querySelector('#vuelto-overlay.abierto');
        if (vuelto) {
          cerrarVueltoModal();
          return;
        }
        const anular = document.querySelector('#anular-overlay.abierto');
        if (anular) {
          cerrarAnularModal();
          return;
        }
        const overlay = Array.from(document.querySelectorAll('.modal-overlay')).find(overlayVisible);
        if (overlay) {
          const btn = overlay.querySelector('.cancel-btn') ?? overlay.querySelector('.ok-btn');
          btn?.click();
        }
        return;
      }
      if (nivel === 'input') {
        document.activeElement?.blur?.();
        return;
      }
      if (nivel === 'juegos') {
        switchToJuegos();
        document.getElementById('juegos-col-title').textContent = 'Juegos';
        requestAnimationFrame(() => enfocarZona('juegos'));
        return;
      }
      // zona-anterior: sin wrap (arriba de Juegos no hay nivel).
      if (zonaActual === 'juegos') return;
      const anterior = grafoActual().anterior(zonaActual);
      if (anterior && zonaVisible(anterior)) enfocarZona(anterior);
    }

    // Leyenda estática (REQ-KB-09): barra de estado con el mapa de zonas
    // (según el grafo del juego activo) y las teclas del KEYMAP atajos-2026-09.
    function renderLegend() {
      const el = document.getElementById('qt-legend');
      if (!el) return;
      const grafo = grafoActual();
      const zonasHtml = grafo.zonas
        .map(z => '<span class="kbd">' + (NOMBRE_ZONA[z] ?? z) + '</span>')
        .join('<span class="leg-arrow"> &rarr; </span>');
      // FIX-6 (REQ-KB-09; atajos-2026-09): KEYMAP (F1–F12) + destinos globales
      // no-F (Alt+D) + combos extra (Alt+H) vía teclasLegend — leyenda y
      // ayuda derivan del mapa real, sin texto hardcodeado.
      const fkeysHtml = teclasLegend()
        .map(t => '<span><span class="kbd">' + t.tecla + '</span> ' + t.nombre + '</span>')
        .join(' · ');
      el.innerHTML =
        '<span class="leg-grupo"><span class="leg-label">Zonas:</span> ' + zonasHtml + '</span>' +
        '<span class="leg-grupo"><span class="leg-label">Teclas:</span> ' + fkeysHtml + '</span>' +
        '<span class="leg-grupo"><span class="leg-label">Horarios:</span> <span class="kbd">Ctrl+A</span>/<span class="kbd">*</span> marcar todos</span>';
    }

    document.addEventListener('DOMContentLoaded', async () => {
      if (typeof window !== 'undefined' && window.electron?.getVersion) {
        try {
          const checkData = await apiFetch('/dispositivo/verificar', {
            method: 'POST',
            body: { device_fingerprint: getFingerprint() },
          });
          if (checkData.status === 'pending') {
            window.location.href = '/activacion';
            return;
          }
        } catch (error) {
          console.error('No se pudo verificar el dispositivo:', error);
          await window.showModal({
            message: 'No se pudo verificar el dispositivo. Verifique su conexión e intente nuevamente.',
            type: 'error',
          });
        }
      }

      initClock();
      localStorage.removeItem('currentTicket');
      loadTicket();
      loadTasa();
      loadJuegos();
      renderJuegosTabs();

      setInterval(loadTicket, 2000);

      // Refresco del filtro de sorteos futuros (REQ-MH-04, A4): cada 15 s se
      // re-renderiza la lista; los seleccionados que expiran pasan a rojo y
      // el aviso #qt-horario-aviso se actualiza.
      setInterval(() => {
        if (columnMode !== 'horarios') return;
        // FIX-2: preserva el foco del roving focus a través del re-render
        // (mismo patrón que marcarTodosHorarios): si el foco estaba en la
        // lista, se restaura por data-hora; si el ítem desapareció (expiró
        // sin estar marcado), el foco vuelve al primer ítem visible o al
        // contenedor — NUNCA se pierde en body. Si el foco estaba en un
        // input (p. ej. Número/Monto), NO se roba.
        const activo = document.activeElement;
        const enLista = activo?.classList?.contains('horario-item') || activo?.id === 'horarios-grid';
        const prevHora = activo?.dataset?.hora;
        renderHorariosGrid();
        if (!enLista) return;
        const contenedor = document.getElementById('horarios-grid');
        if (prevHora) {
          const nuevo = contenedor?.querySelector('.horario-item[data-hora="' + prevHora + '"]');
          if (nuevo) { nuevo.focus({ preventScroll: true }); return; }
        }
        const primero = contenedor?.querySelector('.horario-item:not(.expirado)') ?? contenedor?.querySelector('.horario-item');
        if (primero) primero.focus({ preventScroll: true });
      }, 15000);

      document.getElementById('juegos-list').addEventListener('click', (e) => {
        const card = e.target.closest('.juego-card');
        if (!card) return;
        const id = parseInt(card.dataset.id);
        const juego = getGameById(id);
        if (!juego) return;

        const yaSeleccionado = selectedGames.some(g => g.id === id);
        if (yaSeleccionado) {
          selectedGames = [];
        } else {
          selectedGames = [juego];
        }
        selectedSigno = null;
        selectedAnimal = null;
        selectedOpcion = null;
        tripleModalidad = null;
        tripleModalidadLabel = null;
        modalidadNueva = null;
        modalidadAnimalitos = null;
        seleccionesAnimales = [];
        sincronizarNumeroB();

        renderJuegos();
        if (selectedGames.length > 0) {
          renderSeleccion();
          loadHorariosConfig();
          // FIX-4: los horarios aparecen apenas se elige el juego (sin esperar
          // la selección completa); updateColumnMode ya no rebota a Juegos.
          switchToHorarios();
        } else {
          document.getElementById('seleccion-content').innerHTML = '<div class="seleccion-placeholder">Seleccione un juego</div>';
          horariosCache = [];
          selectedHorarios = [];
          switchToJuegos();
        }
        buscadorDigitos = null; // FIX-5: el buffer de dígitos es por juego
        buscadorSignos = null; // win-fixes2 FIX B: buffer de signos por juego
        renderLegend();
        updateColumnMode();
        if (selectedGames.length > 0) enfocarZona('horarios'); // FIX-2
      });

      document.getElementById('horarios-grid').addEventListener('click', (e) => {
        const item = e.target.closest('.horario-item');
        if (!item) return;
        toggleHorario(item.dataset.hora);
      });
      if (document.getElementById('back-to-juegos')) {
        document.getElementById('back-to-juegos').addEventListener('click', () => {
          switchToJuegos();
          document.getElementById('juegos-col-title').textContent = 'Juegos';
          enfocarZona('juegos');
        });
      }

      document.getElementById('qt-add').addEventListener('click', addLine);

      document.getElementById('resumen-content').addEventListener('click', (e) => {
        const btn = e.target.closest('.btn-rm');
        if (btn) removeGroup(btn.dataset.grupo);
      });

      document.getElementById('qt-clear').addEventListener('click', clearTicket);
      document.getElementById('qt-print').addEventListener('click', handlePrint);

      // Modal de ayuda Alt+H (atajos-2026-09): cierre por botón/overlay.
      const helpOverlay = document.getElementById('help-overlay');
      document.getElementById('help-cerrar').addEventListener('click', cerrarAyudaModal);
      helpOverlay.addEventListener('click', (e) => {
        if (e.target === helpOverlay) cerrarAyudaModal();
      });

      // Modal de vuelto F12 (atajos-2026-09): cálculo en vivo + cierre por
      // botón/overlay.
      const vueltoOverlay = document.getElementById('vuelto-overlay');
      ['vuelto-total', 'vuelto-recibido'].forEach((id) => {
        document.getElementById(id).addEventListener('input', calcularVueltoModal);
      });
      document.getElementById('vuelto-moneda').addEventListener('change', calcularVueltoModal);
      document.getElementById('vuelto-cerrar').addEventListener('click', cerrarVueltoModal);
      vueltoOverlay.addEventListener('click', (e) => {
        if (e.target === vueltoOverlay) cerrarVueltoModal();
      });

      // Modal de anulación F10 (atajos-2026-09): Confirmar/Cancelar/overlay.
      const anularOverlay = document.getElementById('anular-overlay');
      document.getElementById('anular-cerrar').addEventListener('click', cerrarAnularModal);
      document.getElementById('anular-confirmar').addEventListener('click', confirmarAnularTicket);
      anularOverlay.addEventListener('click', (e) => {
        if (e.target === anularOverlay) cerrarAnularModal();
      });

      document.getElementById('qt-numero').addEventListener('input', (e) => {
        if (!selectedGames[0] || selectedGames[0].tipo !== 'animalitos') return;
        if (animalesCache.length === 0) return;
        const val = parseInt(e.target.value);
        if (isNaN(val)) { selectedAnimal = null; renderAnimales(); updateColumnMode(); return; }
        const animal = animalesCache.find(a => a.numero === val);
        if (animal) {
          selectedAnimal = { numero: animal.numero, label: animal.label };
          renderAnimales();
          updateColumnMode();
        }
      });

      let addingLine = false;
      document.addEventListener('keydown', (e) => {
        // Enter solo añade línea desde los inputs del ticket (qt-numero/
        // qt-monto); los inputs de los modales (p. ej. vuelto F12) no deben
        // disparar addLine, y con un modal abierto nada añade (guarda A12).
        if (e.key === 'Enter' && (e.target.id === 'qt-numero' || e.target.id === 'qt-numero-b' || e.target.id === 'qt-monto')) {
          if (detectarModalAbierto()) return;
          e.preventDefault();
          if (addingLine) return;
          addingLine = true;
          addLine();
          setTimeout(() => { addingLine = false; }, 500);
        }
      });

      // ─── Router de teclado (A1): una sola escucha en document ────────────
      renderLegend();
      enfocarZona('juegos'); // KB-01: foco inicial en la zona Juegos

      // focusin sincroniza la zona actual con el elemento enfocado.
      document.addEventListener('focusin', (e) => {
        const zonaEl = e.target.closest?.('[data-zona]');
        if (zonaEl && zonaEl.dataset.zona) {
          zonaActual = zonaEl.dataset.zona;
          sincronizarTabindex(zonaActual);
        }
      });

      document.addEventListener('keydown', (e) => {
        const decision = routeKey({
          tecla: e.key,
          repeat: e.repeat,
          ctrlKey: e.ctrlKey,
          shiftKey: e.shiftKey,
          altKey: e.altKey, // Alt+H = ayuda (atajos-2026-09)
          focoEditable: esEditable(e.target),
          zonaActual,
          modalAbierto: detectarModalAbierto(),
          modalPropio: modalPropioActual(),
          columnMode,
          tieneLineas: ticketLines.length > 0,
          tieneHistorial: ticketLines.length > 0,
          // Backspace → eliminar-item (atajos-2026-09; era F6): misma fila de
          // grupo que valida eliminarItemSeleccionado (la fila con foco).
          itemResumenSeleccionado: Boolean(document.activeElement?.closest?.('.resumen-table tbody tr[data-grupo]')),
          seleccionEnCurso: seleccionEnCurso(), // FIX-3c
        });
        if (!decision.consume) return;
        e.preventDefault();

        switch (decision.tipo) {
          case 'tab-siguiente': moverZona(1); break;
          case 'tab-anterior': moverZona(-1); break;
          case 'pestana-anterior':
            // feat/taquilla-logos-juegos: ← en Juegos primero mueve a la celda
            // adyacente de la fila (permitido con selección en curso); solo si
            // es borde (moverColumna false) cambia de pestaña. FIX-3c: con
            // selección en curso routeKey marca ejecutable=false y se avisa.
            if (moverColumna(-1)) break;
            if (!decision.ejecutable) { mostrarAvisoTab('Finalice la selección actual antes de cambiar de pestaña (F11 Limpiar todo)'); break; }
            activarTab(tabAnterior()); break;
          case 'pestana-siguiente':
            if (moverColumna(1)) break;
            if (!decision.ejecutable) { mostrarAvisoTab('Finalice la selección actual antes de cambiar de pestaña (F11 Limpiar todo)'); break; }
            activarTab(tabSiguiente()); break;
          // fix/taquilla-fixes: en modalidad (y el fallback de seleccion) ←/→
          // mueven primero la celda de la grilla 2 columnas; en el borde caen
          // al cambio de zona (FIX-3a).
          case 'zona-izquierda': if (!moverColumna(-1)) moverHorizontal('izquierda'); break;
          case 'zona-derecha': if (!moverColumna(1)) moverHorizontal('derecha'); break;
          case 'fila-anterior': moverFila(-1); break;
          case 'fila-siguiente': moverFila(1); break;
          case 'marcar-todos': marcarTodosHorarios(); break;
          case 'escape': manejarEscape(decision.nivel); break;
          case 'digito': manejarDigitoEnSeleccion(decision.digito); break; // FIX-5
          case 'eliminar-item': eliminarItemSeleccionado(); break; // Backspace (era F6)
          case 'toggle-modal': {
            // A12: toggle del modal propio (Alt+H↔ayuda, F12↔vuelto).
            // routeKey solo lo emite si no hay modal abierto o si el abierto es
            // el propio; `ejecutable=false` (Alt+H con OTRO modal visible) se
            // consume pero no ejecuta: preserva la guarda A12 sin abrir nada.
            if (decision.ejecutable === false) break;
            if (decision.modal === 'ayuda') toggleAyudaModal();
            if (decision.modal === 'vuelto') toggleVueltoModal();
            break;
          }
          case 'f-key': {
            if (!decision.ejecutable) break; // guarda de estado (KB-08, A11)
            ACCIONES_FKEYS[decision.accion]?.();
            break;
          }
          default: break;
        }
      });

      // Enter/Space activan el elemento de zona focalizado (KB-05: toggle de
      // horarios con Space/Enter; PR2 ya activaba con Enter). Dentro de inputs
      // el Enter existente hace addLine y Space escribe texto (no se intercepta).
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        if (esEditable(e.target)) return;
        // FIX-5 (REQ-KB-06): Enter confirma el buffer de dígitos pendiente en
        // la zona Selección (animalitos) ANTES de activar el ítem focalizado;
        // con el buffer vacío el Enter actúa como siempre. win-fixes2 FIX B:
        // Enter también confirma el buffer de signos (zona Signo, 1-12).
        if (e.key === 'Enter' && zonaActual === 'seleccion' && buscadorDigitos && buscadorDigitos.buffer() !== '') {
          buscadorDigitos.commit();
          return;
        }
        if (e.key === 'Enter' && zonaActual === 'signo' && buscadorSignos && buscadorSignos.buffer() !== '') {
          buscadorSignos.commit();
          return;
        }
        activarItemFocalizado();
        if (e.key === ' ') e.preventDefault(); // Space en ítem: sin scroll de página
      });

      // Aviso obligatorio de actualización (TQ-10, U3): busy = hay líneas de
      // ticket o una venta/impresión en curso (saleInFlight). Con busy solo
      // se puede postergar (con confirmación); sin busy el aviso se mantiene.
      initAutoUpdate({ isBusy: () => ticketLines.length > 0 || saleInFlight });
    });
  </script>
</MainLayout>
