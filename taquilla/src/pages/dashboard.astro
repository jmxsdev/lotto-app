      const raw = localStorage.getItem('currentTicket');
      const ticket = raw ? JSON.parse(raw) : null;
      document.getElementById('jugadas').textContent = ticket?.jugadas ?? 0;
      document.getElementById('total-pagar').textContent = ticket
        ? `Bs. ${Number(ticket.totalBs).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`
        : 'Bs. 0,00';
    }

    async function loadTasa() {
      try {
        const data = await apiFetch('/exchange-rate/active');
        tasaActiva = data.rate;
        tasaDisponible = true;
        document.getElementById('tasa-dolar').textContent = `Bs. ${Number(data.rate).toLocaleString('es-VE', { minimumFractionDigits: 2 })}`;
        const fecha = data.updated_at ? new Date(data.updated_at).toLocaleDateString('es-VE') : 'hoy';
        document.getElementById('tasa-meta').textContent = `Actualizada: ${fecha}`;
        // Si el modal de vuelto está abierto cuando llega la tasa (loadTasa
        // async), se habilita el selector $ y se recalcula (A12).
        const monedaSel = document.getElementById('vuelto-moneda');
        if (monedaSel) monedaSel.disabled = false;
        if (document.querySelector('#vuelto-overlay.abierto')) calcularVueltoModal();
      } catch (e) {
        tasaDisponible = false;
        document.getElementById('tasa-dolar').textContent = '--';
        document.getElementById('tasa-meta').textContent = 'No disponible';
      }
    }

    async function loadJuegos() {
      renderJuegos();
