    // feat/taquilla-logos-juegos: el guard solo aplica al BORDE del grid (el
    // movimiento de columna con ←/→ nunca descarta la selección).
    function seleccionEnCurso() {
      return Boolean(
        selectedAnimal || selectedSigno || selectedOpcion ||
        modalidadNueva || tripleModalidad || tripleModalidadLabel ||
        // S6: la tripleta en curso (modo + animales elegidos) también bloquea
        // el cambio de pestaña (design §5: seleccionesAnimales en el guard).
        modalidadAnimalitos === 'tripleta' || seleccionesAnimales.length > 0 ||
        selectedHorarios.length > 0,
      );
    }

    let avisoTabTimer = null;
    function mostrarAvisoTab(mensaje) {
      const el = document.getElementById('qt-tab-aviso');
      if (!el) return;
      el.textContent = mensaje;
      el.classList.add('visible');
      clearTimeout(avisoTabTimer);
      avisoTabTimer = setTimeout(() => el.classList.remove('visible'), 1800);
    }

