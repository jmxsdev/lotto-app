---
import MainLayout from '../layouts/MainLayout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api';
---

<MainLayout currentPage="historial">
    <div class="historial-page">
        <h2 class="page-title">Historial de Tickets</h2>

        <div class="filters">
            <input
                type="text"
                id="search"
                placeholder="Buscar por código de ticket..."
                class="search-input"
            />
            <div class="filter-buttons">
                <button data-filter="pendiente" class="filter-btn"> Pendientes</button>
                <button data-filter="pagada" class="filter-btn"> Pagadas</button>
                <button data-filter="anulada" class="filter-btn"> Anuladas</button>
                <button id="btn-refresh" class="btn-refresh"> Actualizar</button>
            </div>
        </div>

        <div id="historial-content">
            <div class="loading">Cargando...</div>
        </div>
    </div>

    <style is:global>
        .historial-page { max-width: 1400px; margin: 0 auto; }
        .page-title { font-size: 28px; font-weight: 700; color: #333; margin-bottom: 24px; }
        .filters { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
        .search-input { flex: 1; min-width: 200px; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px; }
        .search-input:focus { border-color: #667eea; outline: none; }
        .filter-buttons { display: flex; gap: 8px; }
        .filter-btn { padding: 8px 16px; border: 2px solid #ddd; background: white; border-radius: 6px; cursor: pointer; transition: all .2s ease; font-weight: 500; }
        .filter-btn:hover { border-color: #667eea; }
        .filter-btn.active { background: #667eea; color: white; border-color: #667eea; }
        .btn-refresh { padding: 8px 16px; background: #28a745; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; }
        .loading { text-align: center; padding: 40px; color: #666; }
        .empty-state { text-align: center; padding: 40px; color: #999; font-style: italic; }
        .error-state { text-align: center; padding: 40px; color: #dc3545; }
        .ticket-card { background: white; border-radius: 10px; margin-bottom: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); overflow: hidden; }
        .ticket-row { display: flex; align-items: center; padding: 14px 16px; cursor: pointer; transition: background .15s; }
        .ticket-row:hover { background: #f8f9fa; }
        .ticket-expand { width: 28px; font-size: 14px; color: #999; flex-shrink: 0; }
        .ticket-expand.expanded { color: #667eea; }
        .ticket-code-col { font-weight: 700; color: #333; min-width: 130px; font-size: 15px; }
        .ticket-date { color: #666; min-width: 90px; font-size: 13px; }
        .ticket-juego { color: #444; flex: 1; font-size: 14px; padding-left: 15px;}
        .ticket-info { min-width: 90px; text-align: center; font-size: 13px; color: #666; }
        .ticket-total { min-width: 130px; text-align: right; font-weight: 600; font-size: 14px; }
        .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; min-width: 85px; text-align: center; }
        .badge-pendiente { background: #fff3cd; color: #856404; }
        .badge-pagada { background: #d4edda; color: #155724; }
        .badge-anulada { background: #f8d7da; color: #721c24; }
        .badge-ganador { background: linear-gradient(135deg, #fff9c4, #fff176); color: #6d4c00; border: 1px solid #ffd54f; font-weight: 700; }
        .badge-perdida { background: #f0f0f0; color: #888; }
        .ticket-actions { display: flex; gap: 6px; margin-left: 8px; }
        .btn-action { padding: 6px 12px; border: 1px solid #ddd; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all .15s; background: white; }
        .btn-action:hover { transform: translateY(-1px); }
        .btn-pay { color: #28a745; border-color: #28a745; }
        .btn-pay:hover { background: #d4edda; }
        .btn-delete { color: #dc3545; border-color: #dc3545; }
        .btn-delete:hover { background: #f8d7da; }
        .btn-print { color: #6c757d; border-color: #6c757d; }
        .btn-print:hover { background: #e9ecef; }
        .btn-action:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
        .confirm-actions { display: flex; align-items: center; gap: 6px; min-width: 0; }
        .confirm-text { color: #dc3545; font-size: 13px; font-weight: 600; white-space: nowrap; }
        .confirm-btn { padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; border: 1px solid; background: white; transition: all .15s; }
        .confirm-yes { color: #dc3545; border-color: #dc3545; }
        .confirm-yes:hover { background: #f8d7da; }
        .confirm-no { color: #666; border-color: #ccc; }
        .confirm-no:hover { background: #e9ecef; }
        .jugadas-container { display: none; border-top: 1px solid #e9ecef; background: #fafbfc; }
        .jugadas-container.open { display: block; }
        .jugadas-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .jugadas-table th { background: #f1f3f5; padding: 8px 16px; text-align: left; font-weight: 600; color: #666; font-size: 12px; border-bottom: 1px solid #dee2e6; }
        .jugadas-table td { padding: 10px 16px; border-bottom: 1px solid #e9ecef; }
        .jugada-badge { display: inline-block; padding: 2px 8px; border-radius: 8px; font-size: 11px; font-weight: 600; }
        .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 20px; flex-wrap: wrap; align-items: center; }
        .page-btn { padding: 8px 14px; border: 1px solid #ddd; background: white; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .page-btn.active { background: #667eea; color: white; border-color: #667eea; }
        .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>

    <script define:vars={{ apiUrl }}>
        const API_BASE = apiUrl;

        const API_MAC = '00:1A:2B:3C:4D:5E';
        let _mac = API_MAC;
        async function initMac() {
          if (typeof window !== 'undefined' && window.electron?.getMac) {
            try {
              const mac = await window.electron.getMac();
              if (mac && mac !== '00:00:00:00:00:00') _mac = mac;
              else _mac = null;
            } catch { _mac = null; }
          }
        }

        async function apiFetch(method, url, body) {
            const token = localStorage.getItem('auth_token');
            const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
            if (token) headers['Authorization'] = 'Bearer ' + token;
            headers['X-Device-MAC'] = _mac;
            headers['X-Device-Fingerprint'] = localStorage.getItem('device_fingerprint') || 'demo-device-001';
            const opts = { method, headers, credentials: 'omit' };
            if (body) opts.body = JSON.stringify(body);
            const res = await fetch(API_BASE + url, opts);
            if (res.status === 401) {
                localStorage.removeItem('auth_token');
                window.location.href = '/login';
                throw new Error('No autorizado');
            }
            if (!res.ok) {
                const text = await res.text();
                throw new Error(text || res.statusText);
            }
            return res.json();
        }

        function getStatusClass(estado) {
            switch(estado) {
                case 'pendiente': return 'badge-pendiente';
                case 'pagada': return 'badge-pagada';
                case 'anulada': return 'badge-anulada';
                case 'ganador': return 'badge-ganador';
                case 'perdida': return 'badge-perdida';
                default: return '';
            }
        }

        function canDeleteTicket(ticket) {
            if (ticket.estado !== 'pendiente') return false;
            const ahora = new Date();
            const created = new Date(ticket.created_at);
            const diffMinutes = (ahora - created) / (1000 * 60);
            if (diffMinutes >= 5) return false;
            const sorteoVencido = (ticket.apuestas || []).some(a => {
                if (!a.sorteo_hora) return false;
                return new Date(a.sorteo_hora) < ahora;
            });
            return !sorteoVencido;
        }

        function getTicketJuegos(ticket) {
            const nombres = ticket.apuestas?.map(a => a.juego?.name).filter(Boolean) || [];
            return [...new Set(nombres)].join(', ') || '-';
        }

        function renderTickets(tickets) {
            const container = document.getElementById('historial-content');
            if (!tickets || tickets.length === 0) {
                container.innerHTML = '<div class="empty-state">No hay tickets registrados</div>';
                return;
            }
            let html = '';
            tickets.forEach(t => {
                const totalBs = Number(t.total_bs || 0);
                const totalUsd = Number(t.total_usd || 0);
                const jugadasCount = t.apuestas?.length || 0;
                const esGanador = t.tiene_ganadores === true;
                const fechaHora = new Date(t.created_at);
                const fechaStr = fechaHora.toLocaleDateString('es-VE', {day:'2-digit',month:'2-digit',year:'numeric'});
                const horaStr = fechaHora.toLocaleTimeString('es-VE', {hour:'2-digit',minute:'2-digit'});
                html += `
                <div class="ticket-card" data-ticket-id="${t.id}">
                    <div class="ticket-row" data-toggle="${t.id}">
                        <span class="ticket-expand">▶</span>
                        <span class="ticket-code-col">🎫 ${t.ticket_code}</span>
                        <span class="ticket-date">${fechaStr} ${horaStr}</span>
                        <span class="ticket-juego">${getTicketJuegos(t)}</span>
                        <span class="ticket-info">${jugadasCount} jug.</span>
                        <span class="ticket-total">Bs. ${totalBs.toLocaleString('es-VE', {minimumFractionDigits:2})} ${totalUsd > 0 ? '/ $'+totalUsd.toFixed(2) : ''}</span>
                        <span class="badge ${getStatusClass(t.estado)}">${t.estado.toUpperCase()}</span>
                        <div class="ticket-actions">
                            ${t.estado === 'pendiente' && esGanador ? `
                                <button class="btn-action btn-pay" data-action="pay" data-id="${t.id}">💰 Pagar</button>
                            ` : ''}
                            ${t.estado === 'pendiente' && canDeleteTicket(t) ? `
                                <button class="btn-action btn-delete" data-action="delete" data-id="${t.id}">❌ Anular</button>
                            ` : ''}
                            <button class="btn-action btn-print" data-action="print" data-id="${t.id}">🖨️ Imprimir</button>
                        </div>
                    </div>
                    <div class="jugadas-container" data-jugadas="${t.id}">
                        <table class="jugadas-table">
                            <thead><tr>
                                <th>Juego</th><th>Sorteo</th><th>Animal / N°</th><th>Monto BS</th><th>Monto USD</th><th>Total Eq.</th><th>Estado</th>
                            </tr></thead>
                            <tbody>${(t.apuestas || []).map(a => {
                                const c = typeof a.combinacion === 'string' ? JSON.parse(a.combinacion) : (a.combinacion || {});
                                let combo = (c.animal || '-').toUpperCase();
                                if (c.numero) combo += ' #' + c.numero;
                                if (c.signo) combo += ' - ' + c.signo;
                                if (c.tipo) combo += ' (' + c.tipo + ')';
                                return `<tr>
                                    <td>${a.juego?.name || '-'}</td>
                                    <td>${a.sorteo_hora ? new Date(a.sorteo_hora).toLocaleTimeString('es-VE', {hour:'2-digit',minute:'2-digit'}) : '-'}</td>
                                    <td>${combo}</td>
                                    <td>Bs. ${Number(a.amount_bs||0).toFixed(2)}</td>
                                    <td>$ ${Number(a.amount_usd||0).toFixed(2)}</td>
                                    <td>Bs. ${Number(a.total_bs_equivalent||0).toFixed(2)}</td>
                                    <td><span class="jugada-badge ${getStatusClass(a.estado)}">${(a.estado||'pendiente').toUpperCase()}</span></td>
                                </tr>`;
                            }).join('')}</tbody>
                        </table>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        }

        function showConfirmDelete(ticket) {
            const card = document.querySelector(`[data-ticket-id="${ticket.id}"]`);
            if (!card) return;
            const actionsDiv = card.querySelector('.ticket-actions');
            if (!actionsDiv) return;
            actionsDiv._originalHtml = actionsDiv.innerHTML;
            actionsDiv.innerHTML = `
                <span class="confirm-text">¿Anular ticket?</span>
                <button class="confirm-btn confirm-yes" data-confirm="yes" data-id="${ticket.id}">✓ Sí</button>
                <button class="confirm-btn confirm-no" data-confirm="no" data-id="${ticket.id}">✗ No</button>
            `;
        }

        function restoreActions(ticketId) {
            const card = document.querySelector(`[data-ticket-id="${ticketId}"]`);
            if (!card) return;
            const actionsDiv = card.querySelector('.ticket-actions');
            if (actionsDiv && actionsDiv._originalHtml) {
                actionsDiv.innerHTML = actionsDiv._originalHtml;
                delete actionsDiv._originalHtml;
            }
        }

        async function deleteTicket(ticket) {
            try {
                await apiFetch('DELETE', '/tickets/' + ticket.id);
                loadTickets();
                await window.showModal({ message: 'Ticket anulado', type: 'success' });
            } catch (e) {
                restoreActions(ticket.id);
                await window.showModal({ message: 'Error al anular: ' + e.message, type: 'error' });
            }
        }

        async function pagarTicket(ticket) {
            const ok = await window.showModal({
                message: 'Registrar pago completo del ticket ' + ticket.ticket_code + ' por Bs. ' + Number(ticket.total_bs||0).toFixed(2) + '?',
                type: 'confirm'
            });
            if (!ok) return;
            let success = true;
            for (const apuesta of (ticket.apuestas || [])) {
                if (apuesta.estado !== 'pendiente') continue;
                try {
                    await apiFetch('POST', '/pagos', {
                        apuesta_id: apuesta.id,
                        amount_bs: Number(apuesta.amount_bs || 0),
                        amount_usd: Number(apuesta.amount_usd || 0),
                        tipo: 'bs'
                    });
                } catch (e) {
                    success = false;
                    await window.showModal({ message: 'Error en jugada #' + apuesta.id + ': ' + e.message, type: 'error' });
                }
            }
            if (success) loadTickets();
            await window.showModal({ message: 'Pago registrado exitosamente!', type: 'success' });
        }

        async function printTicket(ticket) {
            const lines = (ticket.apuestas || []).map(a => {
                const c = typeof a.combinacion === 'string' ? JSON.parse(a.combinacion) : (a.combinacion || {});
                return {
                    animal: c.animal || c.signo || '-',
                    number: c.numero || '-',
                    amountBs: Number(a.amount_bs || 0),
                    amountUsd: Number(a.amount_usd || 0)
                };
            });
            const ticketData = {
                ticketCode: ticket.ticket_code,
                date: new Date(ticket.created_at).toLocaleDateString('es-VE'),
                time: new Date(ticket.created_at).toLocaleTimeString('es-VE'),
                game: getTicketJuegos(ticket),
                lines: lines
            };
            try {
                if (window.electron?.printTicket) {
                    await window.electron.printTicket({ ticketData });
                } else {
                    await window.showModal({ message: 'Impresion no disponible fuera de Electron', type: 'error' });
                }
            } catch (e) {
                await window.showModal({ message: 'Error al imprimir: ' + e.message, type: 'error' });
            }
        }

        function getTicketById(id) {
            return ticketsCache.find(t => t.id == id);
        }

        let filterEstado = '';
        let searchTimeout = null;
        let ticketsCache = [];
        let currentPage = 1;
        let lastPage = 1;

        async function loadTickets(page) {
            document.getElementById('historial-content').innerHTML = '<div class="loading">Cargando...</div>';
            try {
                let url = '/tickets?per_page=25&page=' + (page || 1);
                if (filterEstado) url += '&estado=' + filterEstado;
                const searchVal = document.getElementById('search')?.value?.trim();
                if (searchVal) url += '&ticket_code=' + encodeURIComponent(searchVal);
                const response = await apiFetch('GET', url);
                ticketsCache = response.data?.data || [];
                currentPage = response.data?.current_page || 1;
                lastPage = response.data?.last_page || 1;
                renderTickets(ticketsCache);

                if (lastPage > 1) {
                    const container = document.getElementById('historial-content');
                    let ph = '<div class="pagination">';
                    ph += `<button class="page-btn" data-page="${currentPage - 1}" ${currentPage <= 1 ? 'disabled' : ''}>Anterior</button>`;
                    for (let p = Math.max(1, currentPage - 2); p <= Math.min(lastPage, currentPage + 2); p++) {
                        ph += `<button class="page-btn ${p === currentPage ? 'active' : ''}" data-page="${p}">${p}</button>`;
                    }
                    ph += `<button class="page-btn" data-page="${currentPage + 1}" ${currentPage >= lastPage ? 'disabled' : ''}>Siguiente</button>`;
                    ph += `<span style="padding:8px 12px;color:#666;">Página ${currentPage} de ${lastPage}</span>`;
                    ph += '</div>';
                    container.innerHTML += ph;
                }
            } catch (error) {
                document.getElementById('historial-content').innerHTML = '<div class="error-state">Error: ' + error.message + '</div>';
            }
        }

        function filterByEstado(estado) {
            filterEstado = estado === filterEstado ? '' : estado;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.filter === filterEstado);
            });
            loadTickets();
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await initMac();
            loadTickets();

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => filterByEstado(btn.dataset.filter));
            });

            document.getElementById('btn-refresh').addEventListener('click', () => loadTickets());

            document.getElementById('search').addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => loadTickets(), 300);
            });

            document.getElementById('historial-content').addEventListener('click', (e) => {
                const pageBtn = e.target.closest('.page-btn');
                if (pageBtn && !pageBtn.disabled) {
                    const page = parseInt(pageBtn.dataset.page);
                    if (page >= 1 && page <= lastPage) loadTickets(page);
                    return;
                }

                const confirmBtn = e.target.closest('.confirm-btn');
                if (confirmBtn) {
                    const id = parseInt(confirmBtn.dataset.id);
                    const ticket = getTicketById(id);
                    if (!ticket) return;
                    if (confirmBtn.dataset.confirm === 'yes') {
                        deleteTicket(ticket);
                    } else {
                        restoreActions(id);
                    }
                    return;
                }

                const actionBtn = e.target.closest('.btn-action');
                if (actionBtn) {
                    const id = parseInt(actionBtn.dataset.id);
                    const ticket = getTicketById(id);
                    if (!ticket) return;
                    switch (actionBtn.dataset.action) {
                        case 'pay': pagarTicket(ticket); break;
                        case 'delete': showConfirmDelete(ticket); break;
                        case 'print': printTicket(ticket); break;
                    }
                    return;
                }

                const toggleRow = e.target.closest('.ticket-row');
                if (toggleRow) {
                    const ticketId = toggleRow.dataset.toggle;
                    const jugadasDiv = document.querySelector(`[data-jugadas="${ticketId}"]`);
                    const expandIcon = toggleRow.querySelector('.ticket-expand');
                    if (jugadasDiv) {
                        jugadasDiv.classList.toggle('open');
                        if (expandIcon) {
                            expandIcon.classList.toggle('expanded', jugadasDiv.classList.contains('open'));
                            expandIcon.textContent = jugadasDiv.classList.contains('open') ? '▼' : '▶';
                        }
                    }
                }
            });
        });
    </script>
</MainLayout>
