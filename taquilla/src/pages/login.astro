<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Lotto Taquilla</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-container {
        background: white;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }
      .logo {
        text-align: center;
        margin-bottom: 30px;
      }
      .logo h1 {
        color: #333;
        font-size: 2rem;
        margin-bottom: 8px;
      }
      .logo p {
        color: #666;
        font-size: 14px;
      }
      .form-group {
        margin-bottom: 20px;
      }
      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
        font-size: 14px;
      }
      input {
        width: 100%;
        padding: 12px;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.2s ease;
      }
      input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      }
      button {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }
      .alert {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        display: none;
      }
      .alert.error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        display: block;
      }
      .info-box {
        background: #e7f3ff;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
        font-size: 13px;
        color: #004085;
        line-height: 1.5;
      }
      .spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 8px;
      }
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <div class="logo">
        <h1>🎰 Lotto Taquilla</h1>
        <p>Sistema de Loterías Multi-Moneda</p>
      </div>
      
      <div id="alert" class="alert"></div>
      
      <form id="login-form">
        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            placeholder="taquilla@ejemplo.com" 
            required
            autocomplete="email"
          />
        </div>
        
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            placeholder="••••••••" 
            required
            autocomplete="current-password"
          />
        </div>
        
        <button type="submit" id="btn-submit">
          Iniciar Sesión
        </button>
      </form>
      
      <div class="info-box">
        <strong>ℹ️ Información:</strong><br/>
        Use las credenciales proporcionadas por su administrador para acceder al sistema. La taquilla debe estar activada previamente.
      </div>

      {import.meta.env.DEV && (
        <div id="env-selector" style="margin-top:1rem;font-size:0.85rem;color:#666">
          <label for="env-select" style="margin-right:0.5rem">Entorno API:</label>
          <select id="env-select" style="padding:0.3rem 0.6rem;border-radius:6px;border:1px solid #ddd">
            <option value="local">Local (localhost:8000)</option>
            <option value="prod">Producción (lotto.gzuz.dev)</option>
          </select>
        </div>
      )}
    </div>

    <script>
      import { apiFetch, ApiError } from '../utils/apiFetch';

      // Selector dev-only (tree-shaken en prod)
      if (import.meta.env.DEV) {
        const stored = localStorage.getItem('taquilla_api_upstream_override') || 'local';
        const select = document.getElementById('env-select');
        if (select) select.value = stored;
        if (window.electron?.setApiUpstream) {
          window.electron.setApiUpstream(stored).catch(() => {});
        }
        if (select) {
          select.addEventListener('change', () => {
            const key = select.value;
            localStorage.setItem('taquilla_api_upstream_override', key);
            if (window.electron?.setApiUpstream) {
              window.electron.setApiUpstream(key).catch(() => {});
            }
          });
        }
      }

      function showAlert(message, type) {
        const alertEl = document.getElementById('alert');
        alertEl.textContent = message;
        alertEl.className = `alert ${type}`;
      }

      function resetButton(btn) {
        btn.disabled = false;
        btn.textContent = 'Iniciar Sesión';
      }

      async function handleLogin(e) {
        e.preventDefault();
        
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const btn = document.getElementById('btn-submit');

        if (!email || !password) {
          showAlert('Por favor complete todos los campos.', 'error');
          return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Iniciando sesión...';

        try {
          const data = await apiFetch('/login', {
            method: 'POST',
            body: {
              email: email,
              password: password,
            },
          });

          localStorage.setItem('auth_token', data.token);
          if (data.user) {
            localStorage.setItem('user_data', JSON.stringify(data.user));
          }
          showAlert('¡Inicio de sesión exitoso! Redirigiendo...', 'success');
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1000);
        } catch (error) {
          if (error instanceof ApiError && error.kind === 'rate-limited') {
            showAlert('Demasiados intentos. Espere un momento e intente nuevamente.', 'error');
            resetButton(btn);
          } else if (error instanceof ApiError && error.kind === 'forbidden') {
            const message = error.payload?.message || 'Acceso denegado.';
            const msg = String(message).toLowerCase();
            // Cubre "no ha sido activado" y "Complete la activación" (prod)
            if (msg.includes('activ')) {
              showAlert(message, 'warning');
              setTimeout(() => { window.location.href = '/activacion'; }, 1500);
            } else {
              showAlert(message, 'error');
              resetButton(btn);
            }
          } else if (error instanceof ApiError && error.kind === 'unauthorized') {
            showAlert('Credenciales incorrectas.', 'error');
            resetButton(btn);
          } else if (error instanceof ApiError && error.kind === 'http') {
            showAlert(error.payload?.message || 'Credenciales incorrectas.', 'error');
            resetButton(btn);
          } else {
            showAlert('Error de conexión. Verifique su internet e intente nuevamente.', 'error');
            resetButton(btn);
          }
        }
      }

      document.getElementById('login-form').addEventListener('submit', handleLogin);
    </script>
  </body>
</html>
