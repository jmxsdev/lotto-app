---
import api from '../utils/api';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Lotto Taquilla</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-container {
        background: white;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }
      .logo {
        text-align: center;
        margin-bottom: 30px;
      }
      .logo h1 {
        color: #333;
        font-size: 2rem;
        margin-bottom: 8px;
      }
      .logo p {
        color: #666;
        font-size: 14px;
      }
      .form-group {
        margin-bottom: 20px;
      }
      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
        font-size: 14px;
      }
      input {
        width: 100%;
        padding: 12px;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.2s ease;
      }
      input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      }
      button {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }
      .alert {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        display: none;
      }
      .alert.error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        display: block;
      }
      .info-box {
        background: #e7f3ff;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
        font-size: 13px;
        color: #004085;
        line-height: 1.5;
      }
      .spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 8px;
      }
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <div class="logo">
        <h1>🎰 Lotto Taquilla</h1>
        <p>Sistema de Loterías Multi-Moneda</p>
      </div>
      
      <div id="alert" class="alert"></div>
      
      <form id="login-form">
        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            placeholder="taquilla@ejemplo.com" 
            required
            autocomplete="email"
          />
        </div>
        
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            placeholder="••••••••" 
            required
            autocomplete="current-password"
          />
        </div>
        
        <button type="submit" id="btn-submit">
          Iniciar Sesión
        </button>
      </form>
      
      <div class="info-box">
        <strong>ℹ️ Información:</strong><br/>
        Use las credenciales proporcionadas por su administrador para acceder al sistema. La taquilla debe estar activada previamente.
      </div>
    </div>

    <script define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api', demoMac: import.meta.env.PUBLIC_DEMO_MAC || '' }}>
      const API_BASE = apiUrl;

      function showAlert(message, type) {
        const alertEl = document.getElementById('alert');
        alertEl.textContent = message;
        alertEl.className = `alert ${type}`;
      }

      async function handleLogin(e) {
        e.preventDefault();
        
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const btn = document.getElementById('btn-submit');

        if (!email || !password) {
          showAlert('Por favor complete todos los campos.', 'error');
          return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Iniciando sesión...';

        try {
          // Obtener MAC si está disponible
          let mac = '';
          if (window.electron?.getMac) {
            try {
              mac = await window.electron.getMac();
            } catch (error) {
              console.warn('No se pudo obtener MAC:', error);
            }
          }
          if (!mac && demoMac) {
            mac = demoMac;
          }

          const response = await fetch(API_BASE + '/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Device-MAC': mac || null,
              'X-Device-Fingerprint': localStorage.getItem('device_fingerprint') || 'demo-device-001',
            },
            body: JSON.stringify({
              email: email,
              password: password,
            }),
          });

          if (response.status === 429) {
            showAlert('Demasiados intentos. Espere un momento e intente nuevamente.', 'error');
            btn.disabled = false;
            btn.textContent = 'Iniciar Sesión';
            return;
          }

          if (response.status === 403) {
            const text = await response.text();
            let message = '';
            try { message = JSON.parse(text).message || ''; } catch (_) {}
            showAlert(message || 'Dispositivo no activado. Redirigiendo...', 'warning');
            setTimeout(() => { window.location.href = '/activacion'; }, 1500);
            return;
          }

          if (!response.ok) {
            const text = await response.text();
            let message = 'Credenciales incorrectas.';
            try {
              const errData = JSON.parse(text);
              message = errData.message || message;
            } catch (_) {}
            showAlert(message, 'error');
            btn.disabled = false;
            btn.textContent = 'Iniciar Sesión';
            return;
          }

          const data = await response.json();

          localStorage.setItem('auth_token', data.token);
          if (data.user) {
            localStorage.setItem('user_data', JSON.stringify(data.user));
          }
          showAlert('¡Inicio de sesión exitoso! Redirigiendo...', 'success');
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1000);
        } catch (error) {
          showAlert('Error de conexión. Verifique su internet e intente nuevamente.', 'error');
          btn.disabled = false;
          console.log(error)
          btn.textContent = 'Iniciar Sesión';
        }
      }

      document.getElementById('login-form').addEventListener('submit', handleLogin);
    </script>
  </body>
</html>
