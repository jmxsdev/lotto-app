---
// Splash screen que verifica autenticación y redirige
const appName = import.meta.env.PUBLIC_APP_NAME || 'Lotto Taquilla';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{appName} - Cargando</title>
    <style>
      body {
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d);
        color: white;
      }
      .container {
        text-align: center;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }
      h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 0;
      }
      .spinner {
        border: 5px solid rgba(255, 255, 255, 0.3);
        border-top: 5px solid white;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 2rem auto;
      }
      #splash-retry {
        display: none;
        margin-top: 1rem;
        padding: 0.6rem 1.5rem;
        font-size: 1rem;
        border: none;
        border-radius: 8px;
        background: white;
        color: #1a2a6c;
        cursor: pointer;
      }
      #splash-retry:hover {
        opacity: 0.9;
      }
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      .footer {
        margin-top: 2rem;
        font-size: 0.8rem;
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🎰 {appName}</h1>
      <p class="subtitle">Sistema de Loterías Multi-Moneda</p>
      <div class="spinner"></div>
      <p id="splash-status">Iniciando taquilla...</p>
      <button id="splash-retry" type="button">Reintentar</button>
      <div class="footer">
        <p>Versión: 0.1.0</p>
        <p id="mac-info">MAC: Cargando...</p>
      </div>
      {import.meta.env.DEV && (
        <div id="env-selector" style="margin-top:1rem;font-size:0.85rem;opacity:0.9">
          <label for="env-select" style="margin-right:0.5rem">Entorno API:</label>
          <select id="env-select" style="padding:0.3rem 0.6rem;border-radius:6px;border:none">
            <option value="local">Local (localhost:8000)</option>
            <option value="prod">Producción (lotto.gzuz.dev)</option>
          </select>
        </div>
      )}
    </div>

    <script>
      import { apiFetch } from '../utils/apiFetch';
      import { getFingerprint } from '../utils/device';

      // Selector dev-only: solo existe en desarrollo (tree-shaken en prod).
      // Re-aplica el override persistido antes del verify y lo conmuta via IPC.
      if (import.meta.env.DEV) {
        const stored = localStorage.getItem('taquilla_api_upstream_override') || 'local';
        const select = document.getElementById('env-select');
        if (select) select.value = stored;
        if (window.electron?.setApiUpstream) {
          window.electron.setApiUpstream(stored).catch(() => {});
        }
        if (select) {
          select.addEventListener('change', () => {
            const key = select.value;
            localStorage.setItem('taquilla_api_upstream_override', key);
            if (window.electron?.setApiUpstream) {
              window.electron.setApiUpstream(key).catch(() => {});
            }
          });
        }
      }

      async function init() {
        const fp = getFingerprint();

        if (window.electron?.getMac) {
          try {
            const mac = await window.electron.getMac();
            document.getElementById('mac-info').textContent = 'MAC: ' + (mac || 'No disponible');
          } catch (_) {
            document.getElementById('mac-info').textContent = 'MAC: Error al obtener';
          }
        }

        try {
          const data = await apiFetch('/dispositivo/verificar', {
            method: 'POST',
            timeout: 5000,
            body: { device_fingerprint: fp },
          });
          if (data.status === 'active') {
            window.location.href = '/login';
          } else {
            window.location.href = '/activacion';
          }
        } catch (error) {
          console.error('Error al verificar el dispositivo:', error);
          document.getElementById('splash-status').textContent = 'Error de conexión con el servidor';
          document.querySelector('.spinner').style.display = 'none';
          document.getElementById('splash-retry').style.display = 'inline-block';
        }
      }

      document.getElementById('splash-retry').addEventListener('click', () => {
        document.getElementById('splash-status').textContent = 'Iniciando taquilla...';
        document.querySelector('.spinner').style.display = 'block';
        document.getElementById('splash-retry').style.display = 'none';
        init();
      });

      init();
    </script>
  </body>
</html>
