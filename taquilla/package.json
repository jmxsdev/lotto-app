{
  "name": "lotto-taquilla",
  "version": "1.0.3",
  "description": "Aplicación de escritorio para taquillas de lotería (Electron + Astro)",
  "main": "electron/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run clean:artifacts && npm run build && electron-builder",
    "electron:build:win": "npm run clean:artifacts && npm run build && electron-builder --win",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "astro": "^6.0.5",
    "electron-updater": "^6.3.9",
    "electron-pos-printer": "^1.4.0",
    "lucide-static": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.lotto.taquilla",
    "productName": "Lotto Taquilla",
    "artifactName": "Taquilla-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
