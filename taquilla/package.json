{
  "name": "lotto-taquilla",
  "version": "2.0.0",
  "description": "Aplicación de escritorio para taquillas de lotería (Electron + Astro)",
  "main": "electron/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "electron:dev": "npm run build:printing && node scripts/electron-dev.mjs",
    "electron:build": "npm run clean:artifacts && npm run build:printing && npm run build && electron-builder",
    "electron:build:win": "npm run clean:artifacts && npm run build:printing && npm run build && electron-builder --win --publish never",
    "vercel-build": "npm run build",
    "e2e": "npm run build:printing && pnpm e2e:seed && playwright test -c e2e/playwright.config.mjs",
    "e2e:seed": "cd ../backend && DB_DATABASE=${DB_DATABASE:-lotto_e2e} php artisan db:seed --class=E2eSeeder",
    "test:printing": "npm run build:printing && cd electron/main/printing && node --test",
    "build:printing": "node scripts/build-printing.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "astro": "^6.0.5",
    "electron-pos-printer": "^1.4.0",
    "electron-updater": "^6.3.9",
    "lucide-static": "^1.48.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.lotto.taquilla",
    "productName": "Lotto Taquilla",
    "artifactName": "Taquilla-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://lotto.gzuz.dev/api/v1/releases/feed"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
