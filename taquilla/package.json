{
  "name": "lotto-taquilla",
  "version": "0.1.0",
  "description": "Aplicación de escritorio para taquillas de lotería (Electron + Astro)",
  "main": "electron/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "astro": "^6.0.5",
    "axios": "^1.6.0",
    "electron-pos-printer": "^1.4.0",
    "electron-serve": "^3.0.1",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.lotto.taquilla",
    "productName": "Lotto Taquilla",
    "artifactName": "Taquilla-Setup-${version}.${ext}",
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      } 
    ],
    "directories": {
       "output": "release"
    }
  }
}
