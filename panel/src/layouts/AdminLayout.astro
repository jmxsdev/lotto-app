---
import { getStoredUser } from '../utils/api.ts';

const user = getStoredUser();
const role = user?.role || '';
const name = user?.name || '';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lotto Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #f0f2f5; color: #333; }

    .app-shell { display: flex; min-height: 100vh; }
    .sidebar {
      width: 220px; background: #1e293b; color: #cbd5e1; flex-shrink: 0;
      display: flex; flex-direction: column; padding: 16px 0;
    }
    .sidebar-brand { padding: 12px 20px; font-size: 18px; font-weight: 700; color: #fff; border-bottom: 1px solid #334155; margin-bottom: 8px; }
    .sidebar-nav { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 0 8px; }
    .sidebar-link {
      display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px;
      text-decoration: none; color: #cbd5e1; font-size: 14px; font-weight: 500; transition: all .15s;
    }
    .sidebar-link:hover { background: #334155; color: #fff; }
    .sidebar-link.active { background: #3b82f6; color: #fff; }
    .sidebar-link-icon { font-size: 16px; width: 20px; text-align: center; }
    .sidebar-footer { padding: 12px 20px; border-top: 1px solid #334155; }
    .sidebar-user { font-size: 13px; color: #94a3b8; }
    .sidebar-user strong { display: block; color: #e2e8f0; margin-bottom: 2px; }
    .sidebar-logout { margin-top: 8px; padding: 6px 12px; background: #334155; border: none; color: #cbd5e1; border-radius: 6px; cursor: pointer; font-size: 12px; width: 100%; }
    .sidebar-logout:hover { background: #475569; }
    .main-area { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .topbar {
      background: #fff; padding: 12px 24px; display: flex; align-items: center;
      justify-content: space-between; border-bottom: 1px solid #e2e8f0; flex-shrink: 0;
    }
    .topbar-title { font-size: 16px; font-weight: 600; }
    .topbar-info { display: flex; gap: 16px; align-items: center; font-size: 13px; color: #666; }
    .page-content { flex: 1; padding: 24px; overflow-y: auto; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999; animation: fadeIn .2s ease; }
    .modal-dialog { background: #fff; border-radius: 12px; padding: 28px 24px 20px; max-width: 400px; width: 90%; text-align: center; box-shadow: 0 8px 30px rgba(0,0,0,0.25); animation: slideIn .25s ease; }
    .modal-icon { font-size: 36px; margin-bottom: 10px; }
    .modal-message { font-size: 15px; color: #333; margin-bottom: 22px; line-height: 1.5; word-wrap: break-word; }
    .modal-buttons { display: flex; gap: 8px; justify-content: center; }
    .modal-btn { padding: 10px 22px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all .15s; }
    .modal-btn:hover { filter: brightness(0.9); transform: translateY(-1px); }
    .modal-btn-primary { background: #3b82f6; color: #fff; }
    .modal-btn-danger { background: #dc3545; color: #fff; }
    .modal-btn-secondary { background: #e9ecef; color: #333; }
    .sidebar-dropdown { position: relative; }
    .sidebar-dropdown .dropdown-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 12px; border-radius: 8px; cursor: pointer;
      color: #cbd5e1; font-size: 14px; font-weight: 500; transition: all .15s;
    }
    .sidebar-dropdown .dropdown-header:hover { background: #334155; color: #fff; }
    .sidebar-dropdown .dropdown-header .header-left { display: flex; align-items: center; gap: 10px; }
    .sidebar-dropdown .dropdown-arrow { font-size: 10px; transition: transform .2s; }
    .sidebar-dropdown.open .dropdown-arrow { transform: rotate(180deg); }
    .sidebar-dropdown .dropdown-menu { display: none; padding-left: 28px; }
    .sidebar-dropdown.open .dropdown-menu { display: block; }
    .sidebar-dropdown .dropdown-item {
      display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 6px;
      text-decoration: none; color: #94a3b8; font-size: 13px; transition: all .15s;
    }
    .sidebar-dropdown .dropdown-item:hover { background: #334155; color: #fff; }
    .sidebar-dropdown .dropdown-item.active { background: #1d4ed8; color: #fff; }
    .sidebar-dropdown .dropdown-count { margin-left: auto; font-size: 11px; opacity: 0.7; }
    @keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
    @keyframes slideIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
  </style>
  <slot name="styles" />
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-brand">🎰 Lotto Panel</div>
      <nav class="sidebar-nav" id="sidebar-nav">
      </nav>
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <strong>{name || 'Admin'}</strong>
          {role ? role.replace('_',' ').toUpperCase() : ''}
        </div>
        <button class="sidebar-logout" id="logout-btn">🚪 Cerrar sesión</button>
      </div>
    </aside>
    <main class="main-area">
      <header class="topbar">
        <div class="topbar-title" id="topbar-title">Dashboard</div>
        <div class="topbar-info">
          <span id="topbar-clock">--:--:--</span>
        </div>
      </header>
      <div class="page-content">
        <slot />
      </div>
    </main>
  </div>

  <script>
    const currentPath = window.location.pathname;
    const user = JSON.parse(localStorage.getItem('panel_user') || '{}');
    const role = user.role || '';
    const entityCounts = window.entityCounts || {};

    // Fetch entity counts if not set by dashboard
    async function loadCounts() {
      if (window.entityCounts) return;
      const API_BASE = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000') + '/api/v1';
      const token = localStorage.getItem('panel_token');
      const headers = { 'Accept': 'application/json', 'X-Panel': 'true' };
      if (token) headers['Authorization'] = 'Bearer ' + token;
      try {
        const [b, g, t] = await Promise.all([
          fetch(API_BASE + '/bancas?per_page=1', { headers }).then(r => r.ok ? r.json() : []),
          fetch(API_BASE + '/grupos?per_page=1', { headers }).then(r => r.ok ? r.json() : []),
          fetch(API_BASE + '/taquillas?per_page=1', { headers }).then(r => r.ok ? r.json() : []),
        ]);
        window.entityCounts = {
          bancas: Array.isArray(b) ? b.length : (b?.data?.length || b?.meta?.total || 0),
          grupos: Array.isArray(g) ? g.length : (g?.data?.length || g?.meta?.total || 0),
          taquillas: Array.isArray(t) ? t.length : (t?.data?.length || t?.meta?.total || 0),
        };
        // Update dropdown counts
        document.querySelectorAll('.dropdown-count').forEach(el => {
          const key = el.dataset.entity;
          if (key && window.entityCounts[key] !== undefined) el.textContent = window.entityCounts[key];
        });
      } catch (_) {}
    }
    loadCounts();

    function addLink(label, href, icon) {
      const active = currentPath === href || currentPath.startsWith(href + '/');
      const a = document.createElement('a');
      a.className = 'sidebar-link' + (active ? ' active' : '');
      a.href = href;
      a.innerHTML = `<span class="sidebar-link-icon">${icon}</span> ${label}`;
      return a;
    }

    function addDropdownItem(label, href, icon, count, entityKey) {
      const active = currentPath === href || currentPath.startsWith(href + '/');
      const a = document.createElement('a');
      a.className = 'dropdown-item' + (active ? ' active' : '');
      a.href = href;
      a.innerHTML = `${icon} ${label}<span class="dropdown-count" data-entity="${entityKey}">${count !== undefined && count !== null ? count : '-'}</span>`;
      return a;
    }

    const sidebarNav = document.getElementById('sidebar-nav');

    // Dashboard (always visible)
    sidebarNav.appendChild(addLink('Dashboard', '/dashboard', '📊'));

    // Entidades dropdown — varies by role
    const entidades = [];
    if (role === 'super_master' || role === 'master') entidades.push({ label: 'Bancas', href: '/bancas', icon: '🏦', count: entityCounts.bancas, key: 'bancas' });
    if (role === 'super_master' || role === 'master' || role === 'banca') entidades.push({ label: 'Grupos', href: '/grupos', icon: '📂', count: entityCounts.grupos, key: 'grupos' });
    if (['super_master','master','banca','grupo'].includes(role)) entidades.push({ label: 'Agencias', href: '/taquillas', icon: '🎫', count: entityCounts.taquillas, key: 'taquillas' });

    if (entidades.length > 0) {
      const dropdown = document.createElement('div');
      dropdown.className = 'sidebar-dropdown';
      dropdown.id = 'entity-dropdown';

      const header = document.createElement('div');
      header.className = 'dropdown-header';
      header.innerHTML = `<span class="header-left"><span class="sidebar-link-icon">👥</span> Entidades</span><span class="dropdown-arrow">▼</span>`;

      const menu = document.createElement('div');
      menu.className = 'dropdown-menu';
      menu.id = 'dropdown-menu';

      entidades.forEach(e => menu.appendChild(addDropdownItem(e.label, e.href, e.icon, e.count, e.key)));
      dropdown.appendChild(header);
      dropdown.appendChild(menu);
      sidebarNav.appendChild(dropdown);

      // Hover + click toggle
      let locked = false;
      let isOpen = false;

      function open() { isOpen = true; dropdown.classList.add('open'); }
      function close() { if (!locked) { isOpen = false; dropdown.classList.remove('open'); } }

      dropdown.addEventListener('mouseenter', () => { if (!locked) open(); });
      dropdown.addEventListener('mouseleave', () => { if (!locked) close(); });
      header.addEventListener('click', (e) => {
        e.preventDefault();
        locked = !locked;
        if (locked) open(); else close();
      });
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) { locked = false; close(); }
      });
      menu.addEventListener('click', (e) => e.stopPropagation());
    }

    // Juegos
    if (['super_master','master'].includes(role)) sidebarNav.appendChild(addLink('Juegos', '/juegos', '🎲'));

    // Rendimiento — todos los roles
    sidebarNav.appendChild(addLink('Rendimiento', '/rendimiento', '📈'));

    // Límites — vista de auditoría de solo lectura, únicamente super_master
    if (role === 'super_master') sidebarNav.appendChild(addLink('Límites', '/limites', '🎯'));

    // Cuadre de caja
    if (['super_master','master','banca','grupo'].includes(role)) sidebarNav.appendChild(addLink('Cuadre de Caja', '/cuadre', '💰'));

    // Reportes dropdown — todos los roles
    const reportes = [
      { label: 'Ventas Totales', href: '/reportes/ventas', icon: '💰' },
      { label: 'Relación Tickets', href: '/reportes/tickets', icon: '🎫' },
      { label: 'Rendimiento Agencias', href: '/reportes/taquillas', icon: '📊' },
      { label: 'Premios Vencidos', href: '/reportes/vencidos', icon: '⏰' },
    ];

    const rDropdown = document.createElement('div');
    rDropdown.className = 'sidebar-dropdown';
    rDropdown.id = 'reportes-dropdown';

    const rHeader = document.createElement('div');
    rHeader.className = 'dropdown-header';
    rHeader.innerHTML = `<span class="header-left"><span class="sidebar-link-icon">📊</span> Reportes</span><span class="dropdown-arrow">▼</span>`;

    const rMenu = document.createElement('div');
    rMenu.className = 'dropdown-menu';
    rMenu.id = 'reportes-dropdown-menu';

    reportes.forEach(e => rMenu.appendChild(addDropdownItem(e.label, e.href, e.icon, undefined, '')));
    rDropdown.appendChild(rHeader);
    rDropdown.appendChild(rMenu);
    sidebarNav.appendChild(rDropdown);

    // Reportes dropdown hover + click toggle
    (function() {
      let locked = false;
      let isOpen = false;

      function open() { isOpen = true; rDropdown.classList.add('open'); }
      function close() { if (!locked) { isOpen = false; rDropdown.classList.remove('open'); } }

      rDropdown.addEventListener('mouseenter', () => { if (!locked) open(); });
      rDropdown.addEventListener('mouseleave', () => { if (!locked) close(); });
      rHeader.addEventListener('click', (e) => {
        e.preventDefault();
        locked = !locked;
        if (locked) open(); else close();
      });
      document.addEventListener('click', (e) => {
        if (!rDropdown.contains(e.target)) { locked = false; close(); }
      });
      rMenu.addEventListener('click', (e) => e.stopPropagation());

      // Auto-open if current path starts with /reportes
      if (currentPath.startsWith('/reportes')) open();
    })();

    // Tasas
    if (['super_master','master'].includes(role)) sidebarNav.appendChild(addLink('Tasas', '/tasas', '💱'));

    // Usuarios — todos los roles (el backend limita los datos según jerarquía)
    sidebarNav.appendChild(addLink('Usuarios', '/usuarios', '👤'));

    // Logs
    if (['super_master','master'].includes(role)) sidebarNav.appendChild(addLink('Logs', '/logs', '📋'));

    function updateClock() {
      const now = new Date();
      document.getElementById('topbar-clock').textContent = now.toLocaleTimeString('es-VE', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    document.getElementById('logout-btn').addEventListener('click', async () => {
      const ok = await import('../utils/modal.ts').then(m => m.showModal({ message: '¿Cerrar sesión?', type: 'confirm' }));
      if (!ok) return;
      localStorage.removeItem('panel_token');
      localStorage.removeItem('panel_user');
      window.location.href = '/login';
    });
  </script>
</body>
</html>
