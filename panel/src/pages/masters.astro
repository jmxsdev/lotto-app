---
import AdminLayout from '../layouts/AdminLayout.astro';
---
<!--
  Página Masters (super banca): listado de usuarios con rol master, creación
  de nuevos masters y desvinculación de sus bancas. Solo visible para
  super_master (sidebar); el backend acota el listado al alcance jerárquico.
  Las bancas de un master se asignan desde el detalle de la banca (select
  Master en /bancas/detalle); aquí solo se consultan y desvinculan.
-->
<AdminLayout>
  <div class="page">
    <div class="page-header">
      <h2 class="page-title">Masters</h2>
      <button class="btn btn-primary" id="btn-create">+ Nuevo Master</button>
    </div>
    <p class="page-hint">Usuarios con rol Master (super banca). Las bancas se asignan desde el detalle de cada banca.</p>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <div class="modal-overlay" id="modal" style="display:none">
    <div class="modal-card">
      <h3>Nuevo Master</h3>
      <form id="modal-form">
        <div class="field"><label>Nombre</label><input name="name" required /></div>
        <div class="field"><label>Email</label><input name="email" type="email" required /></div>
        <div class="field"><label>Contraseña</label><input name="password" type="password" minlength="8" required /></div>
        <div class="field"><div class="checkbox-group"><label><input type="checkbox" name="active" checked /> Activo</label></div></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="btn-cancel">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
  <style is:global>
    .page { max-width: 1000px; } .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; } .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .page-hint { color: #64748b; font-size: 13px; margin-bottom: 20px; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; } .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; } .btn-secondary { background: #e2e8f0; color: #333; } .btn-secondary:hover { background: #cbd5e1; } .btn-danger { background: #ef4444; color: #fff; } .btn-danger:hover { background: #dc2626; } .btn-success { background: #22c55e; color: #fff; } .btn-success:hover { background: #16a34a; } .btn-sm { padding: 4px 10px; font-size: 12px; }
    .loading { text-align: center; padding: 40px; color: #666; } .table-wrap { background: #fff; border-radius: 10px; overflow-x: auto; box-shadow: 0 1px 4px rgba(0,0,0,0.06); } table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; } td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; } tr:hover td { background: #f8fafc; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; } .badge-active { background: #dcfce7; color: #166534; } .badge-inactive { background: #fef2f2; color: #991b1b; }
    .banca-chip { display: inline-flex; align-items: center; gap: 6px; background: #eef2ff; border-radius: 6px; padding: 2px 8px; margin: 2px 4px 2px 0; font-size: 12px; color: #3730a3; } .banca-chip a { color: #3730a3; text-decoration: none; } .banca-chip a:hover { text-decoration: underline; } .banca-chip button { border: none; background: none; cursor: pointer; color: #ef4444; font-size: 12px; padding: 0; }
    .sin-bancas { color: #94a3b8; font-style: italic; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 9999; } .modal-card { background: #fff; border-radius: 12px; padding: 28px; width: 420px; max-width: 95%; max-height: 85vh; overflow-y: auto; box-shadow: 0 8px 30px rgba(0,0,0,0.2); } .modal-card h3 { margin-bottom: 20px; font-size: 18px; } .field { margin-bottom: 14px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; } .field input { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; } .field input:focus { border-color: #3b82f6; outline: none; } .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; } .actions-cell { display: flex; gap: 4px; }
    .checkbox-group { display: flex; gap: 20px; padding-top: 4px; } .checkbox-group label { display: flex; align-items: center; gap: 6px; font-weight: 400; cursor: pointer; } .checkbox-group input[type="checkbox"] { width: auto; margin: 0; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';

    async function load() {
      try {
        const data = await apiFetch('GET', '/users?role=master&per_page=100');
        const items = Array.isArray(data) ? data : (data?.data || []);
        let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Bancas</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>';
        items.forEach(u => {
          const bancas = (u.bancas || []).map(b =>
            `<span class="banca-chip"><a href="/bancas/detalle?id=${b.id}">🏦 ${b.name}</a><button class="unlink-btn" data-banca="${b.id}" data-master="${u.name}" title="Desvincular banca">✕</button></span>`
          ).join('') || '<span class="sin-bancas">Sin bancas</span>';
          const toggleLabel = u.active ? 'Desactivar' : 'Activar';
          html += `<tr><td><strong>${u.name}</strong></td><td>${u.email}</td><td>${bancas}</td><td><span class="badge ${u.active ? 'badge-active' : 'badge-inactive'}">${u.active ? 'Activo' : 'Inactivo'}</span></td><td class="actions-cell"><button class="btn btn-sm ${u.active ? 'btn-danger' : 'btn-success'} toggle-btn" data-id="${u.id}" data-active="${u.active ? '1' : '0'}">${toggleLabel}</button></td></tr>`;
        });
        html += '</tbody></table></div>';
        document.getElementById('content').innerHTML = html;
      } catch (e) { document.getElementById('content').innerHTML = '<div class="loading">Error: ' + e.message + '</div>'; }
    }

    const f = document.getElementById('modal-form');

    document.getElementById('btn-create').addEventListener('click', () => {
      f.reset();
      f.active.checked = true;
      document.getElementById('modal').style.display = 'flex';
    });
    document.getElementById('btn-cancel').addEventListener('click', () => document.getElementById('modal').style.display = 'none');

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = {
        user_name: f.name.value,
        user_email: f.email.value,
        user_password: f.password.value,
        role: 'master',
        active: f.active.checked,
      };
      try {
        await apiFetch('POST', '/users', body);
        document.getElementById('modal').style.display = 'none';
        await showModal({ message: 'Master creado correctamente.', type: 'success' });
        load();
      } catch (err) { await showModal({ message: err.message, type: 'error' }); }
    });

    document.getElementById('content').addEventListener('click', (e) => {
      const tb = e.target.closest('.toggle-btn');
      const ub = e.target.closest('.unlink-btn');
      if (tb) {
        const id = parseInt(tb.dataset.id);
        const activo = tb.dataset.active === '1';
        showModal({ message: activo ? '¿Desactivar este master? Sus bancas quedarán pausadas según la cadena de activación.' : '¿Activar este master?', type: 'confirm' }).then(ok => {
          if (!ok) return;
          apiFetch('PUT', '/users/' + id, { active: !activo })
            .then(() => load())
            .catch(err => showModal({ message: err.message, type: 'error' }));
        });
      }
      if (ub) {
        const bancaId = parseInt(ub.dataset.banca);
        const masterName = ub.dataset.master;
        showModal({ message: `¿Desvincular esta banca del master ${masterName}? La banca dejará de tener un master asignado.`, type: 'confirm' }).then(ok => {
          if (!ok) return;
          apiFetch('PUT', '/bancas/' + bancaId, { master_id: null })
            .then(() => load())
            .catch(err => showModal({ message: err.message, type: 'error' }));
        });
      }
    });

    load();
  </script>
</AdminLayout>