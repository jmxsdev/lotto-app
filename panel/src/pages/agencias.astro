---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Agencias (Locales)</h2><a class="btn btn-primary" href="/agencias/detalle">+ Nueva</a></div>
    <p class="table-note">ℹ️ Un local (agencia) agrupa las taquillas de un mismo punto de venta. Desactivar un local pausa sus taquillas sin desregistrar dispositivos: al reactivarlo seguirán operando sin re-activación.</p>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <style is:global>
    .page { max-width: 1000px; } .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; } .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; text-decoration: none; display: inline-block; } .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; } .btn-secondary { background: #e2e8f0; color: #333; } .btn-secondary:hover { background: #cbd5e1; }
    .btn-danger { background: #ef4444; color: #fff; } .btn-danger:hover { background: #dc2626; }
    .btn-success { background: #22c55e; color: #fff; } .btn-success:hover { background: #16a34a; }
    .table-note { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; } .btn-sm { padding: 4px 10px; font-size: 12px; }
    .loading { text-align: center; padding: 40px; color: #666; } .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); } table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; } td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; } tr:hover td { background: #f8fafc; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; } .badge-active { background: #dcfce7; color: #166534; } .badge-inactive { background: #fef2f2; color: #991b1b; }
    .actions-cell { display: flex; gap: 4px; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';
    async function load() { try { const data = await apiFetch('GET','/agencias?per_page=100'); const items = Array.isArray(data) ? data : (data?.data || []); let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Código</th><th>Grupo</th><th>Banca</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>'; items.forEach(a => { html += `<tr><td><strong>${a.name}</strong></td><td>${a.code}</td><td>${a.grupo?.name||'-'}</td><td>${a.grupo?.banca?.name||'-'}</td><td><span class="badge ${a.active?'badge-active':'badge-inactive'}">${a.active?'Activo':'Inactivo'}</span></td><td class="actions-cell"><a class="btn btn-sm btn-secondary" href="/agencias/detalle?id=${a.id}">👁️ Ver/Editar</a><button class="btn btn-sm ${a.active?'btn-danger':'btn-success'} toggle-btn" data-id="${a.id}" data-active="${a.active?'1':'0'}" title="${a.active?'Desactivar':'Activar'}">${a.active?'🔴':'🟢'}</button><button class="btn btn-sm btn-danger del-btn" data-id="${a.id}">🗑</button></td></tr>`; }); html += '</tbody></table></div>'; document.getElementById('content').innerHTML = html; } catch(e) { document.getElementById('content').innerHTML = '<div class="loading">Error: '+e.message+'</div>'; } }
    document.getElementById('content').addEventListener('click',(e)=>{const db=e.target.closest('.del-btn');const tb=e.target.closest('.toggle-btn');if(db){const id=parseInt(db.dataset.id);showModal({message:'¿Eliminar este local? Sus taquillas y usuarios quedarán sin local asignado.',type:'confirm'}).then(ok=>{if(!ok)return;apiFetch('DELETE','/agencias/'+id).then(()=>load()).catch(e=>showModal({message:e.message,type:'error'}));});}if(tb){const id=parseInt(tb.dataset.id);const activa=tb.dataset.active==='1';showModal({message:activa?'¿Desactivar local? Sus taquillas quedarán pausadas hasta reactivarlo.':'¿Activar local?',type:'confirm'}).then(ok=>{if(!ok)return;apiFetch('PATCH','/agencias/'+id+'/toggle').then(()=>load()).catch(e=>showModal({message:e.message,type:'error'}));});}});
    load();
  </script>
</AdminLayout>