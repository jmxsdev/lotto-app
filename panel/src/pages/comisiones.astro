---
import AdminLayout from '../layouts/AdminLayout.astro';
import Icon from '../components/Icon.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Comisiones</h2></div>

    <div class="consulta-card">
      <div class="consulta-header">
        <h3 class="consulta-title">Consultar comisiones</h3>
        <p class="consulta-hint">Muestra cuánto recibiría cada Banca, Grupo y Taquilla con ventas en el rango. Consulta de solo lectura: no genera liquidaciones ni pagos.</p>
      </div>
      <div class="consulta-filas">
        <div class="field">
          <label for="consulta-desde">Desde</label>
          <input type="date" id="consulta-desde" />
        </div>
        <div class="field">
          <label for="consulta-hasta">Hasta</label>
          <input type="date" id="consulta-hasta" />
        </div>
        <div class="field" style="align-self:flex-end">
          <button class="btn btn-primary" id="btn-consultar"><Icon name="search" size={14} /> Consultar</button>
        </div>
        <span id="consulta-estado" class="estado" role="status"></span>
      </div>
    </div>

    <div class="filters">
      <div class="field">
        <label for="filter-nivel">Nivel</label>
        <select id="filter-nivel">
          <option value="">Todos</option>
          <option value="banca">Banca</option>
          <option value="grupo">Grupo</option>
          <option value="taquilla">Taquilla</option>
        </select>
      </div>
      <div class="field search">
        <label for="filter-entity">Entidad</label>
        <input type="text" id="filter-entity" placeholder="Nombre..." />
      </div>
    </div>

    <div id="content"><div class="empty">Selecciona un rango y consulta.</div></div>
  </div>

  <style is:global>
    .page { max-width: 1200px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .filters { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; align-items: flex-end; }
    .field { margin-bottom: 14px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; }
    .field input, .field select { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; min-width: 140px; } .field input:focus, .field select:focus { border-color: #3b82f6; outline: none; }
    .field.search input { min-width: 220px; }
    .table-wrap { background: #fff; border-radius: 10px; overflow: auto; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; white-space: nowrap; } td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; font-size: 13px; white-space: nowrap; } tr:hover td { background: #f8fafc; }
    .number { text-align: right; font-variant-numeric: tabular-nums; }
    .error { color: #ef4444; text-align: center; padding: 20px; }
    .empty { text-align: center; padding: 40px; color: #999; }
    .estado { font-size: 13px; color: #16a34a; }
    .estado.error { color: #dc2626; }
    .consulta-card { margin-bottom: 20px; padding: 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; }
    .consulta-header { margin-bottom: 12px; }
    .consulta-title { font-size: 15px; font-weight: 700; color: #1e293b; margin: 0 0 4px; }
    .consulta-hint { font-size: 12px; color: #64748b; margin: 0; }
    .consulta-filas { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .nivel-banca { background: #ccfbf1; color: #115e59; }
    .nivel-grupo { background: #dbeafe; color: #1e40af; }
    .nivel-taquilla { background: #ede9fe; color: #5b21b6; }
    .pag-wrap { display: flex; gap: 6px; align-items: center; justify-content: center; padding: 10px 0; flex-wrap: wrap; }
    .pag-btn { padding: 5px 10px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 13px; cursor: pointer; }
    .pag-btn:hover:not(:disabled) { background: #f1f5f9; }
    .pag-btn:disabled { opacity: 0.4; cursor: default; }
    .pag-activa { background: #3b82f6; color: #fff; border-color: #3b82f6; }
  </style>

  <script>
    import { apiFetch, getStoredUser } from '../utils/api.ts';

    const user = getStoredUser();
    const rol = user?.role || '';

    // La consulta exige super_master|master (el master queda scoped en el backend).
    const ACCESO = ['super_master', 'master'].includes(rol);

    let filas = []; // filas devueltas por GET /comisiones/consulta
    let meta = null; // { desde, hasta, total } del último request
    let consultado = false;
    let errorMsg = '';
    let pagina = 1;
    const POR_PAGINA = 15;
    const fmt = (v) => Number(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const content = document.getElementById('content');

    if (!ACCESO) {
      content.innerHTML = '<div class="error">Sin acceso a esta sección.</div>';
    } else {
      const hoy = new Date();
      const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
      document.getElementById('consulta-desde').value = fechaLocal(inicioMes);
      document.getElementById('consulta-hasta').value = fechaLocal(hoy);

      document.getElementById('btn-consultar').addEventListener('click', consultar);
      document.getElementById('filter-nivel').addEventListener('change', () => { pagina = 1; render(); });
      document.getElementById('filter-entity').addEventListener('input', () => { pagina = 1; render(); });
    }

    // YYYY-MM-DD en hora local (evita el corrimiento de día de toISOString).
    function fechaLocal(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dia = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${dia}`;
    }

    function primerError(errors) {
      if (!errors || typeof errors !== 'object') return '';
      const primero = Object.values(errors)[0];
      if (Array.isArray(primero)) return primero[0] || '';
      return typeof primero === 'string' ? primero : '';
    }

    async function consultar() {
      const desde = document.getElementById('consulta-desde').value;
      const hasta = document.getElementById('consulta-hasta').value;
      const estado = document.getElementById('consulta-estado');

      if (!desde || !hasta) {
        estado.textContent = 'Selecciona un rango de fechas.';
        estado.className = 'estado error';
        return;
      }
      if (hasta < desde) {
        estado.textContent = 'La fecha "hasta" debe ser posterior o igual a "desde".';
        estado.className = 'estado error';
        return;
      }

      const btn = document.getElementById('btn-consultar');
      btn.disabled = true;
      estado.textContent = 'Consultando...';
      estado.className = 'estado';

      try {
        const res = await apiFetch(
          'GET',
          `/comisiones/consulta?desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}`
        );
        filas = Array.isArray(res?.data) ? res.data : [];
        meta = res?.meta || null;
        errorMsg = '';
        consultado = true;
        pagina = 1;
        estado.textContent = meta
          ? `Rango aplicado: ${meta.desde} a ${meta.hasta} — ${meta.total} ${meta.total === 1 ? 'entidad' : 'entidades'}.`
          : `${filas.length} ${filas.length === 1 ? 'entidad' : 'entidades'}.`;
        estado.className = 'estado';
        render();
      } catch (e) {
        filas = [];
        meta = null;
        consultado = true;
        pagina = 1;

        if (e.status === 422) {
          const detalle = primerError(e.errors);
          errorMsg = 'No se pudo consultar el rango.' + (detalle ? ` ${detalle}` : '');
        } else if (e.status === 403) {
          errorMsg = 'Sin permiso para consultar comisiones.';
        } else {
          errorMsg = 'Error: ' + (e.message || 'No se pudo consultar.');
        }

        estado.textContent = errorMsg;
        estado.className = 'estado error';
        render();
      } finally {
        btn.disabled = false;
      }
    }

    function filtros() {
      return {
        nivel: document.getElementById('filter-nivel').value,
        q: document.getElementById('filter-entity').value.trim().toLowerCase(),
      };
    }

    function aplicarFiltros(f) {
      return filas.filter((r) => {
        if (f.nivel && r.nivel !== f.nivel) return false;
        if (f.q && !String(r.entidad || '').toLowerCase().includes(f.q)) return false;
        return true;
      });
    }

    function render() {
      if (!consultado) {
        content.innerHTML = '<div class="empty">Selecciona un rango y consulta.</div>';
        return;
      }
      if (errorMsg) {
        content.innerHTML = `<div class="error">${esc(errorMsg)}</div>`;
        return;
      }

      const visiblesFilas = aplicarFiltros(filtros());
      const totalPaginas = Math.max(1, Math.ceil(visiblesFilas.length / POR_PAGINA));
      if (pagina > totalPaginas) pagina = totalPaginas;
      const inicio = (pagina - 1) * POR_PAGINA;
      const visibles = visiblesFilas.slice(inicio, inicio + POR_PAGINA);

      if (visiblesFilas.length === 0) {
        content.innerHTML = filas.length === 0
          ? '<div class="empty">Sin comisiones para el rango.</div>'
          : '<div class="empty">Sin comisiones para los filtros seleccionados.</div>';
        return;
      }

      let html = '<div class="table-wrap"><table><thead><tr>' +
        '<th>Nivel</th><th>Entidad</th><th class="number">Monto (Bs.)</th>' +
        '</tr></thead><tbody>';

      visibles.forEach((r) => {
        const nivel = r.nivel || '';
        const etiqueta = nivel === 'banca' ? 'Banca' : nivel === 'grupo' ? 'Grupo' : nivel === 'taquilla' ? 'Taquilla' : (nivel || '-');
        const claseNivel = nivel === 'banca' ? 'nivel-banca' : nivel === 'grupo' ? 'nivel-grupo' : 'nivel-taquilla';
        html += `<tr>
          <td><span class="badge ${claseNivel}">${esc(etiqueta)}</span></td>
          <td><strong>${esc(r.entidad || '-')}</strong></td>
          <td class="number">${fmt(r.monto_comision)}</td>
        </tr>`;
      });

      html += '</tbody></table></div>';

      if (totalPaginas > 1) {
        html += '<div class="pag-wrap">';
        html += `<button class="pag-btn" data-page="${pagina - 1}" ${pagina === 1 ? 'disabled' : ''}>‹ Anterior</button>`;
        for (let p = 1; p <= totalPaginas; p++) {
          if (totalPaginas > 10 && p !== 1 && p !== totalPaginas && Math.abs(p - pagina) > 2) {
            if (p === 2 || p === totalPaginas - 1) html += '<span style="color:#94a3b8">…</span>';
            continue;
          }
          html += `<button class="pag-btn ${p === pagina ? 'pag-activa' : ''}" data-page="${p}">${p}</button>`;
        }
        html += `<button class="pag-btn" data-page="${pagina + 1}" ${pagina === totalPaginas ? 'disabled' : ''}>Siguiente ›</button>`;
        html += '</div>';
      }

      content.innerHTML = html;
      content.querySelectorAll('.pag-btn[data-page]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = Number(btn.dataset.page);
          if (p >= 1 && p <= totalPaginas) { pagina = p; render(); }
        });
      });
    }
  </script>
</AdminLayout>
