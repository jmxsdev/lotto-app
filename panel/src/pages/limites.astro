---
import AdminLayout from '../layouts/AdminLayout.astro';
import Icon from '../components/Icon.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header">
      <h2 class="page-title">Límites — Configuración General</h2>
    </div>

    <div class="filters">
      <div class="field">
        <label>Aplicar a</label>
        <select id="filtro-alcance">
          <option value="bancas">Todas las bancas</option>
          <option value="grupos">Todos los grupos</option>
          <option value="taquillas">Todas las taquillas</option>
        </select>
      </div>
      <div class="field search">
        <label>Buscar juego</label>
        <input type="text" id="filtro-busqueda" placeholder="Nombre del juego..." />
      </div>
      <div id="impacto" class="impacto"></div>
    </div>

    <div id="tabla-container"><div class="loading">Cargando límites...</div></div>

    <div class="acciones">
      <button class="btn btn-primary" id="btn-guardar"><Icon name="save" size={14} /> Guardar cambios</button>
      <span id="estado-guardado" class="estado"></span>
    </div>

    <div id="comision-global" class="comision-global">
      <div class="comision-global-header">
        <h3 class="comision-global-title">Comisión global por moneda</h3>
        <p class="comision-global-hint">Se aplica a todos los juegos cuando ningún nivel define porcentaje de pago. Máx. 16% global; animalitos 16%, tripletas 25%.</p>
      </div>
      <div class="comision-global-filas">
        <div class="field">
          <label>BS (%)</label>
          <input type="number" id="comision-bs" min="0" max="16" step="0.01" placeholder="0.00" />
        </div>
        <div class="field">
          <label>USD (%)</label>
          <input type="number" id="comision-usd" min="0" max="16" step="0.01" placeholder="0.00" />
        </div>
      </div>
      <div class="acciones">
        <button class="btn btn-primary" id="btn-guardar-comision"><Icon name="save" size={14} /> Guardar comisión global</button>
        <span id="estado-comision" class="estado"></span>
      </div>
    </div>
  </div>

  <style is:global>
    .page { max-width: 1200px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .filters { display: flex; gap: 16px; margin-bottom: 16px; align-items: flex-end; flex-wrap: wrap; }
    .field { margin-bottom: 0; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; }
    .field select, .field input { padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; }
    .field select:focus, .field input:focus { border-color: #3b82f6; outline: none; }
    .field.search input { width: 240px; }
    .impacto { font-size: 13px; color: #64748b; padding-bottom: 10px; }
    .acciones { display: flex; gap: 12px; align-items: center; margin-top: 16px; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .estado { font-size: 13px; color: #16a34a; }
    .comision-global { margin-top: 24px; padding: 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; }
    .comision-global-header { margin-bottom: 12px; }
    .comision-global-title { font-size: 15px; font-weight: 700; color: #1e293b; margin: 0 0 4px; }
    .comision-global-hint { font-size: 12px; color: #64748b; margin: 0; }
    .comision-global-filas { display: flex; gap: 16px; flex-wrap: wrap; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    table { width: 100%; border-collapse: collapse; }
    th { background: #f1f5f9; padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; }
    td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; font-size: 13px; }
    tr:hover td { background: #f8fafc; }
    td input[type="number"] { width: 90px; padding: 6px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 13px; }
    td input[type="number"]:focus { border-color: #3b82f6; outline: none; }
    .moneda-badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .moneda-bs { background: #dbeafe; color: #1e40af; } .moneda-usd { background: #dcfce7; color: #166534; }
    .pag-wrap { display: flex; gap: 6px; align-items: center; justify-content: center; padding: 10px 0; flex-wrap: wrap; }
    .pag-btn { padding: 5px 10px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 13px; cursor: pointer; }
    .pag-btn:hover:not(:disabled) { background: #f1f5f9; }
    .pag-btn:disabled { opacity: 0.4; cursor: default; }
    .pag-activa { background: #3b82f6; color: #fff; border-color: #3b82f6; }
  </style>

  <script>
    import { apiFetch, getStoredUser } from '../utils/api.ts';
    import { crearTablaLimites } from '../utils/limites.ts';
    import { icono } from '../utils/iconos.ts';

    const user = getStoredUser();
    const rol = user?.role;
    const alcanceSelect = document.getElementById('filtro-alcance');
    const busquedaInput = document.getElementById('filtro-busqueda');
    const impacto = document.getElementById('impacto');
    const btnGuardar = document.getElementById('btn-guardar');
    const estado = document.getElementById('estado-guardado');
    const contenedor = document.getElementById('tabla-container');

    let alcanceActual = 'bancas';
    let tabla = null;

    // Filtrado por rol: super_master/master ven las 3 opciones; banca sus grupos/taquillas; grupo solo taquillas
    if (rol === 'banca') {
      alcanceSelect.innerHTML = '<option value="grupos">Todos mis grupos</option><option value="taquillas">Todas mis taquillas</option>';
      alcanceActual = 'grupos';
    } else if (rol === 'grupo') {
      alcanceSelect.innerHTML = '<option value="taquillas">Todas mis taquillas</option>';
      alcanceActual = 'taquillas';
    }

    // Enmienda 2026-10-01: grupo escribe la matriz de SUS taquillas
    // (comisión + mín/máx); agencia audita en solo lectura.
    // Taquilla (GET 403 en la API) y otros roles: sin acceso.
    const puedeVer = ['super_master', 'master', 'banca', 'grupo', 'agencia'].includes(rol);
    const puedeConfigurar = ['super_master', 'master', 'banca', 'grupo'].includes(rol);

    if (!puedeVer) {
      contenedor.innerHTML = '<div class="loading">Sin acceso a la configuración de límites.</div>';
      btnGuardar.disabled = true;
      const acciones = document.querySelector<HTMLElement>('.acciones');
      if (acciones) acciones.style.display = 'none';
    } else {
      // Solo lectura: sin botón Guardar
      if (!puedeConfigurar) {
        btnGuardar.disabled = true;
        const acciones = document.querySelector<HTMLElement>('.acciones');
        if (acciones) acciones.style.display = 'none';
      }
      // Leer alcance inicial de la URL (?scope=)
      const params = new URLSearchParams(window.location.search);
      const scopeInicial = params.get('scope');
      if (scopeInicial && ['bancas', 'grupos', 'taquillas'].includes(scopeInicial)) {
        const opciones = Array.from(alcanceSelect.options).map(o => o.value);
        if (opciones.includes(scopeInicial)) {
          alcanceSelect.value = scopeInicial;
          alcanceActual = scopeInicial;
        }
      }
      montarTabla();
    }

    // Bloque aditivo de comisión global (solo super_master). No toca la matriz.
    const comisionGlobal = document.getElementById('comision-global');
    const inputBs = document.getElementById('comision-bs');
    const inputUsd = document.getElementById('comision-usd');
    const btnGuardarComision = document.getElementById('btn-guardar-comision');
    const estadoComision = document.getElementById('estado-comision');

    if (rol !== 'super_master') {
      comisionGlobal.remove();
    } else {
      cargarComisionGlobal();
    }

    async function cargarComisionGlobal() {
      try {
        const data = await apiFetch('GET', '/comisiones/defaults');
        const filas = Array.isArray(data) ? data : [];
        const bs = filas.find(f => f.moneda === 'bs');
        const usd = filas.find(f => f.moneda === 'usd');
        inputBs.value = bs?.porcentaje_pago ?? '';
        inputUsd.value = usd?.porcentaje_pago ?? '';
      } catch (e) {
        estadoComision.textContent = 'No se pudo cargar la comisión global: ' + e.message;
      }
    }

    btnGuardarComision.addEventListener('click', async () => {
      btnGuardarComision.disabled = true;
      estadoComision.textContent = 'Guardando...';
      try {
        await apiFetch('PUT', '/comisiones/defaults', {
          defaults: [
            { moneda: 'bs', porcentaje_pago: inputBs.value === '' ? null : Number(inputBs.value) },
            { moneda: 'usd', porcentaje_pago: inputUsd.value === '' ? null : Number(inputUsd.value) },
          ],
        });
        estadoComision.innerHTML = '<span aria-hidden="true">' + icono('circle-check') + '</span> Comisión global guardada.';
      } catch (e) {
        estadoComision.textContent = '';
        alert('Error: ' + e.message);
      } finally {
        btnGuardarComision.disabled = false;
      }
    });

    function montarTabla() {
      contenedor.innerHTML = '<div class="loading">Cargando límites...</div>';
      impacto.textContent = '';
      estado.textContent = '';
      btnGuardar.disabled = !puedeConfigurar;

      tabla = crearTablaLimites({
        modo: 'scope',
        alcance: null, // el alcance por tipo se maneja en cargarDatos/guardar
        filasPorPagina: 15,
        puedeEditar: puedeConfigurar,
        cargarDatos: async () => {
          const data = await apiFetch('GET', '/limites?scope=' + alcanceActual);
          const resultado = data?.data || { juegos: [], limites: {} };
          // Indicador de impacto: cuántas entidades del tipo se afectarán
          const n = (resultado.entidades || []).length;
          const etiqueta = alcanceActual === 'bancas' ? 'bancas' : alcanceActual === 'grupos' ? 'grupos' : 'taquillas';
          impacto.textContent = n > 0 ? `Se aplicará a ${n} ${etiqueta}.` : 'No hay entidades en este alcance.';
          return resultado;
        },
        guardar: async (payload) => {
          const body = {
            scope: { tipo: alcanceActual },
            limites: payload.limites,
          };
          return apiFetch('POST', '/limites/batch', body);
        },
      });

      tabla.montar(contenedor);
    }

    alcanceSelect.addEventListener('change', () => {
      alcanceActual = alcanceSelect.value;
      // Actualizar URL sin recargar
      const params = new URLSearchParams(window.location.search);
      params.set('scope', alcanceActual);
      history.replaceState(null, '', '?' + params.toString());
      montarTabla();
    });

    busquedaInput.addEventListener('input', () => {
      if (tabla) tabla.buscar(busquedaInput.value);
    });

    btnGuardar.addEventListener('click', async () => {
      if (!tabla || !tabla.hayCambios()) {
        estado.textContent = 'No hay cambios para guardar.';
        return;
      }
      btnGuardar.disabled = true;
      estado.textContent = 'Guardando...';
      try {
        await tabla.guardar();
        estado.innerHTML = '<span aria-hidden="true">' + icono('circle-check') + '</span> Límites guardados.';
        montarTabla(); // recargar para reflejar valores actuales
      } catch (e) {
        estado.textContent = '';
        alert('Error: ' + e.message);
      } finally {
        btnGuardar.disabled = false;
      }
    });
  </script>
</AdminLayout>
