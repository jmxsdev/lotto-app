---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header">
      <h2 class="page-title">Usuarios</h2>
      <button class="btn btn-primary" id="btn-create">+ Nuevo</button>
    </div>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>

  <div class="modal-overlay" id="modal" style="display:none">
    <div class="modal-card">
      <h3 id="modal-title">Nuevo Usuario</h3>
      <form id="modal-form">
        <div class="field"><label>Nombre</label><input name="name" required /></div>
        <div class="field"><label>Email</label><input name="email" type="email" required /></div>
        <div class="field"><label>Contraseña</label><input name="password" type="password" minlength="6" /></div>
        <div class="field"><label>Rol</label><select name="role" required>
          <option value="">Seleccione...</option>
          <option value="super_master">Super Master</option>
          <option value="master">Master</option>
          <option value="banca">Banca</option>
          <option value="grupo">Grupo</option>
          <option value="taquilla">Taquilla</option>
        </select></div>
        <div class="field"><label>Banca</label><select name="banca_id"><option value="">Ninguna</option></select></div>
        <div class="field"><label>Grupo</label><select name="grupo_id"><option value="">Ninguno</option></select></div>
        <div class="field"><label>Taquilla</label><select name="taquilla_id"><option value="">Ninguna</option></select></div>
        <div class="field"><label><input type="checkbox" name="active" checked /> Activo</label></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="btn-cancel">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .page { max-width: 1100px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-primary { background: #3b82f6; color: #fff; }
    .btn-primary:hover { background: #2563eb; }
    .btn-secondary { background: #e2e8f0; color: #333; }
    .btn-secondary:hover { background: #cbd5e1; }
    .btn-danger { background: #ef4444; color: #fff; }
    .btn-danger:hover { background: #dc2626; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    table { width: 100%; border-collapse: collapse; }
    th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; }
    td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
    tr:hover td { background: #f8fafc; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .badge-active { background: #dcfce7; color: #166534; }
    .badge-inactive { background: #fef2f2; color: #991b1b; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 9999; }
    .modal-card { background: #fff; border-radius: 12px; padding: 28px; width: 480px; max-width: 95%; max-height: 90vh; overflow-y: auto; box-shadow: 0 8px 30px rgba(0,0,0,0.2); }
    .modal-card h3 { margin-bottom: 20px; font-size: 18px; }
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; }
    .field input, .field select { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; }
    .field input:focus, .field select:focus { border-color: #3b82f6; outline: none; }
    .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; }
    .actions-cell { display: flex; gap: 4px; }
  </style>

  <script>
    import { apiFetch, getStoredUser, ROLES } from '../utils/api.ts';
    import { showModal } from '../utils/modal.ts';

    let editId = null;
    const user = getStoredUser();

    async function load() {
      try {
        const data = await apiFetch('GET', '/users?per_page=100');
        const users = data.data || [];
        let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>';
        users.forEach(u => {
          html += `<tr>
            <td><strong>${u.name}</strong></td><td>${u.email}</td>
            <td>${(u.role||'').toUpperCase()}</td>
            <td><span class="badge ${u.active ? 'badge-active' : 'badge-inactive'}">${u.active ? 'Activo' : 'Inactivo'}</span></td>
            <td class="actions-cell">
              <button class="btn btn-sm btn-secondary edit-btn" data-id="${u.id}">✏️</button>
              <button class="btn btn-sm btn-danger del-btn" data-id="${u.id}">🗑</button>
            </td></tr>`;
        });
        html += '</tbody></table></div>';
        document.getElementById('content').innerHTML = html;
      } catch (e) {
        document.getElementById('content').innerHTML = '<div class="loading">Error: ' + e.message + '</div>';
      }
    }

    async function openModal(u = null) {
      editId = u?.id || null;
      document.getElementById('modal-title').textContent = u ? 'Editar Usuario' : 'Nuevo Usuario';
      const form = document.getElementById('modal-form');
      form.name.value = u?.name || '';
      form.email.value = u?.email || '';
      form.password.value = '';
      form.role.value = u?.role || '';
      form.active.checked = u ? u.active : true;
      form.banca_id.value = u?.banca_id || '';
      form.grupo_id.value = u?.grupo_id || '';
      form.taquilla_id.value = u?.taquilla_id || '';
      document.getElementById('modal').style.display = 'flex';
    }

    document.getElementById('btn-create').addEventListener('click', () => openModal());
    document.getElementById('btn-cancel').addEventListener('click', () => {
      document.getElementById('modal').style.display = 'none';
    });

    document.getElementById('modal-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target;
      const body = {
        name: f.name.value, email: f.email.value, role: f.role.value,
        active: f.active.checked, banca_id: f.banca_id.value || null,
        grupo_id: f.grupo_id.value || null, taquilla_id: f.taquilla_id.value || null,
      };
      if (f.password.value) body.password = f.password.value;
      try {
        if (editId) {
          await apiFetch('PUT', '/users/' + editId, body);
        } else {
          await apiFetch('POST', '/users', body);
        }
        document.getElementById('modal').style.display = 'none';
        load();
      } catch (err) {
        await showModal({ message: err.message, type: 'error' });
      }
    });

    document.getElementById('content').addEventListener('click', (e) => {
      const editBtn = e.target.closest('.edit-btn');
      const delBtn = e.target.closest('.del-btn');
      if (editBtn) {
        const id = parseInt(editBtn.dataset.id);
        apiFetch('GET', '/users/' + id).then(d => openModal(d.data)).catch(e => showModal({ message: e.message, type: 'error' }));
      }
      if (delBtn) {
        const id = parseInt(delBtn.dataset.id);
        showModal({ message: '¿Eliminar usuario?', type: 'confirm' }).then(ok => {
          if (!ok) return;
          apiFetch('DELETE', '/users/' + id).then(() => load()).catch(e => showModal({ message: e.message, type: 'error' }));
        });
      }
    });

    load();
  </script>
</AdminLayout>
