---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <h2 class="page-title">Dashboard</h2>
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card"><div class="stat-icon">🏦</div><div class="stat-value" id="stat-bancas">-</div><div class="stat-label">Bancas</div></div>
      <div class="stat-card"><div class="stat-icon">📂</div><div class="stat-value" id="stat-grupos">-</div><div class="stat-label">Grupos</div></div>
      <div class="stat-card"><div class="stat-icon">🏪</div><div class="stat-value" id="stat-agencias">-</div><div class="stat-label">Agencias (Locales)</div></div>
      <div class="stat-card"><div class="stat-icon">🖥️</div><div class="stat-value" id="stat-taquillas">-</div><div class="stat-label">Taquillas</div></div>
      <div class="stat-card"><div class="stat-icon">🎲</div><div class="stat-value" id="stat-apuestas">-</div><div class="stat-label">Apuestas Hoy</div></div>
      <div class="stat-card"><div class="stat-icon">💎</div><div class="stat-value" id="stat-ganadores">-</div><div class="stat-label">Ganadores Hoy</div></div>
    </div>
  </div>

  <style is:global>
    .page { max-width: 1200px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; margin-bottom: 24px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; }
    .stat-card { background: #fff; border-radius: 12px; padding: 24px; text-align: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .stat-icon { font-size: 28px; margin-bottom: 8px; }
    .stat-value { font-size: 28px; font-weight: 700; color: #1e293b; }
    .stat-label { font-size: 13px; color: #666; margin-top: 4px; }
  </style>

  <script>
    import { apiFetch } from '../utils/api.ts';

    // Cada stat es tolerante a 403/errores: los roles inferiores no tienen
    // acceso a todas las entidades (banca/grupo/agencia no ven bancas, etc.)
    const contar = (data) => Array.isArray(data) ? data.length : (data?.data?.length || data?.meta?.total || '-');
    const seguro = (p) => p.then(contar).catch(() => '-');

    async function loadStats() {
      try {
        const [bancas, grupos, agencias, taquillas, resumen] = await Promise.all([
          seguro(apiFetch('GET', '/bancas?per_page=1')),
          seguro(apiFetch('GET', '/grupos?per_page=1')),
          seguro(apiFetch('GET', '/agencias?per_page=1')),
          seguro(apiFetch('GET', '/taquillas?per_page=1')),
          apiFetch('GET', '/apuestas/resumen').catch(() => null),
        ]);

        document.getElementById('stat-bancas').textContent = bancas;
        document.getElementById('stat-grupos').textContent = grupos;
        document.getElementById('stat-agencias').textContent = agencias;
        document.getElementById('stat-taquillas').textContent = taquillas;

        const r = resumen?.data || resumen || {};
        document.getElementById('stat-apuestas').textContent = (r.pending_count || 0) + (r.pagada_count || 0);
        document.getElementById('stat-ganadores').textContent = r.pagada_count || 0;

        window.entityCounts = {
          bancas: bancas !== '-' ? bancas : 0,
          grupos: grupos !== '-' ? grupos : 0,
          taquillas: taquillas !== '-' ? taquillas : 0,
          agencias: agencias !== '-' ? agencias : 0,
        };
      } catch (e) {
        console.warn('Stats error:', e.message);
      }
    }

    loadStats();
  </script>
</AdminLayout>
