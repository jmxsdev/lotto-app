---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Bancas</h2><a class="btn btn-primary" href="/bancas/detalle">+ Nueva</a></div>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <style is:global>
    .page { max-width: 900px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; text-decoration: none; display: inline-block; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
    .btn-secondary { background: #e2e8f0; color: #333; } .btn-secondary:hover { background: #cbd5e1; }
    .btn-danger { background: #ef4444; color: #fff; } .btn-danger:hover { background: #dc2626; }
    .btn-success { background: #22c55e; color: #fff; } .btn-success:hover { background: #16a34a; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; } td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; } tr:hover td { background: #f8fafc; }
    .actions-cell { display: flex; gap: 4px; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';
    async function load() {
      try { const data = await apiFetch('GET','/bancas?per_page=100'); const items = Array.isArray(data) ? data : (data?.data || []);
        let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Código</th><th>Creado</th><th>Acciones</th></tr></thead><tbody>';
        items.forEach(b => { html += `<tr><td><strong>${b.name}</strong></td><td>${b.code}</td><td>${new Date(b.created_at).toLocaleDateString('es-VE')}</td><td class="actions-cell"><a class="btn btn-sm btn-secondary" href="/bancas/detalle?id=${b.id}">👁️ Ver/Editar</a><button class="btn btn-sm ${b.active?'btn-danger':'btn-success'} toggle-btn" data-id="${b.id}" data-active="${b.active?'1':'0'}" title="${b.active?'Desactivar':'Activar'}">${b.active?'🔴':'🟢'}</button><button class="btn btn-sm btn-danger del-btn" data-id="${b.id}">🗑</button></td></tr>`; });
        html += '</tbody></table></div>'; document.getElementById('content').innerHTML = html;
      } catch(e) { document.getElementById('content').innerHTML = '<div class="loading">Error: '+e.message+'</div>'; }
    }
    document.getElementById('content').addEventListener('click',(e)=>{const db=e.target.closest('.del-btn');const tb=e.target.closest('.toggle-btn');if(db){const id=parseInt(db.dataset.id);showModal({message:'¿Eliminar banca?',type:'confirm'}).then(ok=>{if(!ok)return;apiFetch('DELETE','/bancas/'+id).then(()=>load()).catch(e=>showModal({message:e.message,type:'error'}));});}if(tb){const id=parseInt(tb.dataset.id);const activa=tb.dataset.active==='1';showModal({message:activa?'¿Desactivar banca? Sus grupos y agencias quedarán pausados hasta reactivarla.':'¿Activar banca?',type:'confirm'}).then(ok=>{if(!ok)return;apiFetch('PATCH','/bancas/'+id+'/toggle').then(()=>load()).catch(e=>showModal({message:e.message,type:'error'}));});}});
    load();
  </script>
</AdminLayout>
