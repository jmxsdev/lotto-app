---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Tasas de Cambio</h2><button class="btn btn-primary" id="btn-new">+ Nueva</button></div>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <div class="modal-overlay" id="modal" style="display:none">
    <div class="modal-card">
      <h3>Nueva Tasa</h3>
      <form id="modal-form">
        <div class="field"><label>Tasa (Bs por USD)</label><input name="rate" type="number" step="0.0001" required /></div>
        <div class="field"><label>Notas</label><input name="notes" /></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="btn-cancel">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
  <style is:global>
    .page { max-width: 900px; } .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; } .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; } .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; } .btn-secondary { background: #e2e8f0; color: #333; } .btn-sm { padding: 4px 10px; font-size: 12px; } .btn-sm.btn-primary { background: #10b981; }
    .loading { text-align: center; padding: 40px; color: #666; } .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); } table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; } td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; } .badge-active { background: #dcfce7; color: #166534; } .badge-inactive { background: #f8fafc; color: #666; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 9999; } .modal-card { background: #fff; border-radius: 12px; padding: 28px; width: 420px; max-width: 95%; box-shadow: 0 8px 30px rgba(0,0,0,0.2); } .modal-card h3 { margin-bottom: 20px; font-size: 18px; } .field { margin-bottom: 14px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; } .field input { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; } .field input:focus { border-color: #3b82f6; outline: none; } .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';
    async function load() { try { const data = await apiFetch('GET','/exchange-rates?per_page=50'); const rates = Array.isArray(data) ? data : (data?.data || []); let html = '<div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Tasa</th><th>Moneda Base</th><th>Notas</th><th>Activa</th><th>Acción</th></tr></thead><tbody>'; rates.forEach(r => { html += `<tr><td>${new Date(r.created_at).toLocaleString('es-VE')}</td><td><strong>Bs. ${Number(r.rate).toLocaleString('es-VE',{minimumFractionDigits:4})}</strong></td><td>${r.base_currency}</td><td>${r.notes||'-'}</td><td><span class="badge ${r.is_active?'badge-active':'badge-inactive'}">${r.is_active?'Activa':'Inactiva'}</span></td><td>${!r.is_active?`<button class="btn btn-sm btn-primary set-active-btn" data-id="${r.id}">Activar</button>`:''}</td></tr>`; }); html += '</tbody></table></div>'; document.getElementById('content').innerHTML = html; } catch(e) { document.getElementById('content').innerHTML = '<div class="loading">Error: '+e.message+'</div>'; } }
    document.getElementById('btn-new').addEventListener('click',()=>document.getElementById('modal').style.display='flex');
    document.getElementById('btn-cancel').addEventListener('click',()=>document.getElementById('modal').style.display='none');
    document.getElementById('modal-form').addEventListener('submit',async(e)=>{e.preventDefault();const f=e.target;try{await apiFetch('POST','/exchange-rates',{rate:parseFloat(f.rate.value),notes:f.notes.value});document.getElementById('modal').style.display='none';load();}catch(err){await showModal({message:err.message,type:'error'});}});
    document.getElementById('content').addEventListener('click',async(e)=>{const btn=e.target.closest('.set-active-btn');if(btn){const id=parseInt(btn.dataset.id);try{await apiFetch('POST','/exchange-rates/'+id+'/set-active');load();}catch(err){await showModal({message:err.message,type:'error'});}}});
    load();
  </script>
</AdminLayout>
