---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Grupos</h2><button class="btn btn-primary" id="btn-create">+ Nuevo</button></div>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <div class="modal-overlay" id="modal" style="display:none">
    <div class="modal-card">
      <h3 id="modal-title">Nuevo Grupo</h3>
      <form id="modal-form">
        <div class="field"><label>Nombre</label><input name="name" required /></div>
        <div class="field"><label>Código</label><input name="code" required /></div>
        <div class="field"><label>Banca</label><select name="banca_id" required></select></div>
        <div class="field"><label>Monedas Permitidas</label><div class="checkbox-group"><label><input type="checkbox" name="moneda_bs" checked /> BS</label><label><input type="checkbox" name="moneda_usd" checked /> USD</label></div></div>
        <div class="field"><label>Vigencia Premios (días)</label><input name="vigencia_premios" type="number" min="1" /></div>
        <div class="field"><label>Tiempo máximo (min)</label><input name="tiempo_eliminacion" type="number" min="1" max="120" placeholder="Vacío = hereda de la banca" /></div>
        <div class="field"><label>RIF</label><input name="rif" /></div>
        <div class="field"><label>Email</label><input name="email" type="email" /></div>
        <div class="field"><label>Teléfono</label><input name="telefono" /></div>
        <div class="field"><label>Dirección</label><input name="direccion" /></div>
        <div class="field"><label>Estado</label><input name="estado" /></div>
        <div class="field"><label>Municipio</label><input name="municipio" /></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="btn-cancel">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
  <style is:global>
    .page { max-width: 900px; } .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; } .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; } .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; } .btn-secondary { background: #e2e8f0; color: #333; } .btn-secondary:hover { background: #cbd5e1; } .btn-danger { background: #ef4444; color: #fff; } .btn-danger:hover { background: #dc2626; } .btn-sm { padding: 4px 10px; font-size: 12px; }
    .loading { text-align: center; padding: 40px; color: #666; } .table-wrap { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); } table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; } td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 14px; } tr:hover td { background: #f8fafc; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 9999; } .modal-card { background: #fff; border-radius: 12px; padding: 28px; width: 420px; max-width: 95%; max-height: 85vh; overflow-y: auto; box-shadow: 0 8px 30px rgba(0,0,0,0.2); } .modal-card h3 { margin-bottom: 20px; font-size: 18px; } .field { margin-bottom: 14px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; } .field input, .field select { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; } .field input:focus, .field select:focus { border-color: #3b82f6; outline: none; }     .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; } .actions-cell { display: flex; gap: 4px; }
    .checkbox-group { display: flex; gap: 20px; padding-top: 4px; } .checkbox-group label { display: flex; align-items: center; gap: 6px; font-weight: 400; cursor: pointer; } .checkbox-group input[type="checkbox"] { width: auto; margin: 0; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';
    let editId = null;
    async function loadBancas() { try { const d = await apiFetch('GET','/bancas?per_page=100'); const items = Array.isArray(d) ? d : (d?.data || []); const s = document.getElementById('modal-form').banca_id; s.innerHTML = '<option value="">Seleccione...</option>';items.forEach(b => { s.innerHTML += `<option value="${b.id}">${b.name}</option>`; }); } catch(_){} }
    async function load() { try { const data = await apiFetch('GET','/grupos?per_page=100'); const items = Array.isArray(data) ? data : (data?.data || []); let html = '<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Código</th><th>Banca</th><th>Acciones</th></tr></thead><tbody>'; items.forEach(g => { html += `<tr><td><strong>${g.name}</strong></td><td>${g.code}</td><td>${g.banca?.name||'-'}</td><td class="actions-cell"><button class="btn btn-sm btn-secondary edit-btn" data-id="${g.id}">✏️</button><button class="btn btn-sm btn-danger del-btn" data-id="${g.id}">🗑</button></td></tr>`; }); html += '</tbody></table></div>'; document.getElementById('content').innerHTML = html; } catch(e) { document.getElementById('content').innerHTML = '<div class="loading">Error: '+e.message+'</div>'; } }
    async function openModal(g=null) { editId=g?.id||null; document.getElementById('modal-title').textContent=g?'Editar Grupo':'Nuevo Grupo'; const f=document.getElementById('modal-form'); f.name.value=g?.name||''; f.code.value=g?.code||''; f.banca_id.value=g?.banca_id||''; f.vigencia_premios.value=g?.vigencia_premios||''; f.tiempo_eliminacion.value=g?.tiempo_eliminacion??''; f.moneda_bs.checked=(g?.monedas_permitidas?.bs??true); f.moneda_usd.checked=(g?.monedas_permitidas?.usd??true); f.rif.value=g?.rif||''; f.email.value=g?.email||''; f.telefono.value=g?.telefono||''; f.direccion.value=g?.direccion||''; f.estado.value=g?.estado||''; f.municipio.value=g?.municipio||''; document.getElementById('modal').style.display='flex'; }
    document.getElementById('btn-create').addEventListener('click',()=>{loadBancas();openModal();});
    document.getElementById('btn-cancel').addEventListener('click',()=>document.getElementById('modal').style.display='none');
    document.getElementById('modal-form').addEventListener('submit',async(e)=>{e.preventDefault();const f=e.target;const body={name:f.name.value,code:f.code.value,banca_id:f.banca_id.value,monedas_permitidas:{bs:f.moneda_bs.checked,usd:f.moneda_usd.checked},vigencia_premios:f.vigencia_premios.value?parseInt(f.vigencia_premios.value):null,tiempo_eliminacion:f.tiempo_eliminacion.value?parseInt(f.tiempo_eliminacion.value):null,rif:f.rif.value||null,email:f.email.value||null,telefono:f.telefono.value||null,direccion:f.direccion.value||null,estado:f.estado.value||null,municipio:f.municipio.value||null};try{if(editId)await apiFetch('PUT','/grupos/'+editId,body);else await apiFetch('POST','/grupos',body);document.getElementById('modal').style.display='none';load();}catch(err){await showModal({message:err.message,type:'error'});}});
    document.getElementById('content').addEventListener('click',(e)=>{const eb=e.target.closest('.edit-btn');const db=e.target.closest('.del-btn');if(eb){const id=parseInt(eb.dataset.id);loadBancas();apiFetch('GET','/grupos/'+id).then(d=>openModal(d.data||d)).catch(e=>showModal({message:e.message,type:'error'}));}if(db){const id=parseInt(db.dataset.id);showModal({message:'¿Eliminar grupo?',type:'confirm'}).then(ok=>{if(!ok)return;apiFetch('DELETE','/grupos/'+id).then(()=>load()).catch(e=>showModal({message:e.message,type:'error'}));});}});
    load();loadBancas();
  </script>
</AdminLayout>
