---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header">
      <h2 class="page-title">Clave de Cierre</h2>
      <span class="badge" id="status-badge">Cargando...</span>
    </div>
    <div id="content"><div class="loading">Cargando...</div></div>
    <div class="card" id="clave-card" style="display:none">
      <p class="hint">La clave de cierre autoriza el re-cierre del día en las taquillas de tu cadena. Usa un PIN numérico de 4 a 8 dígitos.</p>
      <form id="clave-form">
        <div class="field" id="actual-field" style="display:none">
          <label>Clave actual</label>
          <input name="clave_actual" type="password" inputmode="numeric" minlength="4" maxlength="8" pattern="\d{4,8}" autocomplete="off" />
          <small>Ingresa tu clave actual para poder cambiarla.</small>
        </div>
        <div class="field">
          <label>Clave nueva</label>
          <input name="clave_nueva" type="password" inputmode="numeric" minlength="4" maxlength="8" pattern="\d{4,8}" required autocomplete="off" />
          <small>PIN numérico de 4 a 8 dígitos.</small>
        </div>
        <div class="field">
          <label>Confirmar clave nueva</label>
          <input name="confirmacion" type="password" inputmode="numeric" minlength="4" maxlength="8" pattern="\d{4,8}" required autocomplete="off" />
          <small>Debe coincidir con la clave nueva.</small>
        </div>
        <button type="submit" class="btn btn-primary" id="btn-save">Guardar clave</button>
      </form>
    </div>
  </div>
  <style is:global>
    .page { max-width: 720px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
    .btn-primary:disabled { background: #93c5fd; cursor: not-allowed; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; }
    .badge-active { background: #dcfce7; color: #166534; }
    .badge-inactive { background: #fef2f2; color: #991b1b; }
    .badge-neutral { background: #e2e8f0; color: #475569; }
    .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); padding: 24px; }
    .hint { font-size: 13px; color: #666; margin-bottom: 20px; line-height: 1.5; }
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; }
    .field input { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; }
    .field input:focus { border-color: #3b82f6; outline: none; }
    .field small { display: block; font-size: 12px; color: #94a3b8; margin-top: 4px; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts';

    const f = document.getElementById('clave-form');
    const btnSave = document.getElementById('btn-save');
    const badge = document.getElementById('status-badge');
    const card = document.getElementById('clave-card');
    const content = document.getElementById('content');
    let claveConfigurada = false;

    // Estado (GET): la confirmación es UI-only (decisión 2.1), nunca se envía.
    async function cargarEstado() {
      content.innerHTML = '<div class="loading">Cargando...</div>';
      badge.textContent = 'Cargando...';
      badge.className = 'badge badge-neutral';
      try {
        const d = await apiFetch('GET', '/usuarios/clave-cierre');
        claveConfigurada = !!d.clave_configurada;
        badge.textContent = claveConfigurada ? 'Clave configurada' : 'Sin clave configurada';
        badge.className = 'badge ' + (claveConfigurada ? 'badge-active' : 'badge-inactive');
        document.getElementById('actual-field').style.display = claveConfigurada ? 'block' : 'none';
        f.clave_actual.required = claveConfigurada;
        content.innerHTML = '';
        card.style.display = 'block';
      } catch (e) {
        // 403 por rol inelegible (URL directa) u otro error del API → estado de error
        content.innerHTML = '<div class="loading">Error: ' + e.message + '</div>';
        card.style.display = 'none';
      }
    }

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const claveNueva = f.clave_nueva.value;
      const confirmacion = f.confirmacion.value;
      const claveActual = f.clave_actual.value;

      // Validación client-side (PIN 4–8 dígitos + confirmación UI-only)
      if (!/^\d{4,8}$/.test(claveNueva)) {
        await showModal({ message: 'La clave nueva debe ser un PIN numérico de 4 a 8 dígitos.', type: 'error' });
        return;
      }
      if (claveNueva !== confirmacion) {
        await showModal({ message: 'La confirmación no coincide con la clave nueva.', type: 'error' });
        return;
      }
      if (claveConfigurada && !/^\d{4,8}$/.test(claveActual)) {
        await showModal({ message: 'Ingresa tu clave actual.', type: 'error' });
        return;
      }

      const body = { clave_nueva: claveNueva };
      if (claveConfigurada) body.clave_actual = claveActual;

      btnSave.disabled = true;
      btnSave.textContent = 'Guardando...';
      try {
        await apiFetch('PUT', '/usuarios/clave-cierre', body);
        await showModal({ message: 'Clave de cierre configurada correctamente.', type: 'success' });
        f.reset();
        cargarEstado();
      } catch (err) {
        // 422 de validación (errors) y 422 de negocio (message) llegan como Error(msg);
        // 403 por rol inelegible también. Ambos shapes se muestran en el modal.
        await showModal({ message: err.message, type: 'error' });
      } finally {
        btnSave.disabled = false;
        btnSave.textContent = 'Guardar clave';
      }
    });

    cargarEstado();
  </script>
</AdminLayout>