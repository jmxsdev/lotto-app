---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Cierre de Caja</h2></div>

    <div class="section-card">
      <h3 class="section-title">Ejecutar Cierre</h3>
      <div class="filters">
        <div class="field">
          <label>Agencia</label>
          <select id="cierre-taquilla"><option value="">Cargando agencias...</option></select>
        </div>
        <div class="field" style="align-self:flex-end">
          <button class="btn btn-primary" id="btn-ejecutar">💰 Ejecutar Cierre</button>
        </div>
      </div>
      <div id="ejecutar-msg"></div>
      <div id="resumen"></div>
    </div>

    <div class="section-card">
      <h3 class="section-title">Historial de Cierres</h3>
      <div id="historial"><div class="loading">Cargando...</div></div>
    </div>
  </div>

  <style is:global>
    .page { max-width: 1200px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
    .btn:disabled { opacity: .6; cursor: not-allowed; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .empty { text-align: center; padding: 40px; color: #999; }
    .error { color: #ef4444; padding: 10px 0; font-size: 14px; }
    .ok { color: #16a34a; padding: 10px 0; font-size: 14px; font-weight: 600; }
    .section-card { background: #fff; border-radius: 10px; padding: 20px; margin-bottom: 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .section-title { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 16px; }
    .filters { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 8px; align-items: flex-end; }
    .field { margin-bottom: 14px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px; }
    .field select { width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; min-width: 220px; } .field select:focus { border-color: #3b82f6; outline: none; }
    .summary-card { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 16px; margin-top: 8px; }
    .summary-card h4 { font-size: 14px; font-weight: 700; color: #0c4a6e; margin-bottom: 12px; }
    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
    .summary-item { background: #fff; border-radius: 8px; padding: 10px 12px; }
    .summary-item span { display: block; font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; margin-bottom: 4px; }
    .summary-item strong { font-size: 14px; color: #0f172a; font-variant-numeric: tabular-nums; }
    .table-wrap { background: #fff; border-radius: 10px; overflow: auto; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    table { width: 100%; border-collapse: collapse; } th { background: #f1f5f9; padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; white-space: nowrap; } td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; font-size: 13px; white-space: nowrap; } tr:hover td { background: #f8fafc; }
    .number { text-align: right; font-variant-numeric: tabular-nums; }
  </style>

  <script>
    import { apiFetch } from '../utils/api.ts';

    const fmt = (v) => Number(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtTasa = (v) => Number(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    const fmtFecha = (v) => v ? new Date(v).toLocaleString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';

    async function loadTaquillas() {
      const s = document.getElementById('cierre-taquilla');
      s.innerHTML = '<option value="">Cargando agencias...</option>';
      try {
        const data = await apiFetch('GET', '/taquillas');
        const items = Array.isArray(data) ? data : (data?.data || []);
        s.innerHTML = '<option value="">Seleccione una agencia...</option>';
        items.forEach(t => {
          const label = t.grupo ? `${t.name} — ${t.grupo.name}` : t.name;
          s.innerHTML += `<option value="${t.id}">${label}</option>`;
        });
      } catch (e) {
        s.innerHTML = '<option value="">Error al cargar agencias</option>';
      }
    }

    async function ejecutar() {
      const taquillaId = document.getElementById('cierre-taquilla').value;
      const msg = document.getElementById('ejecutar-msg');
      const resumen = document.getElementById('resumen');
      const btn = document.getElementById('btn-ejecutar');
      msg.innerHTML = '';
      resumen.innerHTML = '';

      if (!taquillaId) {
        msg.innerHTML = '<div class="error">Seleccione una agencia para ejecutar el cierre.</div>';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Ejecutando...';
      try {
        const c = await apiFetch('POST', '/cierre', { taquilla_id: parseInt(taquillaId) });
        msg.innerHTML = '<div class="ok">✅ Cierre ejecutado correctamente.</div>';
        resumen.innerHTML = `
          <div class="summary-card">
            <h4>Resumen del Cierre — ${c.taquilla?.name || 'Agencia #' + c.taquilla_id}</h4>
            <div class="summary-grid">
              <div class="summary-item"><span>Fecha Inicio</span><strong>${fmtFecha(c.fecha_inicio)}</strong></div>
              <div class="summary-item"><span>Fecha Fin</span><strong>${fmtFecha(c.fecha_fin)}</strong></div>
              <div class="summary-item"><span>Ventas BS</span><strong>${fmt(c.total_ventas_bs)}</strong></div>
              <div class="summary-item"><span>Ventas USD</span><strong>${fmt(c.total_ventas_usd)}</strong></div>
              <div class="summary-item"><span>Egresos BS</span><strong>${fmt(c.total_egresos_bs)}</strong></div>
              <div class="summary-item"><span>Egresos USD</span><strong>${fmt(c.total_egresos_usd)}</strong></div>
              <div class="summary-item"><span>Efectivo BS</span><strong>${fmt(c.total_efectivo_bs)}</strong></div>
              <div class="summary-item"><span>Efectivo USD</span><strong>${fmt(c.total_efectivo_usd)}</strong></div>
              <div class="summary-item"><span>Tasa de Cambio</span><strong>${fmtTasa(c.exchange_rate_cierre)}</strong></div>
            </div>
          </div>`;
        loadHistorial();
      } catch (e) {
        msg.innerHTML = '<div class="error">Error: ' + (e.message || 'No se pudo ejecutar el cierre.') + '</div>';
      } finally {
        btn.disabled = false;
        btn.textContent = '💰 Ejecutar Cierre';
      }
    }

    async function loadHistorial() {
      const historial = document.getElementById('historial');
      historial.innerHTML = '<div class="loading">Cargando...</div>';
      try {
        const data = await apiFetch('GET', '/cierre?per_page=100');
        const items = Array.isArray(data) ? data : (data?.data || []);

        if (items.length === 0) {
          historial.innerHTML = '<div class="empty">No hay cierres registrados.</div>';
          return;
        }

        let html = '<div class="table-wrap"><table><thead><tr><th>Agencia</th><th>Fecha Inicio</th><th>Fecha Fin</th><th class="number">Ventas BS</th><th class="number">Ventas USD</th><th class="number">Egresos BS</th><th class="number">Egresos USD</th><th class="number">Efectivo BS</th><th class="number">Efectivo USD</th><th class="number">Tasa</th></tr></thead><tbody>';
        items.forEach(c => {
          html += `<tr>
            <td><strong>${c.taquilla?.name || 'Agencia #' + c.taquilla_id}</strong></td>
            <td>${fmtFecha(c.fecha_inicio)}</td>
            <td>${fmtFecha(c.fecha_fin)}</td>
            <td class="number">${fmt(c.total_ventas_bs)}</td>
            <td class="number">${fmt(c.total_ventas_usd)}</td>
            <td class="number">${fmt(c.total_egresos_bs)}</td>
            <td class="number">${fmt(c.total_egresos_usd)}</td>
            <td class="number">${fmt(c.total_efectivo_bs)}</td>
            <td class="number">${fmt(c.total_efectivo_usd)}</td>
            <td class="number">${fmtTasa(c.exchange_rate_cierre)}</td>
          </tr>`;
        });
        html += '</tbody></table></div>';
        historial.innerHTML = html;
      } catch (e) {
        historial.innerHTML = '<div class="error">Error: ' + (e.message || 'No se pudo cargar el historial.') + '</div>';
      }
    }

    document.getElementById('btn-ejecutar').addEventListener('click', ejecutar);
    loadTaquillas();
    loadHistorial();
  </script>
</AdminLayout>
