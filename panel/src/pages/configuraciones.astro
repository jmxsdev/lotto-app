---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="page">
    <div class="page-header"><h2 class="page-title">Configuraciones</h2></div>
    <div id="content"><div class="loading">Cargando...</div></div>
  </div>
  <style is:global>
    .page { max-width: 720px; } .page-header { margin-bottom: 20px; } .page-title { font-size: 24px; font-weight: 700; color: #1e293b; }
    .loading { text-align: center; padding: 40px; color: #666; }
    .sin-acceso { text-align: center; padding: 40px; color: #991b1b; font-weight: 600; }
    .card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .card h3 { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
    .card .desc { font-size: 13px; color: #666; margin-bottom: 18px; }
    .field { margin-bottom: 16px; } .field label { display: block; font-size: 13px; font-weight: 600; color: #333; margin-bottom: 6px; }
    .field input { width: 140px; padding: 10px; border: 2px solid #e2e8f0; border-radius: 6px; font-size: 14px; }
    .field input:focus { border-color: #3b82f6; outline: none; }
    .btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .btn svg { width: 14px; height: 14px; }
    .btn-primary { background: #3b82f6; color: #fff; } .btn-primary:hover { background: #2563eb; }
  </style>
  <script>
    import { apiFetch } from '../utils/api.ts'; import { showModal } from '../utils/modal.ts'; import { icono } from '../utils/iconos.ts';
    const content = document.getElementById('content');

    async function init() {
      try {
        const data = await apiFetch('GET', '/configuraciones/apuestas-vencimiento');
        renderForm(Number(data?.horas) || 24);
      } catch (err) {
        if (err.status === 403) {
          content.innerHTML = '<div class="sin-acceso">No autorizado. Solo los roles super_master y master pueden configurar el vencimiento.</div>';
          return;
        }
        content.innerHTML = '<div class="loading">Error: ' + err.message + '</div>';
      }
    }

    function renderForm(horas) {
      content.innerHTML = `
        <div class="card">
          <h3>Vencimiento de apuestas</h3>
          <p class="desc">Las apuestas sin resultado se marcan como vencidas cuando superan esta ventana.</p>
          <div class="field">
            <label for="horas-input">Horas (1–8760)</label>
            <input type="number" id="horas-input" min="1" max="8760" step="1" value="${horas}" />
          </div>
          <button class="btn btn-primary" id="btn-guardar">${icono('save')} Guardar</button>
        </div>`;
      document.getElementById('btn-guardar').addEventListener('click', guardar);
    }

    async function guardar() {
      const input = document.getElementById('horas-input');
      const horas = parseInt(input.value, 10);
      if (!Number.isInteger(horas) || horas < 1 || horas > 8760) {
        await showModal({ message: 'Las horas deben ser un número entero entre 1 y 8760.', type: 'error' });
        return;
      }
      try {
        await apiFetch('PUT', '/configuraciones/apuestas-vencimiento', { horas });
        await showModal({ message: 'Configuración guardada correctamente.', type: 'success' });
        init();
      } catch (err) {
        if (err.status === 403) {
          content.innerHTML = '<div class="sin-acceso">No autorizado. Solo los roles super_master y master pueden configurar el vencimiento.</div>';
          return;
        }
        await showModal({ message: err.message, type: 'error' });
      }
    }

    init();
  </script>
</AdminLayout>