APP_NAME=lotto-app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password de los usuarios creados por DatabaseSeeder (dev: 'password'; prod: generar fuerte)
SEEDER_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lotto_db
DB_USERNAME=lotto_user
DB_PASSWORD=

# ------------------------------------------------------------------
# Auditoría (#89) — defaults de config/audit.php
# ------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED=true
AUDIT_FAIL_CLOSED_DOMAINS=*
AUDIT_HASH_CHAIN=false
AUDIT_HOT_MONTHS=12
AUDIT_ARCHIVE_YEARS=5
AUDIT_ARCHIVE_PATH=audit/archive
AUDIT_ARCHIVE_DISK=local
# Vacío = usa DB_CONNECTION; en producción: audit_retention
# AUDIT_RETENTION_CONNECTION=audit_retention
# Conexión dedicada de retención (usuario con DELETE; solo audit:archive):
# DB_RETENTION_HOST=
# DB_RETENTION_PORT=
# DB_RETENTION_DATABASE=
# DB_RETENTION_USERNAME=
# DB_RETENTION_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

#REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# CORS y Sanctum
# ------------------------------------------------------------------
# Desarrollo local (Astro dev servers y Electron)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Producción (VPS — descomentar y reemplazar los valores de desarrollo):
# CORS_ALLOWED_ORIGINS=https://panel.gzuz.dev
# SANCTUM_STATEFUL_DOMAINS=panel.gzuz.dev
# LOG_LEVEL=warning
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
