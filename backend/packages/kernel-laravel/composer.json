{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lotto/kernel-laravel",
    "description": "Laravel adapters for lotto/kernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lotto/kernel": "@dev",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Lotto\\KernelLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lotto\\KernelLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lotto\\KernelLaravel\\Providers\\KernelLaravelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
