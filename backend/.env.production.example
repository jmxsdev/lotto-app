# ──────────────────────────────────────────────────────────────────
# Plantilla para backend/.env.production en el VPS (slice 2).
# IMPORTANTE:
#   - NO versionar el archivo real: .gitignore cubre `.env.*` (excepto
#     las plantillas .example).
#   - En el VPS: chmod 600 backend/.env.production y propietario `deploy`.
#   - Generar APP_KEY con: php artisan key:generate
#   - Reemplazar TODOS los placeholders antes del despliegue.
# ──────────────────────────────────────────────────────────────────

APP_NAME=lotto-app
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lotto.gzuz.dev

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

# Credenciales usadas por docker-compose.prod.yml (interpolación + env del servicio mysql)
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_SECRETO_FUERTE
MYSQL_DATABASE=lotto_db
MYSQL_USER=lotto_user

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lotto_db
DB_USERNAME=lotto_user
DB_PASSWORD=REEMPLAZAR_CON_SECRETO_FUERTE

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lotto.gzuz.dev"
MAIL_FROM_NAME="${APP_NAME}"

# CORS / Sanctum — producción
CORS_ALLOWED_ORIGINS=https://panel.gzuz.dev
SANCTUM_STATEFUL_DOMAINS=panel.gzuz.dev
